{
  "description": "Authentik SSO identity provider for TAPPaaS",
  "displayName": "Identity",
  "kind": "vm",
  "version": "0.5.2",
  "stack": "foundation",
  "releaseDate": "2026-10-23",
  "maintainer": "@larsrossen",
  "status": "Development",
  "vmname": "identity",
  "vmid": 140,
  "vmtag": "TAPPaaS,Foundation",
  "dependsOn": [
    "cluster:vm",
    "cluster:ha",
    "templates:nixos",
    "backup:vm",
    "network:proxy"
  ],
  "integratesWith": [
    "logging:logs"
  ],
  "provides": [
    "accessControl",
    "identity"
  ],
  "config": {
    "cluster:vm": {
      "cores": 2,
      "memory": 4096,
      "diskSize": "32G",
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "bridge0": "lan"
    },
    "network:proxy": {
      "proxyPort": 9000,
      "proxyAllowedZones": [
        "internet"
      ]
    },
    "logging:logs": {
      "dropUnits": [
        "generate-authentik-secrets.*",
        "authentik-env-secrets-only.*"
      ]
    }
  }
}
