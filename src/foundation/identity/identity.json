{
  "description": "Authentik SSO identity provider for TAPPaaS",
  "displayName": "Identity",
  "kind": "vm",
  "version": "0.5.2",
  "stack": "foundation",
  "releaseDate": "2026-10-23",
  "maintainer": "@larsrossen",
  "status": "Production",
  "vmname": "identity",
  "vmid": 140,
  "vmtag": "TAPPaaS,Foundation",
  "dependsOn": [
    "cluster:vm",
    "cluster:ha",
    "templates:nixos",
    "backup:vm",
    "network:proxy"
  ],
  "integratesWith": [
    "logging:logs"
  ],
  "provides": [
    "accessControl",
    "identity"
  ],
  "config": {
    "cluster:vm": {
      "cores": 2,
      "coresSmallLarge": [2, 4],
      "memory": 4096,
      "memorySmallLarge": [2048, 8192],
      "diskSize": "32G",
      "diskSmallLarge": ["32G", "64G"],
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "bridge0": "lan"
    },
    "network:proxy": {
      "proxyPort": 9000,
      "proxyAllowedZones": [
        "internet"
      ]
    },
    "logging:logs": {
      "dropUnits": [
        "generate-authentik-secrets.*",
        "authentik-env-secrets-only.*"
      ]
    }
  },
  "performance": {
    "exporters": [
      {
        "name": "authentik",
        "port": 9301,
        "path": "/metrics",
        "level": "service",
        "keep": [
          "authentik_main_request_duration_seconds_*",
          "authentik_flows_*",
          "authentik_outposts_*",
          "authentik_system_*",
          "django_http_requests_total_by_view_transport_method_total",
          "django_http_responses_total_by_status_view_method_total",
          "django_http_requests_latency_seconds_by_view_method_*"
        ]
      },
      {
        "name": "postgres",
        "port": 9187,
        "level": "service",
        "keep": [
          "pg_up",
          "pg_stat_database_numbackends",
          "pg_stat_database_xact_commit",
          "pg_stat_database_xact_rollback",
          "pg_stat_database_blks_*",
          "pg_stat_database_deadlocks",
          "pg_database_size_bytes",
          "pg_settings_max_connections"
        ]
      },
      {
        "name": "redis",
        "port": 9121,
        "level": "service",
        "keep": [
          "redis_up",
          "redis_connected_clients",
          "redis_memory_used_bytes",
          "redis_commands_processed_total",
          "redis_keyspace_hits_total",
          "redis_keyspace_misses_total",
          "redis_evicted_keys_total"
        ]
      }
    ],
    "traces": {
      "otlp": false,
      "level": "trace",
      "note": "authentik ships no OpenTelemetry exporter (Sentry only); set true when it exports OTLP"
    },
    "thresholds": [
      {
        "signal": "http_p95_seconds",
        "warning": 1.5,
        "critical": 5,
        "for": "15m"
      }
    ]
  }
}
