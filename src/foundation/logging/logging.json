{
  "description": "Centralized log aggregation with Grafana Loki, Alloy and Grafana UI",
  "displayName": "Grafana",
  "kind": "vm",
  "version": "0.3.0",
  "stack": "foundation",
  "releaseDate": "2026-05-14",
  "maintainer": "@larsrossen",
  "status": "Production",
  "vmname": "logging",
  "vmid": 150,
  "vmtag": "TAPPaaS,Foundation",
  "dependsOn": [
    "cluster:vm",
    "templates:nixos",
    "backup:vm",
    "network:proxy"
  ],
  "integratesWith": [
    "identity:identity"
  ],
  "provides": [
    "logs",
    "metrics",
    "traces"
  ],
  "identity": {
    "launchPath": "/login/generic_oauth",
    "providesAdminRole": true,
    "oidcRedirectPaths": [
      "/login/generic_oauth"
    ],
    "secretsEnv": "/etc/secrets/logging.env",
    "configureService": "logging-configure-oidc.service"
  },
  "config": {
    "cluster:vm": {
      "cores": 2,
      "coresSmallLarge": [1, 4],
      "memory": 4096,
      "memorySmallLarge": [2048, 8192],
      "diskSize": "32G",
      "diskSmallLarge": ["16G", "256G"],
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "bridge0": "lan"
    },
    "network:proxy": {
      "proxyPort": 3000,
      "proxyAllowedZones": [
        "mgmt"
      ]
    }
  },
  "performance": {
    "exporters": [
      {
        "name": "grafana",
        "port": 3000,
        "level": "service",
        "keep": [
          "grafana_http_request_duration_seconds_*",
          "grafana_alerting_rule_evaluation_failures_total",
          "grafana_alerting_rule_evaluations_total",
          "grafana_stat_totals_dashboard"
        ]
      },
      {
        "name": "loki",
        "port": 3102,
        "level": "service",
        "keep": [
          "loki_request_duration_seconds_*",
          "loki_distributor_lines_received_total",
          "loki_distributor_bytes_received_total",
          "loki_ingester_memory_streams",
          "loki_discarded_samples_total"
        ]
      },
      {
        "name": "alloy",
        "port": 9080,
        "level": "service",
        "keep": [
          "alloy_component_controller_running_components",
          "prometheus_remote_storage_samples_total",
          "prometheus_remote_storage_samples_failed_total",
          "prometheus_remote_storage_samples_pending",
          "otelcol_receiver_accepted_metric_points_total",
          "otelcol_receiver_refused_metric_points_total"
        ]
      },
      {
        "name": "prometheus",
        "port": 3122,
        "level": "service",
        "keep": [
          "prometheus_tsdb_head_series",
          "prometheus_tsdb_head_samples_appended_total",
          "prometheus_tsdb_storage_blocks_bytes",
          "prometheus_tsdb_wal_storage_size_bytes",
          "prometheus_tsdb_compactions_failed_total"
        ]
      },
      {
        "name": "prometheus-trends",
        "port": 3123,
        "level": "service",
        "keep": [
          "prometheus_tsdb_head_series",
          "prometheus_tsdb_storage_blocks_bytes"
        ]
      }
    ]
  }
}
