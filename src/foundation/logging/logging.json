{
  "description": "Centralized log aggregation with Grafana Loki, Promtail and Grafana UI",
  "kind": "vm",
  "version": "0.1.0",
  "stack": "foundation",
  "releaseDate": "2026-05-14",
  "maintainer": "@larsrossen",
  "status": "Development",
  "tier": "foundation",
  "vmname": "logging",
  "vmid": 150,
  "vmtag": "TAPPaaS,Foundation",
  "dependsOn": [
    "cluster:vm",
    "templates:nixos",
    "backup:vm",
    "network:proxy",
    "identity:identity"
  ],
  "provides": [],
  "identity": {
    "providesAdminRole": true,
    "oidcRedirectPaths": [
      "/login/generic_oauth"
    ],
    "secretsEnv": "/etc/secrets/logging.env",
    "configureService": "logging-configure-oidc.service"
  },
  "config": {
    "cluster:vm": {
      "cores": 2,
      "memory": "2048",
      "diskSize": "32G",
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "bridge0": "lan"
    },
    "network:proxy": {
      "proxyPort": 3000,
      "proxyAllowedZones": [
        "mgmt"
      ]
    }
  }
}
