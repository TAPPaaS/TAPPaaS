#!/usr/bin/perl
#
# tappaas-guest-memory — what each guest on this Proxmox node actually needs,
# once a minute, as one logfmt line per guest on stdout (#663).
#
# Installed on every node by logging/update.sh and run by
# tappaas-guest-memory.service, whose output the node's rsyslog already ships to
# Loki: {source="proxmox", unit="tappaas-guest-memory"}. logging/guest-memory-report.sh
# turns a window of it into the numbers module memory defaults are chosen from.
#
# What is measured, and why not Proxmox's own figure: Proxmox reports a VM's
# memory from the balloon's free_mem, which counts page cache as used (a 1 GB
# guest needing 0.3 GB reads 0.67 GB), or from the host's view when the guest
# reports nothing. The balloon also carries the guest's MemAvailable
# (stat-available-memory); total - available is the guest's own working set,
# the number `free` shows. Read through Proxmox's monitor API, so this never
# logs into a guest. A guest without balloon stats (FreeBSD, Windows, no
# driver) is reported measured=0 rather than given a number that misleads.
#
# A container's memory is its cgroup: used = memory.current - file (page cache).
#
# Fields: kind vmid vm measured total available used cache maxmem resident
#         oom_kills direct_reclaims alloc_stalls swap_in swap_out psi_some_avg60
# Counters (oom_kills … swap_out) count from the guest's boot.
#
# Metrics (ADR-046 P1): while the site's performance level is not off, the
# mothership writes /etc/pve/priv/tappaas-metrics.conf (url, auth), and each
# pass also pushes the same numbers as OpenTelemetry metrics to the logging
# VM's store, with the node's pressure (PSI) and its ZFS pools' wait times
# beside them. The file is read every pass: removed, the pushes stop. The log
# lines stay — guest-memory-report.sh reads them.

use strict;
use warnings;

use PVE::Cluster;
use PVE::QemuServer;
use PVE::QemuServer::Monitor qw(mon_cmd);
use PVE::LXC;
use PVE::INotify;
use JSON;
use LWP::UserAgent;

$| = 1;
my $INTERVAL = $ENV{TAPPAAS_GUEST_MEMORY_INTERVAL} || 60;
my $METRICS_CONF = $ENV{TAPPAAS_METRICS_CONF} || '/etc/pve/priv/tappaas-metrics.conf';
my @SAMPLES;    # this pass's guest samples, for the metrics push

sub slurp {
    my ($path) = @_;
    open(my $fh, '<', $path) or return undef;
    local $/;
    my $s = <$fh>;
    close($fh);
    return $s;
}

sub psi_some_avg60 {
    my $s = slurp("$_[0]/memory.pressure") // return undef;
    return $s =~ /^some .*avg60=([0-9.]+)/m ? $1 : undef;
}

sub logfmt {
    my (%f) = @_;
    my @order = qw(kind vmid vm measured total available used cache maxmem resident
                   oom_kills direct_reclaims alloc_stalls swap_in swap_out psi_some_avg60);
    return join(' ', map { "$_=$f{$_}" } grep { defined $f{$_} } @order);
}

sub sample_qemu {
    my $vms = eval { PVE::QemuServer::vmstatus() } // {};
    for my $vmid (sort { $a <=> $b } keys %$vms) {
        my $d = $vms->{$vmid};
        next unless ($d->{status} // '') eq 'running';
        my $scope = "/sys/fs/cgroup/qemu.slice/$vmid.scope";
        my %f = (
            kind => 'qemu', vmid => $vmid, vm => ($d->{name} // "vm$vmid"),
            maxmem => $d->{maxmem}, measured => 0,
            resident => do { my $c = slurp("$scope/memory.current"); defined $c ? $c + 0 : undef },
            psi_some_avg60 => psi_some_avg60($scope),
        );
        my $gs = eval {
            mon_cmd($vmid, 'qom-get', path => '/machine/peripheral/balloon0', property => 'guest-stats');
        };
        my $st = ($gs && $gs->{stats}) || {};
        my $fresh = $gs && $gs->{'last-update'} && (time() - $gs->{'last-update'}) <= 3 * $INTERVAL;
        if ($fresh && ($st->{'stat-available-memory'} // -1) >= 0 && ($st->{'stat-total-memory'} // 0) > 0) {
            $f{measured}  = 1;
            $f{total}     = $st->{'stat-total-memory'};
            $f{available} = $st->{'stat-available-memory'};
            $f{used}      = $f{total} - $f{available};
            $f{cache}     = $st->{'stat-disk-caches'};
            $f{oom_kills}       = $st->{'stat-oom-kills'};
            $f{direct_reclaims} = $st->{'stat-direct-reclaims'};
            $f{alloc_stalls}    = $st->{'stat-alloc-stalls'};
            $f{swap_in}         = $st->{'stat-swap-in'};
            $f{swap_out}        = $st->{'stat-swap-out'};
        }
        print logfmt(%f), "\n";
        push @SAMPLES, {%f};
    }
}

sub sample_lxc {
    my $cts = eval { PVE::LXC::vmstatus() } // {};
    for my $vmid (sort { $a <=> $b } keys %$cts) {
        my $d = $cts->{$vmid};
        next unless ($d->{status} // '') eq 'running';
        my $cg = "/sys/fs/cgroup/lxc/$vmid";
        my %f = (kind => 'lxc', vmid => $vmid, vm => ($d->{name} // "ct$vmid"),
                 maxmem => $d->{maxmem}, measured => 0, psi_some_avg60 => psi_some_avg60($cg));
        my $cur = slurp("$cg/memory.current");
        my $stat = slurp("$cg/memory.stat") // '';
        my ($file) = $stat =~ /^file (\d+)$/m;
        my ($oom) = (slurp("$cg/memory.events") // '') =~ /^oom_kill (\d+)$/m;
        if (defined $cur && defined $file) {
            $f{measured} = 1;
            $f{total}    = $d->{maxmem};
            $f{resident} = $cur + 0;
            $f{cache}    = $file + 0;
            $f{used}     = $cur - $file;
            $f{available} = $f{total} - $f{used} if $f{total};
            $f{oom_kills} = $oom;
        }
        print logfmt(%f), "\n";
        push @SAMPLES, {%f};
    }
}

# ── metrics ──────────────────────────────────────────────────────────

sub metrics_conf {
    my $s = slurp($METRICS_CONF) // return undef;
    my %c = map { /^([a-z]+)=(.*)$/ ? ($1 => $2) : () } split /\n/, $s;
    return ($c{url} && $c{auth}) ? \%c : undef;
}

# One OTLP data point: a double, its attributes as strings.
sub dp {
    my ($v, %a) = @_;
    return { timeUnixNano => sprintf('%d000000000', time()), asDouble => $v + 0,
             attributes => [ map { { key => $_, value => { stringValue => "$a{$_}" } } } sort keys %a ] };
}

# The node's own pressure: /proc/pressure/{cpu,memory,io}, some and full avg60.
sub node_psi {
    my ($node) = @_;
    my (@some, @full);
    for my $r (qw(cpu memory io)) {
        my $s = slurp("/proc/pressure/$r") // next;
        push @some, dp($1, node => $node, resource => $r) if $s =~ /^some .*avg60=([0-9.]+)/m;
        push @full, dp($1, node => $node, resource => $r) if $s =~ /^full .*avg60=([0-9.]+)/m;
    }
    return (@some ? { name => 'tappaas_node_psi_some_avg60', gauge => { dataPoints => \@some } } : (),
            @full ? { name => 'tappaas_node_psi_full_avg60', gauge => { dataPoints => \@full } } : ());
}

# Each ZFS pool's average total wait over one second (zpool iostat -l), in seconds.
# A pool that did no reads (writes) in that second shows "-" for the wait: that is
# no wait, 0, not a missing number — else an idle pool reads as unmeasured.
sub zpool_wait {
    my ($node) = @_;
    my (@r, @w);
    my $wait = sub { my ($ops, $w) = @_; $w =~ /^[0-9]+$/ ? $w / 1e9 : ($w eq '-' && $ops =~ /^0$/) ? 0 : undef };
    open(my $fh, '-|', 'zpool', 'iostat', '-Hpl', '-y', '1', '1') or return ();
    while (my $l = <$fh>) {
        chomp $l;
        my @c = split /\t/, $l;
        next unless @c >= 9;
        my ($rw, $ww) = ($wait->($c[3], $c[7]), $wait->($c[4], $c[8]));
        push @r, dp($rw, node => $node, pool => $c[0]) if defined $rw;
        push @w, dp($ww, node => $node, pool => $c[0]) if defined $ww;
    }
    close($fh);
    return (@r ? { name => 'tappaas_zpool_read_wait_seconds',  gauge => { dataPoints => \@r } } : (),
            @w ? { name => 'tappaas_zpool_write_wait_seconds', gauge => { dataPoints => \@w } } : ());
}

sub guest_metrics {
    my ($node) = @_;
    my %g = (used => 'used_bytes', total => 'total_bytes', available => 'available_bytes',
             cache => 'cache_bytes', resident => 'resident_bytes', maxmem => 'max_bytes',
             psi_some_avg60 => 'psi_some_avg60');
    my %c = (oom_kills => 'oom_kills_total', direct_reclaims => 'direct_reclaims_total',
             alloc_stalls => 'alloc_stalls_total', swap_in => 'swap_in_total', swap_out => 'swap_out_total');
    my (%gp, %cp);
    for my $s (@SAMPLES) {
        my %a = (node => $node, vmid => $s->{vmid}, kind => $s->{kind});
        for my $k (keys %g) { push @{$gp{$k}}, dp($s->{$k}, %a) if defined $s->{$k} && $s->{$k} =~ /^[0-9.]+$/; }
        for my $k (keys %c) { push @{$cp{$k}}, dp($s->{$k}, %a) if defined $s->{$k} && $s->{$k} =~ /^[0-9.]+$/; }
    }
    return ((map { { name => "tappaas_guest_memory_$g{$_}", gauge => { dataPoints => $gp{$_} } } } sort keys %gp),
            (map { { name => "tappaas_guest_$c{$_}",
                     sum => { dataPoints => $cp{$_}, aggregationTemporality => 2, isMonotonic => JSON::true } } } sort keys %cp));
}

sub push_metrics {
    my $c = metrics_conf() // return;
    my $node = PVE::INotify::nodename();
    my @m = (guest_metrics($node), node_psi($node), zpool_wait($node));
    return unless @m;
    my $body = encode_json({ resourceMetrics => [{
        resource => { attributes => [ { key => 'service.name', value => { stringValue => 'tappaas-guest-memory' } } ] },
        scopeMetrics => [{ scope => { name => 'tappaas-guest-memory' }, metrics => \@m }] }] });
    my $ua = LWP::UserAgent->new(timeout => 10, ssl_opts => { verify_hostname => 1 });
    my $r = $ua->post($c->{url}, 'Content-Type' => 'application/json', Authorization => $c->{auth}, Content => $body);
    print STDERR "metrics push to $c->{url} failed: ", $r->status_line, "\n" unless $r->is_success;
}

# --once: one sample and exit (tests, and a quick look by hand).
my $once = grep { $_ eq '--once' } @ARGV;
while (1) {
    # Without it vmstatus() sees no guests; each pass also picks up guests
    # that started, stopped or migrated here since the last one.
    eval { PVE::Cluster::cfs_update(); 1 } or print STDERR "cfs_update failed: $@";
    eval { sample_qemu(); 1 } or print STDERR "qemu sample failed: $@";
    eval { sample_lxc(); 1 }  or print STDERR "lxc sample failed: $@";
    eval { push_metrics(); 1 } or print STDERR "metrics push failed: $@";
    @SAMPLES = ();
    last if $once;
    sleep($INTERVAL - (time() % $INTERVAL));
}
