#!/usr/bin/env bash
# pbs-controller — Proxmox Backup Server (PBS) operations.
#
# The runtime half of backup: it queries and changes what PBS is actually doing,
# for backup-manager and for the operator. backup-manager decides policy; this
# carries it out. Most day-to-day work goes through backup-manager instead.
#
# Commands:
#   job-status [--json]     Query the managed PBS backup jobs: the daily job's vmid
#                           list, plus every bucket job and its members (#627)
#   list <module> [--json]  List snapshots for a module's VM (by vmid)
#   verify <module>         Trigger + report a PBS verify for a module's VM
#   backup <module>... [--json]
#                           Take a backup of each module's guest NOW, through the
#                           TAPPaaS job that covers it — its storage, mode and
#                           compression — on the node the guest runs on, VM or
#                           container. Refuses a module no TAPPaaS job covers.
#                           Waits, and names the snapshot it wrote; non-zero if
#                           any module's backup failed (#759)
#   coverage <module> [--json]
#   purge <vmid> [--yes] [--json]          erase vm/<vmid>'s restore points + start GC
#                                         (dry run without --yes; refuses a deployed
#                                         module's VMID or one still in a job, #789)
#                           Every cluster backup job that covers the module's VM —
#                           TAPPaaS's own and any other — and how (#554)
#   namespaces [--json]     List the datastore's namespaces
#   runs [--json]           What backup-manager's `restore list-all --json`
#                           shapes: every snapshot (namespace, guest, time,
#                           verification), the verify and sync jobs with their
#                           last run, and the cluster's backup jobs with their
#                           recent runs
#   add-to-job <vmid> [--retention <spec>] [--bucket daily|weekly|monthly]
#                           Place <vmid> in the backup job for its schedule, and
#                           remove it from the others — a guest belongs to exactly
#                           one. --retention is recorded; the datastore prune-job
#                           applies retention today.
#   key list                List the escrowed client encryption keys
#   key export <dest>       Copy the encryption keys to removable media. Keep
#                           this copy off the machine: the keys are stored on the
#                           mothership, which is the thing a full rebuild
#                           replaces, so without an off-system copy an encrypted
#                           backup cannot be decrypted by anyone.
#   key import <src>        Load keys from that media onto a rebuilt mothership.
#                           Do this before restoring anything that must decrypt.
#   key status [--json]     Whether a USB key stick holds the escrow's keys as
#                           they are now: the escrow's fingerprint against the
#                           one recorded when a stick was last written or read
#   key stamp --dir <dir> [--label <text>]
#                           Record that a stick holds the keys in <dir> (what
#                           keys-to-usb.sh read back, or keys-from-usb.sh
#                           decrypted). The USB scripts call this.
#   apply-schedule <spec>   Set the schedule of the backup job that <spec> maps
#                           to: daily | weekly | monthly, or a bare HH:MM meaning
#                           daily at that time. Nothing more often than daily.
#   help
#
# Global options, before the command:
#   --pbs <host>            The PBS for datastore operations (list, verify,
#                           namespaces), e.g. a satellite (ADR-012 P7). Cluster
#                           backup jobs and the key escrow are always local.
#   --json                  As --json after job-status / list / namespaces.
#
# The mutation verbs (add-to-job / apply-schedule) are how backup-manager's
# `reconcile` pushes the RESOLVED cascade into PBS: the manager resolves the
# Site->Environment->Module policy and calls these; the controller owns the PBS
# write. --json makes job-status / list / namespaces machine-readable so the
# TypeScript CliClient parses structured output (no fragile line scraping).
#
# Degrades gracefully when PBS / the cluster is unreachable: live commands print
# a skip notice and exit 0 (so offline runs and tests do not fail). Pure helpers
# (retention args, namespace paths) are unit-testable via --selftest.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
CONFIG_DIR="${CONFIG_DIR:-/home/tappaas/config}"
export CONFIG_DIR

# Locate the foundation PBS libs (repo layout) and the shared routines.
LIB_DIR="${PBS_LIB_DIR:-${HERE}/../../../backup/lib}"
COMMON="${COMMON_ROUTINES:-/home/tappaas/bin/common-install-routines.sh}"
[[ -f "$COMMON" ]] || COMMON="${HERE}/../../lib/common-install-routines.sh"

# Source shared routines (colours/logging/get_node_hostname) then the PBS libs.
# These are sourced WITHOUT a $1 module arg so no module JSON is auto-loaded.
# shellcheck source=/dev/null
[[ -f "$COMMON" ]] && . "$COMMON"
# shellcheck source=/dev/null
[[ -f "${LIB_DIR}/pbs-job.sh" ]] && . "${LIB_DIR}/pbs-job.sh"
# shellcheck source=/dev/null
[[ -f "${LIB_DIR}/pbs-namespace.sh" ]] && . "${LIB_DIR}/pbs-namespace.sh"

# Fallbacks if common routines were not found (keeps --selftest/--help working
# in a bare checkout). Real ops need the libs and will skip without them.
type info  >/dev/null 2>&1 || info()  { echo "[Info] $*"; }
type warn  >/dev/null 2>&1 || warn()  { echo "[Warning] $*" >&2; }
type error >/dev/null 2>&1 || error() { echo "[Error] $*" >&2; }

usage() {
    # The HEADER block only — comment lines from line 2 until the first line
    # that is not a comment. A blanket grep for '^#' pulled in every internal
    # note further down the file, so `--help` read like source commentary.
    awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
}

# shellcheck source=../../lib/cli-gate.sh
. "${HERE}/../../lib/cli-gate.sh"

# What each verb accepts (lib/cli-gate.sh; '=' marks an option with a value).
readonly CLI_SPEC='
job-status: --json --pbs=
list: --json --pbs=
coverage: --json
purge: --json --yes --pbs=
verify:
backup: --json
namespaces: --json --pbs=
runs: --json --pbs=
add-to-job: --retention= --bucket=
apply-schedule:
key list:
key export:
key import:
key status: --json
key stamp: --dir= --label=
'

# True if the PBS reuse libs loaded (functions present).
have_pbs_libs() { type pbs_managed_job_id >/dev/null 2>&1; }

# True if a mgmt node is reachable (a cheap probe before any heavy pvesh call).
pbs_reachable() {
    local node
    type get_node_hostname >/dev/null 2>&1 || return 1
    node="$(get_node_hostname 0 2>/dev/null)" || return 1
    [[ -n "$node" ]] || return 1
    ssh -n -o ConnectTimeout=5 -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
        "root@${node}.mgmt.internal" true >/dev/null 2>&1
}

# Resolve a module name to its VMID from the deployed config.
module_vmid() {
    local f="${CONFIG_DIR}/$1.json"
    [[ -f "$f" ]] || { error "No config for module '$1' in ${CONFIG_DIR}"; return 1; }
    jq -r '.vmid // empty' "$f" 2>/dev/null
}

# JSON_OUT is set by the per-command --json flag parser. When set, commands emit
# a single JSON value to stdout (and, when offline, a JSON object carrying
# {"reachable": false} so the caller never has to scrape a human skip line).
JSON_OUT=0

# Strip --json (and ADR-012 P7 --pbs <host>) from "$@", set JSON_OUT /
# PBS_ENDPOINT, and store the remaining args in the global REST array. Must run
# in the CURRENT shell so the globals propagate — callers do: parse_args "$@".
# Values main() lifted from before the verb are kept.
REST=()
PBS_ENDPOINT=""
parse_args() {
    REST=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) JSON_OUT=1; shift ;;
            # ADR-012 P7: target a non-local PBS (e.g. a satellite) for datastore
            # ops. Passed by the TS backup-manager's endpoint-agnostic CliClient.
            --pbs)  PBS_ENDPOINT="${2:-}"; shift 2 ;;
            --yes)  YES=1; shift ;;
            *)      REST+=("$1"); shift ;;
        esac
    done
}

# Override pbs_node (from pbs-job.sh) to honor --pbs when set, so PBS datastore
# ops (namespaces/list/verify) target the chosen endpoint instead of the local
# node. Cluster-job ops (pvesh) still run on the local mgmt node. NOTE: full
# satellite targeting (tunnel FQDN specifics) is validated on the 3-node cluster.
pbs_node() {
    if [[ -n "${PBS_ENDPOINT}" ]]; then
        printf '%s\n' "${PBS_ENDPOINT}"
        return 0
    fi
    # ADR-012 §2.1 (#600): the Host is `.node` (state `node`), or carried in
    # the pre-#600 state `node:<name>`. No Host recorded → fail, naming why;
    # never the cluster's first node, which is not where PBS runs (#457).
    local st n
    st="$(jq -r '.placementState // empty' "${PBS_CONFIG_DIR:-/home/tappaas/config}/backup.json" 2>/dev/null)"
    case "${st}" in
        node:?*) printf '%s\n' "${st#node:}"; return 0 ;;
    esac
    n="$(jq -r '.node // empty' "${PBS_CONFIG_DIR:-/home/tappaas/config}/backup.json" 2>/dev/null)"
    if [[ -n "$n" ]]; then printf '%s\n' "$n"; return 0; fi
    error "No PBS Host recorded (placementState '${st:-empty}', no .node) — run: module-manager module update backup" >&2
    return 1
}

# Skip-with-exit-0 helper for unreachable PBS (graceful degradation). In --json
# mode emit a structured offline marker instead of a human warning so the
# TypeScript CliClient can detect reachability without scraping text.
skip_offline() {
    if [[ "$JSON_OUT" -eq 1 ]]; then
        jq -n '{reachable: false}'
    else
        warn "PBS / cluster not reachable — skipping live operation: $*"
    fi
    exit 0
}

cmd_job_status() {
    parse_args "$@"
    have_pbs_libs || skip_offline "job-status (PBS libs not loaded)"
    pbs_reachable || skip_offline "job-status"
    local id store vmids
    id="$(pbs_managed_job_id)"
    store="$(pbs_storage_name)"
    if [[ -z "$id" ]]; then
        if [[ "$JSON_OUT" -eq 1 ]]; then
            jq -n --arg store "$store" '{reachable: true, jobId: null, vmids: [], storage: $store}'
        else
            info "No managed TAPPaaS PBS backup job found (none created yet)"
        fi
        return 0
    fi
    vmids="$(pbs_job_vmids "$id")"
    # `.buckets` carries every managed bucket job, `.vmids` stays the DAILY
    # job's list. #627: a coverage answer needs the union over all buckets, but
    # reconcile's "already a member of the right job" skip is per-bucket, so
    # redefining .vmids as the union would make a daily module sitting in the
    # weekly job look correctly placed. Two fields, two questions.
    local buckets
    buckets="$(pbs_bucket_jobs_json)"
    if [[ "$JSON_OUT" -eq 1 ]]; then
        jq -n --arg id "$id" --arg store "$store" --arg vmids "$vmids" \
            --argjson buckets "$buckets" \
            '{reachable: true, jobId: $id, storage: $store,
              vmids: ($vmids | split(",") | map(select(length > 0))),
              buckets: $buckets}'
    else
        info "Managed backup job: ${id}"
        info "  vmids: ${vmids}"
        info "  storage: ${store}"
        while IFS=$'\t' read -r _b _bid _bv; do
            [[ -n "${_b}" ]] || continue
            info "  ${_b} job ${_bid}: ${_bv:-<empty>}"
        done < <(jq -r '.[] | "\(.bucket)\t\(.jobId)\t\(.vmids | join(","))"' <<<"${buckets}" 2>/dev/null)
    fi
}

cmd_list() {
    parse_args "$@"
    local module="${REST[0]:?list: <module> required}" vmid
    vmid="$(module_vmid "$module")" || return 1
    [[ -n "$vmid" ]] || { error "Module '$module' has no vmid"; return 1; }
    pbs_reachable || skip_offline "list ${module} (vmid ${vmid})"
    local node store snaps
    node="$(pbs_node)"; store="$(pbs_storage_name)"
    snaps="$(ssh -n -o ConnectTimeout=10 -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
        "root@$(pbs_node_addr "${node}")" \
        "proxmox-backup-debug api get /admin/datastore/${store}/snapshots --output-format json 2>/dev/null" \
        | jq -r --arg vmid "$vmid" '.[]
              | select(.["backup-type"]=="vm" and (.["backup-id"]==$vmid))
              | .["backup-time"]' \
        2>/dev/null)" || { warn "could not list snapshots for vmid ${vmid}"; snaps=""; }
    if [[ "$JSON_OUT" -eq 1 ]]; then
        jq -n --arg snaps "$snaps" --arg module "$module" --arg vmid "$vmid" \
            '{reachable: true, module: $module, vmid: $vmid,
              snapshots: ($snaps | split("\n") | map(select(length > 0)))}'
    else
        info "Snapshots for ${module} (vmid ${vmid}) on ${store}:"
        [[ -n "$snaps" ]] && printf '%s\n' "$snaps"
    fi
}

# `purge <vmid> [--yes]` (#789): erase a guest's restore points — the backup
# group vm/<vmid> in this site's datastore (root namespace: our own backups;
# pull/<peer> copies of other sites are never touched) — then start garbage
# collection, which is what frees the space. Without --yes it only reports the
# plan. Refuses, even with --yes, when a deployed module still owns the VMID
# (archived ones excepted: erasing an archived module's backups is the point) or
# an enabled backup job lists it, and when the cluster cannot be asked — a purge
# never runs on a guess. backup-manager's `purge` wraps this with confirmation.
_purge_owner() {   # the deployed, non-archived module whose config has <vmid>
    local vmid="$1" f
    for f in "${CONFIG_DIR}"/*.json; do
        [[ -f "$f" ]] || continue
        jq -e --arg v "$vmid" '((.vmid // .config.vmid // "") | tostring) == $v
                               and ((.status // "") != "archived")' "$f" >/dev/null 2>&1 \
            && { basename "$f" .json; return 0; }
    done
    return 1
}

cmd_purge() {
    YES=0
    parse_args "$@"
    local vmid="${REST[0]:-}" owner cov jobs node store snaps n bytes
    [[ "$vmid" =~ ^[0-9]+$ ]] || { error "purge: <vmid> required (a number)"; return 2; }
    have_pbs_libs || { error "purge: PBS libs not loaded — nothing purged"; return 1; }
    pbs_reachable || { error "purge: the cluster is not reachable — nothing purged"; return 1; }

    local refuse=()
    if owner="$(_purge_owner "$vmid")"; then
        refuse+=("vmid ${vmid} belongs to the deployed module '${owner}' — delete the module first")
    fi
    cov="$(pbs_job_coverage_json "$vmid")" \
        || { error "purge: could not read the cluster's backup jobs — nothing purged"; return 1; }
    jobs="$(jq -r '[.[] | select(.enabled and .how == "explicit") | .jobId] | join(", ")' <<<"$cov")"
    [[ -z "$jobs" ]] || refuse+=("vmid ${vmid} is still listed in backup job(s) ${jobs} — remove it there first")

    node="$(pbs_node)" || return 1
    store="$(pbs_storage_name)"
    snaps="$(_pbs_node_run proxmox-backup-debug api get "/admin/datastore/${store}/snapshots" \
                 --backup-type vm --backup-id "$vmid" --output-format json 2>/dev/null)" \
        || { error "purge: could not list vm/${vmid} on ${store} — nothing purged"; return 1; }
    n="$(jq 'length' <<<"$snaps")"
    bytes="$(jq '[.[].size // 0] | add // 0' <<<"$snaps")"

    # One JSON object, written last: _purge_json <purged true|false>.
    _purge_json() {
        jq -nc --arg vmid "$vmid" --arg store "$store" --argjson n "$n" --argjson bytes "$bytes" \
              --argjson purged "$1" --arg refuse "$(printf '%s\n' "${refuse[@]}")" \
            '{reachable: true, vmid: $vmid, store: $store, snapshots: $n, bytes: $bytes,
              refused: ($refuse | split("\n") | map(select(length > 0))), purged: $purged}'
    }
    if [[ "$JSON_OUT" -ne 1 ]]; then
        info "vm/${vmid} on ${store} (node ${node}): ${n} restore point(s), $(numfmt --to=iec "$bytes" 2>/dev/null || echo "${bytes} bytes") referenced"
        jq -r '.[] | "  \(.["backup-time"] | strftime("%Y-%m-%d %H:%M"))  \(.size // 0)"' <<<"$snaps" 2>/dev/null | head -50
    fi
    if [[ ${#refuse[@]} -gt 0 ]]; then
        local r; for r in "${refuse[@]}"; do error "purge refused: ${r}"; done
        [[ "$JSON_OUT" -eq 1 ]] && _purge_json false
        return 1
    fi
    if [[ "$n" -eq 0 || "$YES" -ne 1 ]]; then
        if [[ "$JSON_OUT" -eq 1 ]]; then _purge_json false
        elif [[ "$n" -eq 0 ]]; then info "  nothing to purge"
        else info "  dry run — run with --yes to delete the group and start garbage collection"; fi
        return 0
    fi

    _pbs_node_run proxmox-backup-debug api delete "/admin/datastore/${store}/groups" \
        --backup-type vm --backup-id "$vmid" >/dev/null \
        || { error "purge: deleting vm/${vmid} failed — check the datastore by hand"; return 1; }
    [[ "$JSON_OUT" -eq 1 ]] || info "  ${GN:-}✓${CL:-} deleted vm/${vmid} (${n} restore point(s)) from ${store}"
    # `garbage-collection start` follows the task to its end — on a large
    # datastore that is a long time, and purge hung on it (hrossen, #789 live
    # test). The task runs in the PBS daemon, so stop following after a few
    # seconds: exit 124 means it is running.
    local gc_rc=0
    _pbs_node_run timeout 15 proxmox-backup-manager garbage-collection start "$store" >/dev/null 2>&1 || gc_rc=$?
    if [[ $gc_rc -eq 0 || $gc_rc -eq 124 ]]; then
        [[ "$JSON_OUT" -eq 1 ]] || info "  garbage collection started on ${store} — the space is free when it finishes (proxmox-backup-manager garbage-collection status ${store})"
    else
        # stderr: in --json mode stdout carries the one JSON object only.
        warn "  garbage collection did not start (already running?) — the space is freed at the next run" >&2
    fi
    [[ "$JSON_OUT" -eq 1 ]] && _purge_json true
    return 0
}

# `coverage <module>` (#554): which jobs back this VM up — ours and anyone
# else's — so a duplicate is visible, not silent. Asks /cluster/backup once.
cmd_coverage() {
    parse_args "$@"
    local module="${REST[0]:?coverage: <module> required}" vmid cov
    vmid="$(module_vmid "$module")" || return 1
    [[ -n "$vmid" ]] || { error "Module '$module' has no vmid"; return 1; }
    have_pbs_libs || skip_offline "coverage (PBS libs not loaded)"
    pbs_reachable || skip_offline "coverage ${module} (vmid ${vmid})"
    cov="$(pbs_job_coverage_json "$vmid")" || skip_offline "coverage ${module} (vmid ${vmid})"
    if [[ "$JSON_OUT" -eq 1 ]]; then
        jq -n --arg module "$module" --arg vmid "$vmid" --argjson jobs "$cov" \
            '{reachable: true, module: $module, vmid: $vmid, jobs: $jobs}'
        return 0
    fi
    info "Backup jobs covering ${module} (vmid ${vmid}):"
    jq -r '.[] | "  \(.jobId)  \(.how)  \(if .managed then "TAPPaaS" else "not TAPPaaS" end)\(if .enabled then "" else " (disabled)" end)  storage \(.storage)  schedule \(.schedule)"' <<<"$cov"
    local n; n="$(jq '[.[] | select(.enabled)] | length' <<<"$cov")"
    [[ "$n" -gt 0 ]] || warn "  no enabled job covers it"
    [[ "$n" -le 1 ]] || warn "  ${n} enabled jobs cover it — it is backed up more than once (#554)"
}

# _bk_plan <jobs-json> <resources-json> <vmid> <marker> — pure (#759).
# How to back up <vmid> now, from `pvesh get /cluster/backup` and
# `pvesh get /cluster/resources --type vm`, as one TSV line:
#   <node> <qemu|lxc> <jobId> <storage> <mode> <compress>
# rc 1 + reason on stdout when no TAPPaaS job (comment <marker>, -weekly,
# -monthly) lists the VMID — an on-demand backup through a job the module is not
# in would be a backup the platform does not manage; rc 2 when the cluster has
# no such guest.
_bk_plan() {
    local jobs="$1" res="$2" vmid="$3" marker="$4" job where
    job="$(jq -r --arg v "$vmid" --arg m "$marker" '
        [ .[] | select(((.comment // "") as $c | $c == $m or $c == "\($m)-weekly" or $c == "\($m)-monthly")
                       and (((.vmid // "") | tostring | split(",")) | index($v) != null)) ][0]
        // empty | [.id, .storage, (.mode // "snapshot"), (.compress // "")] | @tsv' <<<"$jobs")"
    [[ -n "$job" ]] || { echo "no TAPPaaS backup job covers vmid ${vmid}"; return 1; }
    where="$(jq -r --argjson v "$vmid" '[ .[] | select(.vmid == $v) ][0] // empty | [.node, .type] | @tsv' <<<"$res")"
    [[ -n "$where" ]] || { echo "the cluster has no guest with vmid ${vmid}"; return 2; }
    printf '%s\t%s\n' "$where" "$job"
}

# backup <module>... — take each module's backup now (#759). Unlike the query
# verbs this does NOT degrade to "skipped, exit 0" when the cluster is
# unreachable: an operator asked for a backup, and none was taken.
cmd_backup() {
    parse_args "$@"
    [[ ${#REST[@]} -gt 0 ]] || { error "backup: <module>... required"; return 2; }
    have_pbs_libs || { error "backup: PBS libs not loaded — no backup taken"; return 1; }
    pbs_reachable || { error "backup: the cluster is not reachable — no backup taken"; return 1; }
    local jobs res
    jobs="$(_pbs_ssh "pvesh get /cluster/backup --output-format json")" \
        || { error "backup: could not read the cluster's backup jobs — no backup taken"; return 1; }
    res="$(_pbs_ssh "pvesh get /cluster/resources --type vm --output-format json")" \
        || { error "backup: could not list the cluster's guests — no backup taken"; return 1; }
    local m vmid plan node type jobid store mode comp start out rc volid failed=0 results="[]"
    for m in "${REST[@]}"; do
        volid=""; rc=1
        vmid="$(module_vmid "$m")" || vmid=""
        if [[ -z "$vmid" ]]; then
            error "${m}: no vmid in its config — nothing to back up"
        elif ! plan="$(_bk_plan "$jobs" "$res" "$vmid" "$PBS_JOB_MARKER")"; then
            error "${m} (vmid ${vmid}): ${plan} — wire it in first: backup-manager add ${m}"
        else
            IFS=$'\t' read -r node type jobid store mode comp <<<"$plan"
            info "${BOLD:-}Backing up ${m}${CL:-} (${type} ${vmid} on ${node}) → ${store}, ${mode} mode, as job ${jobid:0:8} would"
            start="$(date +%s)"
            # The job's own settings, so an on-demand backup is one the job could
            # have taken: same storage, mode and compression, nothing else.
            out="$(ssh -n -o ConnectTimeout=10 -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
                "root@${node}.mgmt.internal" \
                "vzdump ${vmid} --storage ${store} --mode ${mode}${comp:+ --compress ${comp}} --notes-template 'on demand: backup-manager backup ${m}'" 2>&1)" \
                && rc=0 || rc=$?
            if [[ "$rc" -eq 0 ]]; then
                # Trust, then verify: the snapshot this run wrote, newer than its start.
                volid="$(_pbs_ssh "pvesh get /nodes/${node}/storage/${store}/content --vmid ${vmid} --output-format json" 2>/dev/null \
                    | jq -r --argjson t "$((start - 5))" '[ .[] | select(.ctime >= $t) ] | sort_by(.ctime) | last | .volid // empty')"
                if [[ -n "$volid" ]]; then
                    info "  ${GN:-}✓${CL:-} ${volid}"
                else
                    rc=1
                    error "  vzdump reported success but no new snapshot of ${vmid} is on ${store}"
                fi
            else
                error "  vzdump failed (exit ${rc}):"
                printf '%s\n' "$out" | grep -iE 'error|fail' | tail -5 | sed 's/^/    /' >&2
            fi
        fi
        [[ "$rc" -eq 0 ]] || failed=$((failed + 1))
        results="$(jq -c --arg m "$m" --arg v "${vmid}" --arg id "$volid" --argjson ok "$([[ $rc -eq 0 ]] && echo true || echo false)" \
            '. + [{module: $m, vmid: $v, ok: $ok, volid: (if $id == "" then null else $id end)}]' <<<"$results")"
    done
    [[ "$JSON_OUT" -eq 1 ]] && jq -n --argjson r "$results" '{reachable: true, backups: $r}'
    if [[ "$failed" -gt 0 ]]; then
        error "${failed} of ${#REST[@]} backup(s) not taken"
        return 1
    fi
    return 0
}

cmd_verify() {
    local module="${1:?verify: <module> required}" vmid
    vmid="$(module_vmid "$module")" || return 1
    [[ -n "$vmid" ]] || { error "Module '$module' has no vmid"; return 1; }
    pbs_reachable || skip_offline "verify ${module} (vmid ${vmid})"
    type pbs_ensure_verify >/dev/null 2>&1 || skip_offline "verify (pbs lib missing)"
    info "Ensuring datastore verification covers vmid ${vmid} (reuses pbs_ensure_verify)"
    pbs_ensure_verify
}

cmd_namespaces() {
    parse_args "$@"
    have_pbs_libs || skip_offline "namespaces (PBS libs not loaded)"
    type pbs_ns_list >/dev/null 2>&1 || skip_offline "namespaces (pbs-namespace lib missing)"
    pbs_reachable || skip_offline "namespaces"
    local store nslist
    store="$(pbs_storage_name)"
    nslist="$(pbs_ns_list)"
    if [[ "$JSON_OUT" -eq 1 ]]; then
        jq -n --arg store "$store" --arg ns "$nslist" \
            '{reachable: true, storage: $store,
              namespaces: ($ns | split("\n") | map(select(length > 0)))}'
    else
        info "Namespaces in ${store}:"
        printf '%s\n' "$nslist" | sed 's/^/  /'
    fi
}

# `runs`: the raw material for "when did each guest last back up, and was it
# verified" — one ssh to the PBS Host for the datastore (every namespace's
# snapshots, verify and sync jobs), one to a mgmt node for the cluster's backup
# jobs and their recent vzdump tasks. Shaping is backup-manager's (restore.ts).
cmd_runs() {
    parse_args "$@"
    have_pbs_libs || skip_offline "runs (PBS libs not loaded)"
    pbs_reachable || skip_offline "runs"
    local node store ds jobs tasks
    node="$(pbs_node)" || skip_offline "runs (no PBS Host)"
    store="$(pbs_storage_name)"
    ds="$(ssh -o ConnectTimeout=10 -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
        "root@$(pbs_node_addr "${node}")" "bash -s -- '${store}'" 2>/dev/null <<'REMOTE'
store="$1"
api() { proxmox-backup-debug api get "$@" --output-format json 2>/dev/null; }
# One JSON line per snapshot, to a file: hundreds of them overflow an argument.
lines="$(mktemp)"; trap 'rm -f "${lines}"' EXIT
while IFS= read -r ns; do
    api "/admin/datastore/${store}/snapshots" ${ns:+--ns "${ns}"} \
        | jq -c --arg ns "${ns}" '.[] | {ns: $ns, type: .["backup-type"], id: .["backup-id"],
              time: .["backup-time"], size: (.size // null), verification: (.verification // null)}' >> "${lines}"
done < <(api "/admin/datastore/${store}/namespace" | jq -r '.[].ns')
jq -n --slurpfile snaps "${lines}" --argjson verify "$(api /admin/verify || echo '[]')" \
    --argjson sync "$(api /admin/sync || echo '[]')" \
    '{snapshots: $snaps, verifyJobs: $verify, syncJobs: $sync}'
REMOTE
)" || skip_offline "runs (${node} did not answer)"
    jq -e 'type == "object"' >/dev/null 2>&1 <<<"${ds}" || skip_offline "runs (no datastore answer from ${node})"
    jobs="$(_pbs_ssh "pvesh get /cluster/backup --output-format json" 2>/dev/null)" || jobs="[]"
    tasks="$(_pbs_ssh "pvesh get /cluster/tasks --output-format json" 2>/dev/null \
        | jq -c '[ .[] | select(.type == "vzdump") | {node, id, starttime, endtime, status} ]' 2>/dev/null)" || tasks="[]"
    if [[ "$JSON_OUT" -eq 1 ]]; then
        # The datastore answer on stdin: as an argument it overflows ARG_MAX.
        jq --arg node "${node}" --arg store "${store}" --arg marker "${PBS_JOB_MARKER:-}" \
            --argjson jobs "${jobs:-[]}" --argjson tasks "${tasks:-[]}" \
            '{reachable: true, node: $node, store: $store, marker: $marker,
              backupJobs: [ $jobs[] | {id, comment: (.comment // ""), schedule: (.schedule // ""),
                            enabled: ((.enabled // 1) | tostring != "0"), vmid: ((.vmid // "") | tostring),
                            storage: (.storage // "")} ],
              tasks: $tasks} + .' <<<"${ds}"
    else
        info "Backups in ${store} on ${node}:"
        jq -r '.snapshots | group_by(.ns)[] | "  \(.[0].ns // "" | if . == "" then "(own guests)" else . end): \(length) snapshot(s)"' <<<"${ds}"
        jq -r '.verifyJobs[] | "  verify \(.id): last \(.["last-run-state"] // "never")"' <<<"${ds}"
    fi
}

# ── PBS mutations (driven by backup-manager reconcile) ────────────────
# add-to-job <vmid> [--retention <spec>] [--bucket daily|weekly|monthly] —
# place <vmid> in the backup job for its resolved schedule (ADR-012 §3.2/D16),
# creating that job if absent. `place`, not `add`: a guest belongs to exactly
# one bucket, so this also removes it from the others — otherwise a schedule
# change would leave it backed up on both cadences.
# --retention is recorded/echoed for the manager but per-job prune wiring is a
# follow-up; the shared job + the foundation prune-job own retention.
cmd_add_to_job() {
    local vmid="" retention="" bucket="daily"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --retention) retention="$2"; shift 2 ;;
            --bucket) bucket="$2"; shift 2 ;;
            -*) error "add-to-job: unknown option $1"; return 2 ;;
            *) vmid="$1"; shift ;;
        esac
    done
    [[ -n "$vmid" ]] || { error "add-to-job: <vmid> required"; return 2; }
    have_pbs_libs || skip_offline "add-to-job (PBS libs not loaded)"
    type pbs_place_vmid >/dev/null 2>&1 || skip_offline "add-to-job (pbs-job lib missing)"
    pbs_reachable || skip_offline "add-to-job ${vmid}"
    [[ -n "$retention" ]] && info "  (retention '${retention}' noted; per-job prune wiring is a follow-up)"
    pbs_place_vmid "$vmid" "$bucket"
}

# apply-schedule <spec> — assert the calendar event on the backup job for the
# bucket <spec> resolves to (ADR-012 §3.2). <spec> is daily|weekly|monthly or a
# bare HH:MM; the bucket's job is the one carrying that bucket's marker.
cmd_apply_schedule() {
    local spec="${1:?apply-schedule: <spec> required (daily|weekly|monthly|HH:MM)}"
    have_pbs_libs || skip_offline "apply-schedule (PBS libs not loaded)"
    pbs_reachable || skip_offline "apply-schedule ${spec}"
    local bucket cal id marker
    bucket="$(pbs_schedule_bucket "$spec")" || {
        error "apply-schedule: '${spec}' is not a supported schedule — use daily | weekly | monthly | HH:MM (never more often than once a day)"
        return 2
    }
    cal="$(pbs_schedule_calendar "$bucket" "$(pbs_schedule_starttime "$spec")")"
    marker="$(pbs_bucket_marker "$bucket")"
    id="$(pbs_managed_job_id "$marker")"
    [[ -n "$id" ]] || { info "No ${bucket} backup job yet — nothing to schedule"; return 0; }
    info "Setting ${bucket} backup job ${id} schedule → ${cal}"
    _pbs_ssh "pvesh set /cluster/backup/${id} --schedule '${cal}'" >/dev/null \
        || { error "Failed to set the schedule for job ${id}"; return 1; }
}

# ── Encryption-key escrow (ADR-012 §2.5.1) ───────────────────────────
#
# Backups are encrypted client-side, so a key that outlives the client is the
# difference between a restore and a pile of ciphertext. TAPPaaS escrows every
# client key centrally on the mothership — but that escrow sits INSIDE the
# system a full-site DR is rebuilding, so it cannot be the only copy. These
# verbs are the out-of-band copy and its way back in.
KEY_ESCROW_DIR="${TAPPAAS_KEY_ESCROW:-/etc/secrets/backup-fs}"

cmd_key() {
    local sub="${1:-list}"; [[ $# -gt 0 ]] && shift || true
    case "${sub}" in
        list)   _key_list ;;
        export) _key_export "$@" ;;
        import) _key_import "$@" ;;
        status) _key_status "$@" ;;
        stamp)  _key_stamp "$@" ;;
        *) error "key: expected 'list' | 'export <dest>' | 'import <src>' | 'status' | 'stamp --dir <dir>'"; return 2 ;;
    esac
}

# sudo only where it is needed: update-tappaas.service asks for `key status`
# under NoNewPrivileges, where sudo cannot work, and the escrow is the sweep's
# own (tappaas, 0700) there.
_key_sudo() { [[ -r "${1:-${KEY_ESCROW_DIR}}" && -x "${1:-${KEY_ESCROW_DIR}}" ]] || printf 'sudo '; }

_key_names() { $(_key_sudo) find "${KEY_ESCROW_DIR}" -maxdepth 1 -name '*.key' -printf '%f\n' 2>/dev/null | sort; }

# ── The stick's stamp ────────────────────────────────────────────────
#
# A key that changes after the last stick was written is a key no stick holds,
# and the warning printed when it changed scrolls past in a scheduled sweep. So
# the stick's writer records the FINGERPRINT of the key set it wrote, and `key
# status` compares it with the escrow's as it is now, every time it is asked.
#
# The fingerprint is a sha256 over each key's name and sha256 — it says whether
# two key sets are the same, and nothing about the keys. Superseded keys count:
# a rotation adds one, and the stick must carry it for the older backups.
KEY_STAMP_FILE="${KEY_ESCROW_DIR}/usb-copy.json"

# _key_fingerprint_of <dir> [sudo] — the fingerprint of the *.key files in <dir>;
# empty when it holds none.
_key_fingerprint_of() {
    local dir="$1" s n sum names lines=""
    s="$(_key_sudo "${dir}")"
    names="$(${s}find "${dir}" -maxdepth 1 -name '*.key' -printf '%f\n' 2>/dev/null | LC_ALL=C sort)"
    [[ -n "${names}" ]] || return 0
    while IFS= read -r n; do
        # A key this user cannot read is a fingerprint nobody can vouch for:
        # fail, rather than fingerprint a set with a hole in it.
        if [[ -r "${dir}/${n}" ]]; then sum="$(sha256sum < "${dir}/${n}")" || return 1
        else sum="$(sudo -n sha256sum -- "${dir}/${n}" 2>/dev/null)" || return 1; fi
        lines+="${sum%% *} ${n}"$'\n'
    done <<< "${names}"
    printf '%s' "${lines}" | sha256sum | cut -d' ' -f1
}

_key_stamp() {
    local dir="" label=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dir)   dir="${2:-}"; shift 2 ;;
            --label) label="${2:-}"; shift 2 ;;
            *) error "key stamp: unexpected '$1'"; return 2 ;;
        esac
    done
    [[ -n "${dir}" && -d "${dir}" ]] || { error "key stamp: --dir <dir> required (the keys the stick holds)"; return 2; }
    [[ -d "${dir%/}/tappaas-backup-keys" ]] && dir="${dir%/}/tappaas-backup-keys"
    local fp n
    fp="$(_key_fingerprint_of "${dir}")" || { error "key stamp: could not read the keys in ${dir}"; return 1; }
    [[ -n "${fp}" ]] || { error "key stamp: no keys in ${dir}"; return 1; }
    n="$(find "${dir}" -maxdepth 1 -name '*.key' | wc -l | tr -d ' ')"
    # Beside the keys, as they are written: the escrow is the sweep's (tappaas,
    # 0700) on a mothership; sudo only for one this user cannot write.
    local s="sudo "
    [[ -d "${KEY_ESCROW_DIR}" && -w "${KEY_ESCROW_DIR}" ]] && s=""
    jq -n --arg fp "${fp}" --argjson n "${n}" --arg at "$(date -Iseconds)" --arg label "${label}" \
        '{fingerprint: $fp, keys: $n, written: $at, label: $label}' \
        | ( umask 077; ${s}tee "${KEY_STAMP_FILE}" >/dev/null ) \
        || { error "key stamp: could not write ${KEY_STAMP_FILE}"; return 1; }
    ${s}chmod 600 "${KEY_STAMP_FILE}"
    info "  recorded: the key stick holds these ${n} key(s)"
    return 0
}

# _key_status_doc — {escrowed, fingerprint, stick, current}. stick is the stamp
# (null when no stick was ever recorded); current is true when the stick holds
# the escrow's keys as they are now, or when there are no keys to hold — and
# null when a key could not be read, which is not knowing, not "fine".
_key_status_doc() {
    local fp n stamp ok=1
    fp="$(_key_fingerprint_of "${KEY_ESCROW_DIR}")" || { fp=""; ok=0; }
    n="$(_key_names | grep -c . || true)"
    stamp="$($(_key_sudo) cat "${KEY_STAMP_FILE}" 2>/dev/null | jq -c 'select(type == "object")' 2>/dev/null)" || stamp=""
    jq -n --arg fp "${fp}" --argjson n "${n:-0}" --argjson stick "${stamp:-null}" --argjson ok "${ok}" '{
        escrowed: $n,
        fingerprint: (if $fp == "" then null else $fp end),
        stick: $stick,
        current: (if $ok == 0 then null
                  else ($n == 0 or ($stick != null and $stick.fingerprint == $fp)) end)
    }'
}

# _key_status_say <doc> — the one line a person reads; warn when no stick holds
# the keys as they are now.
_key_status_say() {
    local doc="$1"
    if [[ "$(jq -r .current <<<"${doc}")" == "null" ]]; then
        warn "  could not read every escrowed key — whether a key stick holds them is unknown"
    elif [[ "$(jq -r .escrowed <<<"${doc}")" == "0" ]]; then
        info "  no keys escrowed — nothing for a stick to hold"
    elif [[ "$(jq -r .current <<<"${doc}")" == "true" ]]; then
        info "  ${GN}✓${CL} the last key stick holds these keys ($(jq -r '(.stick.written // "")[0:10] + (if (.stick.label // "") != "" then ", " + .stick.label else "" end)' <<<"${doc}"))"
    elif [[ "$(jq -r '.stick == null' <<<"${doc}")" == "true" ]]; then
        warn "  NO key stick has been written: a full-site restore has nothing to decrypt with."
        warn "  Write one now: backup-manager key export --usb"
    else
        warn "  The keys changed after the last key stick was written ($(jq -r '(.stick.written // "?")[0:10]' <<<"${doc}")): it does not hold them all."
        warn "  Write the sticks again: backup-manager key export --usb"
    fi
}

_key_status() {
    [[ "${1:-}" == "--json" ]] && JSON_OUT=1
    local doc; doc="$(_key_status_doc)"
    if [[ "$JSON_OUT" -eq 1 ]]; then printf '%s\n' "${doc}"; return 0; fi
    info "Backup encryption keys (${KEY_ESCROW_DIR}):"
    _key_status_say "${doc}"
}

_key_list() {
    local n count=0
    if [[ "$JSON_OUT" -eq 1 ]]; then
        _key_names | jq -R . | jq -s --arg d "${KEY_ESCROW_DIR}" '{escrow: $d, keys: .}'
        return 0
    fi
    info "Escrowed client encryption keys (${KEY_ESCROW_DIR}):"
    while IFS= read -r n; do
        [[ -n "$n" ]] || continue
        info "  ${n%.key}"
        count=$((count + 1))
    done < <(_key_names)
    if [[ "${count}" -eq 0 ]]; then
        warn "  none — no client-side encrypted backups are configured yet"
    else
        _key_status_say "$(_key_status_doc)"
    fi
}

_key_export() {
    local dest="${1:-}"
    [[ -n "${dest}" ]] || { error "key export: <dest> required (a directory on removable media)"; return 2; }
    [[ -d "${dest}" ]] || { error "key export: '${dest}' is not a directory — mount the media first"; return 2; }
    local names; names="$(_key_names)"
    [[ -n "${names}" ]] || { error "key export: no keys in ${KEY_ESCROW_DIR}"; return 1; }

    local out="${dest%/}/tappaas-backup-keys"
    mkdir -p "${out}" || { error "key export: cannot create ${out}"; return 1; }
    chmod 700 "${out}"
    local n
    while IFS= read -r n; do
        [[ -n "$n" ]] || continue
        # The redirect is deliberately UNprivileged: sudo reads the escrowed key
        # (root, 0600) and the shell writes it to the operator's media as the
        # operator. shellcheck reads this as the usual sudo-redirect mistake.
        # shellcheck disable=SC2024
        sudo cat "${KEY_ESCROW_DIR}/${n}" > "${out}/${n}" || { error "key export: could not read ${n}"; return 1; }
        chmod 600 "${out}/${n}"
        info "  exported ${n%.key}"
    done <<< "${names}"

    # A plain-text README on the media, because the person who needs it will be
    # rebuilding a site and will not have this repository to hand.
    cat > "${out}/README.txt" <<'READMEEOF'
TAPPaaS backup encryption keys — KEEP THIS MEDIA SAFE AND OFF-SITE.

These keys decrypt this site's backups. Anyone holding them plus a copy of the
backup data can read it; anyone WITHOUT them cannot restore, no matter what
else survives.

pve-storage-<storage>.key decrypts the VM and container backups (it is the
Proxmox storage key, /etc/pve/priv/storage/<storage>.enc). The other keys
decrypt the filesystem captures (config/, /etc/secrets) of each host.

The mothership is lost, and you restore it from its own VM backup:
  1. On any surviving node, put the storage key back first — the mothership's
     backup is encrypted with it, and the escrow that held it was ON the
     mothership:
       pvesm set <storage> --encryption-key "$(cat pve-storage-<storage>.key)"
  2. qmrestore <volid> 130 --storage <pool>; start it.
  3. On it: backup-manager key import --file <this-directory>

The mothership is reinstalled instead (or the whole cluster is):
  1. backup-manager key import --file <this-directory>
  2. module-manager module update backup — it puts the imported storage key
     back on the cluster rather than making a new one, so every existing
     backup stays readable.
  3. Restore; it will decrypt.
READMEEOF
    chmod 600 "${out}/README.txt"
    info "${GN}✓${CL} keys exported to ${out} (mode 600)"
    warn "  These files are NOT encrypted. For a password-protected copy on a USB stick in a"
    warn "  node: backup-manager key export --usb (RESTORE.md §0)."
    warn "  Store this media somewhere safe and OFF-SITE. Losing every copy of a key"
    warn "  makes the backups it encrypted permanently unreadable."
}

_key_import() {
    local src="${1:-}"
    [[ -n "${src}" ]] || { error "key import: <src> required (the directory holding exported keys)"; return 2; }
    [[ -d "${src}" ]] || { error "key import: '${src}' is not a directory"; return 2; }
    # Accept either the media root or the exported subdirectory.
    [[ -d "${src%/}/tappaas-backup-keys" ]] && src="${src%/}/tappaas-backup-keys"

    local found=0 f base
    # The escrow is tappaas's, 0700 — what tappaas-cicd.nix's tmpfiles rule makes
    # it, and what the sweep needs: update-tappaas.service writes it without sudo
    # (NoNewPrivileges, c53576a0). Imported as root (755/root), a rebuilt
    # mothership's first sweep could not escrow until a rebuild re-owned it
    # (#729, §5.2 rehearsal). Off the mothership there is no tappaas user: root.
    local owner="root:root"
    id tappaas >/dev/null 2>&1 && owner="tappaas:users"
    sudo mkdir -p "${KEY_ESCROW_DIR}" && sudo chmod 700 "${KEY_ESCROW_DIR}" \
        && sudo chown "${owner}" "${KEY_ESCROW_DIR}"
    for f in "${src%/}"/*.key; do
        [[ -f "$f" ]] || continue
        base="$(basename "$f")"
        # Never overwrite an escrowed key: on a rebuilt mothership there is
        # nothing to overwrite, and anywhere else a silent replacement could
        # strand every backup made with the key it replaced.
        if sudo test -s "${KEY_ESCROW_DIR}/${base}"; then
            warn "  ${base%.key}: already escrowed — left as-is"
            continue
        fi
        sudo cp "$f" "${KEY_ESCROW_DIR}/${base}" && sudo chmod 600 "${KEY_ESCROW_DIR}/${base}" \
            && sudo chown "${owner}" "${KEY_ESCROW_DIR}/${base}" \
            || { error "key import: could not install ${base}"; return 1; }
        info "  imported ${base%.key}"
        found=$((found + 1))
    done
    [[ "${found}" -gt 0 ]] || { warn "key import: nothing new to import from ${src}"; return 0; }
    info "${GN}✓${CL} ${found} key(s) imported into ${KEY_ESCROW_DIR}"
}

# Pure-function self-test (no cluster) — exercised by test.sh.
selftest() {
    local rc=0
    type _pbs_ns_acl_path >/dev/null 2>&1 || { echo "FAIL: pbs-namespace lib not loaded"; return 1; }
    [[ "$(_pbs_ns_acl_path tappaas_backup)" == "/datastore/tappaas_backup" ]] \
        || { echo "FAIL: acl path root"; rc=1; }
    [[ "$(_pbs_ns_acl_path tappaas_backup remote/lars)" == "/datastore/tappaas_backup/remote/lars" ]] \
        || { echo "FAIL: acl path ns"; rc=1; }
    [[ "$(_pbs_ns_parents remote/lars | paste -sd, -)" == "remote,remote/lars" ]] \
        || { echo "FAIL: ns parents"; rc=1; }
    [[ "$(_pbs_retention_args '{"keepLast":4,"keepDaily":14}')" == "--keep-last 4 --keep-daily 14" ]] \
        || { echo "FAIL: retention args"; rc=1; }
    [[ "$(_pbs_csv_add "1,3" 2)" == "1,2,3" ]] || { echo "FAIL: csv add"; rc=1; }
    [[ "$(_pbs_csv_remove "1,2,3" 2)" == "1,3" ]] || { echo "FAIL: csv remove"; rc=1; }
    [[ $rc -eq 0 ]] && echo "selftest: all pure-function checks passed"
    return $rc
}

main() {
    # Global options before the verb (ADR-012 P7): backup-manager's CliClient
    # calls `pbs-controller --pbs <host> <verb> …`.
    while [[ "${1:-}" == "--pbs" || "${1:-}" == "--json" ]]; do
        if [[ "$1" == "--json" ]]; then
            JSON_OUT=1
            shift
        else
            [[ -n "${2:-}" && "${2}" != -* ]] || { error "--pbs requires a host"; return 2; }
            PBS_ENDPOINT="$2"
            shift 2
        fi
    done
    local cmd="${1:-help}"
    cli_gate usage "${CLI_SPEC}" "$@"
    [[ $# -gt 0 ]] && shift || true
    case "$cmd" in
        job-status)     cmd_job_status "$@" ;;
        list)           cmd_list "$@" ;;
        verify)         cmd_verify "$@" ;;
        backup)         cmd_backup "$@" ;;
        coverage)       cmd_coverage "$@" ;;
        purge)          cmd_purge "$@" ;;
        namespaces)     cmd_namespaces "$@" ;;
        runs)           cmd_runs "$@" ;;
        add-to-job)     cmd_add_to_job "$@" ;;
        apply-schedule) cmd_apply_schedule "$@" ;;
        key)            cmd_key "$@" ;;
        --selftest)     selftest ;;
        help|-h|--help) usage ;;
        *) error "Unknown command: ${cmd}"; usage >&2; return 2 ;;
    esac
}

main "$@"
