{
  "description": "What the core records must keep doing, whatever else changes: each scenario is a few objects, a failure, and what must come out. rules check runs them; a site may retire one it no longer holds to.",
  "scenarios": [
    { "id": "core.scenario.node-down",
      "description": "A node down: the node is the one root; its guest, the guest's service and what depends on that service are impacted; the guest's own stop is derived.",
      "objects": [ { "class": "machine", "name": "n1" }, { "class": "machine", "name": "n2" }, { "class": "vm", "name": "identity" },
                   { "class": "service", "name": "identity:identity" }, { "class": "vm", "name": "nextcloud" }, { "class": "vm", "name": "other" } ],
      "relations": [ { "type": "runs-on", "from": "vm/identity", "to": "machine/n1" }, { "type": "runs-on", "from": "service/identity:identity", "to": "vm/identity" },
                     { "type": "runs-on", "from": "vm/nextcloud", "to": "machine/n2" }, { "type": "depends-on", "from": "vm/nextcloud", "to": "service/identity:identity" },
                     { "type": "runs-on", "from": "vm/other", "to": "machine/n2" } ],
      "conditions": [ { "object": "machine/n1", "type": "operational", "status": "critical", "reason": "node-down", "since": "2026-01-01T02:14:00.000Z" },
                      { "object": "vm/identity", "type": "operational", "status": "critical", "reason": "guest-stopped", "since": "2026-01-01T02:15:00.000Z" } ],
      "expect": { "roots": ["machine/n1"], "impact": { "vm/identity": "critical", "service/identity:identity": "critical", "vm/nextcloud": "critical", "vm/other": "none", "machine/n1": "none" },
                  "derived": ["vm/identity:operational"] } },
    { "id": "core.scenario.ha-guest",
      "description": "An HA-protected guest whose node fails is degraded, not down, and its stop is the node's failure.",
      "objects": [ { "class": "machine", "name": "n1" }, { "class": "vm", "name": "firewall", "attributes": { "haNode": "n2" } }, { "class": "vm", "name": "scratch" } ],
      "relations": [ { "type": "runs-on", "from": "vm/firewall", "to": "machine/n1" }, { "type": "runs-on", "from": "vm/scratch", "to": "machine/n1" } ],
      "conditions": [ { "object": "machine/n1", "type": "operational", "status": "critical", "reason": "node-down", "since": "2026-01-01T02:14:00.000Z" },
                      { "object": "vm/firewall", "type": "operational", "status": "critical", "reason": "guest-stopped", "since": "2026-01-01T02:15:00.000Z" } ],
      "expect": { "roots": ["machine/n1"], "impact": { "vm/firewall": "warning", "vm/scratch": "critical" }, "derived": ["vm/firewall:operational"] } },
    { "id": "core.scenario.covered-by-down",
      "description": "A guest's full disk on a node that is down is its own, but no root while the node is down.",
      "objects": [ { "class": "machine", "name": "n1" }, { "class": "vm", "name": "g" } ],
      "relations": [ { "type": "runs-on", "from": "vm/g", "to": "machine/n1" } ],
      "conditions": [ { "object": "machine/n1", "type": "operational", "status": "critical", "reason": "node-down" },
                      { "object": "vm/g", "type": "capacity", "status": "critical", "reason": "disk-full" } ],
      "expect": { "roots": ["machine/n1"], "covered": ["vm/g:capacity"] } },
    { "id": "core.scenario.warning-never-covers",
      "description": "A slow node does not explain a guest that stopped, and a warning never takes a critical's place as root.",
      "objects": [ { "class": "machine", "name": "n1" }, { "class": "vm", "name": "a" }, { "class": "vm", "name": "b" } ],
      "relations": [ { "type": "runs-on", "from": "vm/a", "to": "machine/n1" }, { "type": "runs-on", "from": "vm/b", "to": "machine/n1" } ],
      "conditions": [ { "object": "machine/n1", "type": "performance", "status": "warning", "reason": "cpu-pressure", "since": "2026-01-01T01:00:00.000Z" },
                      { "object": "vm/a", "type": "operational", "status": "critical", "reason": "guest-stopped", "since": "2026-01-01T02:00:00.000Z" },
                      { "object": "vm/b", "type": "capacity", "status": "critical", "reason": "disk-full", "since": "2026-01-01T03:00:00.000Z" } ],
      "expect": { "roots": ["vm/a", "vm/b", "machine/n1"], "impact": { "vm/a": "warning", "vm/b": "warning" } } },
    { "id": "core.scenario.redundancy-group",
      "description": "Two uplinks in one group: one down degrades the dependant and the member is the root; both down is the failure itself.",
      "objects": [ { "class": "port", "name": "a" }, { "class": "port", "name": "b" }, { "class": "port", "name": "nic" } ],
      "relations": [ { "type": "connects", "from": "port/nic", "to": "port/a", "attributes": { "redundancyGroup": "uplinks" } },
                     { "type": "connects", "from": "port/nic", "to": "port/b", "attributes": { "redundancyGroup": "uplinks" } } ],
      "conditions": [ { "object": "port/a", "type": "operational", "status": "critical", "reason": "link-down" } ],
      "expect": { "roots": ["port/a"], "impact": { "port/nic": "warning", "port/b": "none" } } },
    { "id": "core.scenario.cable-both-ends",
      "description": "Both ends of a cable see it down: the earlier is the root, the other the same failure.",
      "objects": [ { "class": "port", "name": "sw" }, { "class": "port", "name": "eno1" } ],
      "relations": [ { "type": "connects", "from": "port/sw", "to": "port/eno1" } ],
      "conditions": [ { "object": "port/sw", "type": "operational", "status": "critical", "reason": "link-down", "since": "2026-01-01T08:00:00.000Z" },
                      { "object": "port/eno1", "type": "operational", "status": "critical", "reason": "link-down", "since": "2026-01-01T08:00:03.000Z" } ],
      "expect": { "roots": ["port/sw"], "derived": ["port/eno1:operational"] } },
    { "id": "core.scenario.pool-faulted",
      "description": "A failed pool takes down what is stored on it, not what merely runs beside it; a degraded pool reaches nothing.",
      "objects": [ { "class": "machine", "name": "n1" }, { "class": "storage-pool", "name": "tank" }, { "class": "vm", "name": "on-pool" }, { "class": "vm", "name": "beside" } ],
      "relations": [ { "type": "runs-on", "from": "storage-pool/tank", "to": "machine/n1" }, { "type": "stored-on", "from": "vm/on-pool", "to": "storage-pool/tank" },
                     { "type": "runs-on", "from": "vm/beside", "to": "machine/n1" } ],
      "conditions": [ { "object": "storage-pool/tank", "type": "operational", "status": "critical", "reason": "pool-state" } ],
      "expect": { "roots": ["storage-pool/tank"], "impact": { "vm/on-pool": "critical", "vm/beside": "none", "machine/n1": "none" } } },
    { "id": "core.scenario.worst-root-named",
      "description": "An object reached by a warning root and a critical root names the critical one, and a critical of its own is covered only by it.",
      "objects": [ { "class": "machine", "name": "n1" }, { "class": "storage-pool", "name": "tank" }, { "class": "vm", "name": "g" } ],
      "relations": [ { "type": "runs-on", "from": "vm/g", "to": "machine/n1" }, { "type": "stored-on", "from": "vm/g", "to": "storage-pool/tank" } ],
      "conditions": [ { "object": "machine/n1", "type": "performance", "status": "warning", "reason": "cpu-pressure", "since": "2026-01-01T01:00:00.000Z" },
                      { "object": "storage-pool/tank", "type": "operational", "status": "critical", "reason": "pool-state", "since": "2026-01-01T02:00:00.000Z" },
                      { "object": "vm/g", "type": "capacity", "status": "critical", "reason": "disk-full", "since": "2026-01-01T03:00:00.000Z" } ],
      "expect": { "roots": ["storage-pool/tank", "machine/n1"], "impact": { "vm/g": "critical" }, "covered": ["vm/g:capacity"] } }
  ]
}
