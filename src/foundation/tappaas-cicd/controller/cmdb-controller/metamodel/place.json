{
  "description": "The place branch: where a CI or a resource stands. Physical. A room is named within its location, a rack within its room.",
  "classes": {
    "place": {
      "parent": "object",
      "abstract": true,
      "physical": true,
      "symbol": "⊕",
      "family": "places",
      "label": "place",
      "description": "Where something stands.",
      "fields": {}
    },
    "location": {
      "parent": "place",
      "symbol": "⌂",
      "family": "places",
      "label": "location",
      "description": "A place with an address: the site's building, a provider's data centre, a buddy's site (site.json locations).",
      "fields": {
        "kind": { "type": "string", "enum": ["site", "remote"] },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "timezone": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      }
    },
    "room": {
      "parent": "place",
      "symbol": "□",
      "family": "places",
      "label": "room",
      "description": "A room in a location.",
      "fields": {
        "name": { "key": 1 },
        "location": { "type": "relation", "relation": "at", "required": true, "key": 1 }
      }
    },
    "rack": {
      "parent": "place",
      "symbol": "▯",
      "family": "places",
      "label": "rack",
      "description": "A rack in a room.",
      "fields": {
        "name": { "key": 1 },
        "room": { "type": "relation", "relation": "placed-in", "required": true, "key": 1 },
        "units": { "type": "integer" },
        "width": { "type": "integer", "description": "Inches." },
        "numbering": { "type": "string", "enum": ["bottom-up", "top-down"] }
      }
    }
  }
}
