#!/usr/bin/env bash
#
# proxmox-manager — TAPPaaS Proxmox network provider (ADR-008)
#
# Reconciles the Proxmox hypervisor L2 layer to zones.json, the single source
# of truth. It owns two control points the rest of the stack depended on being
# correct by hand:
#
#   1. Per-VM trunks  — every VM whose module JSON declares trunks0/trunks1 has
#      its live `qm config netN ...,trunks=` resolved against zones.json (incl.
#      the ALL/* sentinel) and idempotently re-applied, preserving MAC/tag/
#      queues. This is data-driven across ALL trunk-bearing VMs, not just the
#      firewall — fixing #335 (a zone added after provisioning never reached the
#      firewall VM's static trunk list, so guests got no IP).
#
#   2. Node bridge-vids — the vlan-aware `lan` bridge on each node. v1 default is
#      least-privilege: the active VLAN set from zones.json rather than the
#      blanket 2-4094 config-network writes. Reported by `reconcile`; APPLY is
#      operator-gated (`bridge-vids --apply`) because rewriting a live node's
#      interfaces + ifreload is disruptive.
#
# This is the `proxmox-manager` provider in the ADR-008 orchestrator model; the
# five-verb contract maps here as: desired = resolved from zones.json + module
# JSONs on the fly, actual = interrogated live via qm/ssh, delta+apply below.
#
# Usage:
#   proxmox-manager reconcile [--apply]   # per-VM trunks (apply) + bridge-vids (report)
#   proxmox-manager trunks    [--apply]   # per-VM trunks only
#   proxmox-manager bridge-vids [--apply] # node bridge-vids (apply is operator-gated)
#   proxmox-manager show <vmname>         # resolved vs actual trunks for one VM
#
# Without --apply every command is a dry-run that only reports drift.
#

set -euo pipefail

# ── Logging / shared helpers ─────────────────────────────────────────
# shellcheck source=../../tappaas-cicd/scripts/common-install-routines.sh disable=SC1091
. /home/tappaas/bin/common-install-routines.sh

# Network helpers (vmnet_resolve_trunks / vmnet_parse / vmnet_build_netopts /
# vmnet_all_active_tags) — the same logic cluster:vm uses to build NICs.
# shellcheck source=../../cluster/lib/vm-net.sh disable=SC1091
. /home/tappaas/TAPPaaS/src/foundation/cluster/lib/vm-net.sh

# shellcheck source=../../lib/cli-gate.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../lib/cli-gate.sh"

readonly ZONES_FILE="${CONFIG_DIR}/zones.json"
readonly LAN_BRIDGE="lan"

# ── Counters for the summary / exit code ─────────────────────────────
DRIFT=0      # number of control points found out of sync
CHANGED=0    # number actually converged (with --apply)
ERRORS=0     # number of failures

# ── Usage ────────────────────────────────────────────────────────────

usage() {
    cat <<'EOF'
Usage: proxmox-controller <command> [--apply]

Commands:
  reconcile [--apply]     Per-VM trunks (applied) + node bridge-vids (reported)
  trunks    [--apply]     Reconcile per-VM trunks= for all trunk-bearing VMs
  bridge-vids [--apply]   Reconcile node lan bridge-vids (apply is operator-gated)
  show <vmname>           Show resolved-vs-actual trunks for one VM
  cpu-inventory [--apply] Every node's CPU: guest-visible features, the CPU
                          models it runs, its x86-64 level; the level common
                          to all; per node pair whether a live move is safe
                          (#827). --apply writes config/cluster-cpu.{json,md}
  live-ok <vmname> <node> Can this guest LIVE-migrate to <node>? (ADR-019)
                          0 = safe, 2 = would lose CPU features or has local
                          disks with snapshots, 1 = unknown

Without --apply, commands report drift only (dry-run). Exit code is non-zero if
drift remains after the command (so callers/CI can gate on convergence).
EOF
}

# What each verb accepts (lib/cli-gate.sh).
readonly CLI_SPEC='
reconcile: --apply
trunks: --apply
bridge-vids: --apply
show:
live-ok:
cpu-inventory: --apply
'

# ── Cluster helpers ──────────────────────────────────────────────────

# Print "vmid<TAB>node" for every VM in the cluster (queried once).
_vm_node_map() {
    local primary
    primary=$(get_primary_node_fqdn 2>/dev/null || echo "tappaas1.mgmt.internal")
    ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new root@"${primary}" \
        "pvesh get /cluster/resources --type vm --output-format json 2>/dev/null" \
        | jq -r '.[] | "\(.vmid)\t\(.node)"' 2>/dev/null
}

# Print every cluster node name.
_cluster_nodes() {
    local primary
    primary=$(get_primary_node_fqdn 2>/dev/null || echo "tappaas1.mgmt.internal")
    ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new root@"${primary}" \
        "pvesh get /cluster/resources --type node --output-format json 2>/dev/null" \
        | jq -r '.[].node' 2>/dev/null
}

# ── live-migration compatibility (ADR-019) ───────────────────────────
#
# "Can this guest move A→B without stopping?" With `cpu: host` — which is the
# schema default, so effectively every TAPPaaS guest — the guest's CPUID is the
# SOURCE host's. Move it to a host missing a feature the guest may be executing
# and it takes SIGILL. This estate is genuinely heterogeneous (Zen 4 / Zen 5 /
# Zen 3), so the question is real, not theoretical.
#
# The answer must come from what the GUEST sees, not from /proc/cpuinfo. The
# host flag list contains entries no guest is ever shown — `debug_swap`,
# `v_vmsave_vmload` — and comparing those refuses safe migrations, which is
# worse than not checking: an operator who is refused for no reason learns to
# pass --force by habit.
#
# QEMU answers it directly. `query-cpu-model-expansion` with type "static"
# expands `host` into the concrete, migration-stable feature set the guest is
# given; it is supported on x86 (unlike query-cpu-model-comparison, which is
# s390x-only). Comparing two expansions is the verdict.

# Features whose ABSENCE at the destination is advisory, not disqualifying.
#
# The superset rule is right for instruction sets: a guest that has JITted
# AVX-512 takes SIGILL the moment it lands on a host without it. It is wrong for
# mitigation and virtualization-control bits, which a guest READS rather than
# executes — losing `verw-clear` or `v-vmsave-vmload` changes security posture
# or nested-virt capability, it does not crash anything.
#
# The distinction is not cosmetic. On a heterogeneous estate the strict rule
# refuses EVERY direction over one such bit (here: verw-clear one way,
# v-vmsave-vmload the other), and a verdict that always says no teaches
# operators to pass --force without reading it — which is worse than not
# checking at all.
#
# Deliberately a SHORT, explicit list. Anything not named here is treated as
# disqualifying, so the failure mode of an unknown feature is to refuse, and
# adding to this list is a reviewable decision rather than a silent widening.
readonly CPU_ADVISORY_FEATURES="
amd-no-ssb
auto-ibrs
eraps
flush-l1d
ibpb
ibrs
ibrs-all
md-clear
pschange-mc-no
rsba
spec-ctrl
srso-user-kernel-no
ssb-no
stibp
tsa-l1-no
tsa-sq-no
v-vmsave-vmload
verw-clear
virt-ssbd
"

# Split missing features into (disqualifying, advisory).
#   cpu_classify_missing <missing-file> <disqualifying-out> <advisory-out>
# Pure — the unit test drives it with a canned list.
cpu_classify_missing() {
    local missing="$1" hard="$2" soft="$3" f
    : > "${hard}"; : > "${soft}"
    while read -r f; do
        [[ -n "${f}" ]] || continue
        if grep -qxF "${f}" <<< "${CPU_ADVISORY_FEATURES}"; then
            printf '%s\n' "${f}" >> "${soft}"
        else
            printf '%s\n' "${f}" >> "${hard}"
        fi
    done < "${missing}"
}

# The features a QMP expansion says the guest gets: the props set to true.
# Pure — the unit test feeds it canned QMP output.
cpu_features_from_qmp() {
    jq -r '.return.model.props // {} | to_entries[] | select(.value == true) | .key' 2>/dev/null | sort -u
}

# Features SRC has that DST lacks, one per line. Pure; empty output = live-safe.
#   cpu_missing <src-features-file> <dst-features-file>
cpu_missing() {
    comm -23 "$1" "$2"
}

# Local disks that stop a LIVE migrate to <dst>, one drive name per line (#825).
# Proxmox refuses online storage migration of a local volume that has snapshots
# unless a replication job already carries it to the target ("online storage
# migration not possible if non-replicated snapshot exists"). Every TAPPaaS VM
# on local ZFS keeps update snapshots, so this is the normal case, not an edge.
# The cloud-init drive is regenerated on the target and never blocks.
#   storage_live_blockers <dst> <vmid> < <precondition-json> 3< <replication-json>
# Pure — the unit test feeds it canned pvesh output.
storage_live_blockers() {
    local dst="$1" vmid="$2" repl
    repl="$(cat <&3 2>/dev/null)"
    [[ -n "${repl}" ]] || repl='[]'
    jq -r --arg dst "${dst}" --argjson vmid "${vmid}" --argjson repl "${repl}" '
        ([$repl[] | select((.guest | tonumber) == $vmid and .target == $dst
                           and ((.disable // 0) | tonumber) == 0)] | length > 0) as $replicated
        | .local_disks // [] | .[]
        | select((.cdrom // 0) == 0 and (.is_cloudinit // 0) == 0 and (.shared // 0) == 0)
        | select((.referenced_in_snapshot // {}) | length > 0)
        | select(($replicated and (.replicate // 0) == 1) | not)
        | .drivename' 2>/dev/null
}

# The live plumbing for storage_live_blockers: ask the source node what Proxmox
# itself checks before a migrate. rc 1 = could not ask.
_vm_storage_blockers() {
    local vmid="$1" src="$2" dst="$3" pre repl
    pre=$(ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "root@${src}.mgmt.internal" \
        "pvesh get /nodes/${src}/qemu/${vmid}/migrate --target ${dst} --output-format json" 2>/dev/null) || return 1
    repl=$(ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "root@${src}.mgmt.internal" \
        "pvesh get /cluster/replication --output-format json" 2>/dev/null) || repl='[]'
    storage_live_blockers "${dst}" "${vmid}" <<< "${pre}" 3<<< "${repl}"
}

# Expand `host` on a node, via the QMP socket of any VM already running there.
# Starting a throwaway QEMU just to ask would be a heavier operation than the
# migration it is gating, so a node running nothing yields no answer — and "no
# answer" is reported as UNKNOWN, never as safe.
_node_cpu_features() {
    local node="$1" vmid
    vmid=$(_vm_node_map | awk -v n="${node}" -F'\t' '$2 == n {print $1; exit}')
    [[ -n "${vmid}" ]] || return 1
    ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "root@${node}.mgmt.internal" \
        "printf %s '{\"execute\":\"qmp_capabilities\"}{\"execute\":\"query-cpu-model-expansion\",\"arguments\":{\"type\":\"static\",\"model\":{\"name\":\"host\"}}}' \
         | timeout 10 socat - UNIX-CONNECT:/var/run/qemu-server/${vmid}.qmp" 2>/dev/null \
        | tail -1 | cpu_features_from_qmp
}

# The guest TYPE ("qemu" or "lxc") the cluster reports for a vmid. /cluster/
# resources?type=vm returns containers as well as VMs, so this is not optional:
# without it a container gets a CPU-feature verdict, which is meaningless — a
# container shares the host kernel and Proxmox cannot live-migrate one at all.
_guest_type_of() {
    local vmid="$1" primary
    primary=$(get_primary_node_fqdn 2>/dev/null || echo "tappaas1.mgmt.internal")
    ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new root@"${primary}" \
        "pvesh get /cluster/resources --type vm --output-format json 2>/dev/null" 2>/dev/null \
        | jq -r --argjson v "${vmid}" '.[] | select(.vmid == $v) | .type' 2>/dev/null | head -1
}

# The vmid for a module/VM name, from its module config (flat or Pattern-A).
_vmid_of() {
    # Two statements, not one: bash expands every word of a `local` BEFORE the
    # builtin assigns any of them, so `local name="$1" f="…${name}…"` reads an
    # unbound `name` under `set -u`.
    local name="$1"
    local f="${CONFIG_DIR}/${name}.json"
    [[ -f "${f}" ]] || return 1
    local v; v=$(_mod_field "${f}" vmid)
    [[ -n "${v}" && "${v}" != "null" ]] || return 1
    printf '%s' "${v}"
}

# The cpu= a guest is actually running with. Read from the LIVE guest, not from
# config: what matters for migration is the CPUID the guest was given, and an
# undeclared cputype still resolves to something. Empty output means Proxmox
# omitted the line, which is its default — kvm64, a named model.
# The CPU model the guest RUNS, not the one its config names: a changed cputype
# is held until the guest restarts (#827), and until then the guest still has
# the old model's features. `qm pending` lists the running value as `cur`.
_vm_cputype() {
    local vmid="$1" node="$2"
    ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "root@${node}.mgmt.internal" \
        "qm pending ${vmid} 2>/dev/null" 2>/dev/null | cpu_running_model
}

# `qm pending` output → the running cpu model. Pure.
cpu_running_model() {
    sed -n 's/^cur cpu: *//p' | head -1 | cut -d, -f1
}

# Does <node> offer the named CPU model <model>?
_node_supports_model() {
    local node="$1" model="$2"
    ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "root@${node}.mgmt.internal" \
        "pvesh get /nodes/${node}/capabilities/qemu/cpu --output-format json 2>/dev/null" 2>/dev/null \
        | jq -e --arg m "${model}" 'any(.[]; .name == $m)' >/dev/null 2>&1
}

# ── CPU inventory (#827) ─────────────────────────────────────────────
# What each node's CPU offers a guest, and what that means across the cluster.
# Deterministic: KVM is asked, never guessed. One throwaway QEMU per node (no
# VM needed) answers two questions — the features `host` gives a guest
# (query-cpu-model-expansion) and which named models run there with nothing
# missing (query-cpu-definitions) — and Proxmox's own file says what its
# x86-64-v* models require. Everything after that is set arithmetic:
#   level(node)  the x86-64-v* model with the most flags, all of them offered
#   common       the same over the intersection of every node's features
#   matrix       per ordered pair A→B: what A offers and B lacks (hard = an
#                instruction a guest may execute; soft = advisory bits)
readonly CPU_INVENTORY_FILE="${CPU_INVENTORY_FILE:-/home/tappaas/config/cluster-cpu}"

# The node-side probe: sections a parser on this side turns into one record.
# shellcheck disable=SC2016  # expanded on the node, not here
readonly CPU_PROBE='
q='"'"'{"execute":"qmp_capabilities"}{"execute":"query-cpu-model-expansion","arguments":{"type":"static","model":{"name":"host"}}}{"execute":"query-cpu-definitions"}{"execute":"quit"}'"'"'
out=$(printf %s "$q" | timeout 30 qemu-system-x86_64 -machine none,accel=kvm -nodefaults -display none -qmp stdio 2>/dev/null)
echo "@@features"; printf "%s\n" "$out" | grep "\"model\"" | head -1
echo "@@definitions"; printf "%s\n" "$out" | grep "\"unavailable-features\"" | head -1
echo "@@levels"; perl -0777 -ne '"'"'while (/\x27(x86-64-v[0-9][\w-]*)\x27\s*=>\s*\{.*?flags\s*=>\s*"([^"]+)"/gs) { print "$1\t$2\n" }'"'"' /usr/share/perl5/PVE/QemuServer/CPUConfig.pm
echo "@@cpu"; lscpu | sed -n "s/^Vendor ID: *//p;s/^Model name: *//p"
'

# A probe's output as one node record. Pure — the unit test feeds it fixtures.
#   cpu_probe_record <node> < probe-output
cpu_probe_record() {
    local node="$1" raw
    raw="$(cat)"
    section() { awk -v s="@@$1" '$0 == s {on=1; next} /^@@/ {on=0} on' <<< "${raw}"; }
    jq -n --arg node "${node}" \
        --argjson exp "$(section features | head -1 | jq -c . 2>/dev/null || echo null)" \
        --argjson defs "$(section definitions | head -1 | jq -c . 2>/dev/null || echo null)" \
        --argjson levels "$(section levels | jq -R 'split("\t") | select(length == 2)
              | {(.[0]): (.[1] | split(";") | map(select(startswith("+")) | ltrimstr("+")))}' | jq -s 'add // {}')" \
        --arg vendor "$(section cpu | sed -n 1p)" --arg cpu "$(section cpu | sed -n 2p)" '
        { node: $node, cpu: $cpu, vendor: $vendor,
          features: ([($exp.return.model.props // {}) | to_entries[] | select(.value == true) | .key] | sort),
          models: ([($defs.return // [])[] | select((.["unavailable-features"] // []) | length == 0) | .name] | sort),
          levels: $levels }'
}

# Node records (a JSON array on stdin) → the inventory. Pure.
#   cpu_inventory_compute <advisory-features, newline-separated>
cpu_inventory_compute() {
    jq --arg adv "$1" '
        ($adv | split("\n") | map(select(. != ""))) as $soft
        | def runs_level($feats; $models): .value - $feats == [] and ($models | index("qemu64") != null);
          def best($levels; $feats; $models):
              [$levels | to_entries[] | select(runs_level($feats; $models))] | max_by(.value | length) | .key // null;
          def inter: if length == 0 then [] else reduce .[1:][] as $x (.[0]; . - (. - $x)) end;
        . as $n
        | (map(.features) | inter) as $cf
        | (map(.models) | inter) as $cm
        | { generated: (now | todate),
            levels: (($n[0].levels // {}) | map_values(length)),
            nodes: [ $n[] | {node, cpu, vendor, level: best(.levels; .features; .models),
                             featureCount: (.features | length)} ],
            common: { level: best(($n[0].levels // {}); $cf; $cm),
                      vendors: ([$n[].vendor] | unique),
                      vendorModels: [ $cm[] | select(test("^(host|max|base|qemu|kvm|x86-64)") | not) ] },
            matrix: [ $n[] as $a | $n[] as $b | select($a.node != $b.node)
                      | ($a.features - $b.features) as $m
                      | { from: $a.node, to: $b.node,
                          liveSafe: (($m - $soft) | length == 0),
                          hard: ($m - $soft), soft: ($m - ($m - $soft)) } ] }'
}

# The inventory as a page an operator reads (config/cluster-cpu.md). Pure.
cpu_inventory_markdown() {
    jq -r '
        . as $i
        | "# Cluster CPUs\n\nGenerated \(.generated) by `proxmox-controller cpu-inventory`. Do not edit.\n",
          "| Node | CPU | x86-64 level |", "|---|---|---|",
          (.nodes[] | "| \(.node) | \(.cpu) | \(.level // "?") |"),
          "", "Common to every node: **\(.common.level // "none")**" +
              (if .common.vendorModel then "; the richest vendor model all nodes run: **\(.common.vendorModel.name)** (\(.common.vendorModel.featureCount) features)" else "" end) + ".",
          "", "## Live moves with `cpu: host`", "",
          "A guest started on the row node and moved live to the column node. ✗ = the column node lacks instructions the guest may be using.", "",
          ("| from \\ to | " + ([.nodes[].node] | join(" | ")) + " |"),
          ("|---|" + ([.nodes[] | "---"] | join("|")) + "|"),
          (.nodes[].node as $f
           | "| \($f) | " + ([ $i.nodes[].node as $t
                               | if $t == $f then "—"
                                 else ($i.matrix[] | select(.from == $f and .to == $t)
                                       | if .liveSafe then "✓" else "✗ −\(.hard | length)" end) end ]
                             | join(" | ")) + " |"),
          "", (.matrix[] | select(.liveSafe | not) | "- \(.from) → \(.to) lacks: \(.hard | join(" "))")'
}

# The vendor's own models every node runs, sorted by how many features each
# gives a guest — QEMU expands each (on one node: a model's definition is the
# same everywhere). Only when every node has the same vendor: a vendor model
# does not run on the other's CPUs. Adds .common.vendorModel {name, featureCount}.
cpu_vendor_family() {
    case "$1" in
        AuthenticAMD|HygonGenuine) echo '^(EPYC|Opteron|Dhyana)' ;;
        GenuineIntel) echo '^(Nehalem|Westmere|SandyBridge|IvyBridge|Haswell|Broadwell|Skylake|Cascadelake|Cooperlake|Icelake|SapphireRapids|GraniteRapids|SierraForest|ClearwaterForest|DiamondRapids|Snowridge)' ;;
    esac
}
cpu_best_vendor_model() {
    local node="$1" inv family names q out best
    inv="$(cat)"
    if [[ "$(jq '.common.vendors | length' <<< "${inv}")" != "1" ]]; then echo "${inv}"; return 0; fi
    family="$(cpu_vendor_family "$(jq -r '.common.vendors[0]' <<< "${inv}")")"
    [[ -n "${family}" ]] || { echo "${inv}"; return 0; }
    names="$(jq -r --arg f "${family}" '.common.vendorModels[] | select(test($f))' <<< "${inv}")"
    [[ -n "${names}" ]] || { echo "${inv}"; return 0; }
    q='{"execute":"qmp_capabilities"}'
    while read -r m; do
        q+="{\"execute\":\"query-cpu-model-expansion\",\"arguments\":{\"type\":\"full\",\"model\":{\"name\":\"${m}\"}}}"
    done <<< "${names}"
    q+='{"execute":"quit"}'
    out="$(ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "root@${node}.mgmt.internal" \
        "printf %s '${q}' | timeout 60 qemu-system-x86_64 -machine none,accel=kvm -nodefaults -display none -qmp stdio" 2>/dev/null)" || true
    best="$(grep '"model"' <<< "${out}" | jq -sc '[ .[] | .return.model
              | {name, featureCount: ([.props // {} | to_entries[] | select(.value == true)] | length)} ]
            | sort_by(.featureCount, .name) | last // empty' 2>/dev/null)"
    if [[ -n "${best}" ]]; then
        jq --argjson b "${best}" '.common.vendorModel = $b' <<< "${inv}"
    else
        echo "${inv}"
    fi
}

cpu_inventory() {
    local apply="$1" node rec recs="[]" inv
    for node in $(get_all_node_hostnames); do
        rec="$(ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "root@${node}.mgmt.internal" \
                 "bash -s" <<< "${CPU_PROBE}" 2>/dev/null | cpu_probe_record "${node}")" || rec=""
        if [[ -z "${rec}" ]] || [[ "$(jq '.features | length' <<< "${rec}")" == "0" ]]; then
            error "cpu-inventory: could not probe ${node}'s CPU"
            ERRORS=$((ERRORS + 1))
            continue
        fi
        recs="$(jq -c --argjson r "${rec}" '. + [$r]' <<< "${recs}")"
    done
    [[ "$(jq length <<< "${recs}")" -gt 0 ]] || return 1
    inv="$(cpu_inventory_compute "${CPU_ADVISORY_FEATURES}" <<< "${recs}")"
    inv="$(cpu_best_vendor_model "$(get_node_hostname 0)" <<< "${inv}")"
    cpu_inventory_markdown <<< "${inv}"
    if [[ "${apply}" == "1" ]]; then
        jq . <<< "${inv}" > "${CPU_INVENTORY_FILE}.json"
        cpu_inventory_markdown <<< "${inv}" > "${CPU_INVENTORY_FILE}.md"
        info "cpu-inventory: written ${CPU_INVENTORY_FILE}.json and .md"
    fi
    [[ "${ERRORS}" -eq 0 ]]
}

# live-ok <vmname> <dst-node>
#   0  live migration is safe
#   2  NOT live-safe — the destination lacks features the guest has, or a
#      local disk carries snapshots
#   1  cannot determine (unreachable node, no VM to ask through, unknown guest)
live_ok() {
    local vmname="$1" dst="$2"
    local vmid src cputype
    vmid=$(_vmid_of "${vmname}") || { error "live-ok: no vmid for ${vmname}"; return 1; }
    src=$(_vm_node_map | awk -v v="${vmid}" -F'\t' '$1 == v {print $2; exit}')
    [[ -n "${src}" ]] || { error "live-ok: VMID ${vmid} is not running on any node"; return 1; }
    if [[ "${src}" == "${dst}" ]]; then
        info "live-ok: ${vmname} is already on ${dst}"
        return 0
    fi

    # Containers first: Proxmox has no live migration for LXC — a restart
    # migration is the only option — so the CPU question does not arise. Saying
    # so plainly beats a feature comparison that would be true but irrelevant.
    if [[ "$(_guest_type_of "${vmid}")" == "lxc" ]]; then
        warn "live-ok: ${vmname} (VMID ${vmid}) is a CONTAINER — Proxmox cannot live-migrate LXC."
        warn "  Moving it is a restart migration: stop, move, start. That needs --force."
        return 2
    fi

    # Storage before CPU: a local disk with snapshots cannot move live whatever
    # the CPUs say, and a named-model guest returns "safe" below without ever
    # looking at its disks.
    local blockers
    if ! blockers=$(_vm_storage_blockers "${vmid}" "${src}" "${dst}"); then
        error "live-ok: could not read the migrate preconditions of ${vmname} on ${src}"
        return 1
    fi
    if [[ -n "${blockers}" ]]; then
        warn "live-ok: ${vmname} has local disk(s) with snapshots: $(tr '\n' ' ' <<< "${blockers}")"
        warn "  Proxmox cannot move those live. Migrate offline (stop, move, start),"
        warn "  which needs an explicit --force."
        return 2
    fi

    # A NAMED model (not `host`) fixes the guest's CPUID independently of the
    # host, so the only question is whether the destination can run that model.
    cputype=$(_vm_cputype "${vmid}" "${src}")
    if [[ -n "${cputype}" && "${cputype}" != "host" ]]; then
        if _node_supports_model "${dst}" "${cputype}"; then
            info "live-ok: ${vmname} runs cpu '${cputype}', which ${dst} supports — live-safe"
            return 0
        fi
        error "live-ok: ${dst} does not support cpu model '${cputype}'"
        return 2
    fi

    local sf df missing
    sf=$(mktemp); df=$(mktemp)
    # shellcheck disable=SC2064
    trap "rm -f '${sf}' '${df}'" RETURN
    _node_cpu_features "${src}" > "${sf}" || true
    _node_cpu_features "${dst}" > "${df}" || true
    if [[ ! -s "${sf}" || ! -s "${df}" ]]; then
        error "live-ok: could not read the guest-visible CPU features of ${src} and/or ${dst}"
        error "  (a node with no running VM cannot be asked; treat as unknown, not as safe)"
        return 1
    fi

    local mf hard soft
    mf=$(mktemp); hard=$(mktemp); soft=$(mktemp)
    # shellcheck disable=SC2064
    trap "rm -f '${sf}' '${df}' '${mf}' '${hard}' '${soft}'" RETURN
    cpu_missing "${sf}" "${df}" > "${mf}"
    cpu_classify_missing "${mf}" "${hard}" "${soft}"

    if [[ -s "${soft}" ]]; then
        warn "live-ok: ${dst} lacks $(wc -l < "${soft}") advisory CPU feature(s): $(tr '\n' ' ' < "${soft}")"
        warn "  Mitigation/virt-control bits a guest reads rather than executes — not a crash risk."
    fi
    if [[ ! -s "${hard}" ]]; then
        info "live-ok: ${dst} offers every instruction-set feature ${vmname} has on ${src} — live-safe"
        return 0
    fi
    warn "live-ok: ${dst} lacks $(wc -l < "${hard}") instruction-set feature(s) ${vmname} has on ${src}:"
    warn "  $(tr '\n' ' ' < "${hard}")"
    warn "  A guest executing any of these takes SIGILL on arrival. Migrate offline"
    warn "  (stop, move, start), which needs an explicit --force."
    return 2
}

# Read a module-JSON field, tolerating both flat and Pattern-A (config.*) shapes.
#   _mod_field <module-json> <field>
_mod_field() {
    local f="$1" key="$2"
    normalize_module_config < "$f" 2>/dev/null | jq -r --arg k "$key" '.[$k] // empty' 2>/dev/null
}

# Sort a ';'-separated VLAN list numerically, dropping blanks, for comparison.
_norm() {
    echo "$1" | tr ';' '\n' | sed '/^$/d' | sort -n | tr '\n' ';' | sed 's/;$//'
}

# ── Per-VM trunk reconciliation ──────────────────────────────────────

# Reconcile one NIC's trunk list. Args:
#   <vmname> <vmid> <node-fqdn> <nic-index> <declared-trunks> <apply 0|1>
_reconcile_nic() {
    local vmname="$1" vmid="$2" node_fqdn="$3" idx="$4" decl="$5" apply="$6"
    local desired live_net live_bridge live_mac live_trunks live_tag live_queues

    desired=$(vmnet_resolve_trunks "${decl}" "${ZONES_FILE}" 2>/dev/null || true)
    if [[ -z "${desired}" ]]; then
        warn "  ${vmname} net${idx}: trunks '${decl}' resolved to nothing in zones.json — skipping"
        return
    fi

    live_net=$(ssh -o BatchMode=yes root@"${node_fqdn}" "qm config ${vmid}" 2>/dev/null \
        | awk -F': ' "/^net${idx}:/ {print \$2; exit}")
    if [[ -z "${live_net}" ]]; then
        warn "  ${vmname} net${idx}: declared trunks but VM has no net${idx} — skipping"
        return
    fi

    live_bridge=$(vmnet_parse "${live_net}" bridge)
    live_mac=$(vmnet_parse "${live_net}" mac)
    live_trunks=$(vmnet_parse "${live_net}" trunks)
    live_tag=$(vmnet_parse "${live_net}" tag)
    live_queues=$(vmnet_parse "${live_net}" queues)

    if [[ "$(_norm "${live_trunks}")" == "$(_norm "${desired}")" ]]; then
        info "  ${GN}✓${CL} ${vmname} net${idx} trunks in sync (${desired})"
        return
    fi

    DRIFT=$((DRIFT + 1))
    warn "  ${vmname} net${idx} trunks DRIFT: ${live_trunks:-none} → ${desired}"

    if [[ "${apply}" -ne 1 ]]; then
        return
    fi
    if [[ -z "${live_mac}" ]]; then
        error "  ${vmname} net${idx}: could not read live MAC — refusing to rewrite NIC"
        ERRORS=$((ERRORS + 1))
        return
    fi

    local opts
    opts=$(vmnet_build_netopts "${live_bridge}" "${live_mac}" "${live_tag}" "${desired}" "${live_queues}")
    # Single-quote the value so ';' in trunks=... is not a command separator.
    if ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new root@"${node_fqdn}" \
            "qm set ${vmid} --net${idx} '${opts}'" >/dev/null 2>&1; then
        info "  ${GN}✓${CL} ${vmname} net${idx} trunks applied (queues preserved: ${live_queues:-none})"
        CHANGED=$((CHANGED + 1))
        DRIFT=$((DRIFT - 1))
    else
        error "  ${vmname} net${idx}: qm set --net${idx} failed"
        ERRORS=$((ERRORS + 1))
    fi
}

# Reconcile trunks for every trunk-bearing VM module in CONFIG_DIR.
reconcile_trunks() {
    local apply="$1"
    info "${BOLD}Per-VM trunks${CL} (source: module JSON trunks0/trunks1 → zones.json)"

    local vm_map
    vm_map=$(_vm_node_map) || true
    if [[ -z "${vm_map}" ]]; then
        error "Could not query cluster VM locations — is the primary node reachable?"
        ERRORS=$((ERRORS + 1))
        return
    fi

    local f vmname vmid trunks0 trunks1 node node_fqdn found=0
    for f in "${CONFIG_DIR}"/*.json; do
        vmname=$(basename "$f" .json)
        [[ "${vmname}" == "zones" || "${vmname}" == "configuration" || "${vmname}" == "module-fields" ]] && continue

        trunks0=$(_mod_field "$f" trunks0)
        trunks1=$(_mod_field "$f" trunks1)
        [[ -z "${trunks0}" && -z "${trunks1}" ]] && continue   # not a trunk-bearing VM

        vmid=$(_mod_field "$f" vmid)
        if [[ -z "${vmid}" ]]; then
            warn "  ${vmname}: declares trunks but has no vmid — skipping"
            continue
        fi

        node=$(awk -v id="${vmid}" '$1==id {print $2; exit}' <<< "${vm_map}")
        if [[ -z "${node}" ]]; then
            warn "  ${vmname} (vmid ${vmid}): not found in the cluster — skipping"
            continue
        fi
        node_fqdn="${node}.mgmt.internal"
        found=1

        [[ -n "${trunks0}" ]] && _reconcile_nic "${vmname}" "${vmid}" "${node_fqdn}" 0 "${trunks0}" "${apply}"
        [[ -n "${trunks1}" ]] && _reconcile_nic "${vmname}" "${vmid}" "${node_fqdn}" 1 "${trunks1}" "${apply}"
    done

    [[ "${found}" -eq 0 ]] && info "  (no trunk-bearing VMs found)"
    return 0
}

# ── Node bridge-vids reconciliation (apply operator-gated) ───────────

# Desired least-privilege bridge-vids = active VLAN tags from zones.json,
# space-separated (the form /etc/network/interfaces expects).
_desired_bridge_vids() {
    vmnet_all_active_tags "${ZONES_FILE}" | tr ';' ' '
}

reconcile_bridge_vids() {
    local apply="$1"
    info "${BOLD}Node bridge-vids${CL} (lan bridge; least-privilege = active VLAN set)"

    local desired
    desired=$(_desired_bridge_vids)
    if [[ -z "${desired}" ]]; then
        warn "  No active VLAN tags resolved from zones.json — skipping bridge-vids"
        return
    fi
    info "  desired (least-privilege): ${desired}"

    local nodes node actual
    nodes=$(_cluster_nodes) || true
    if [[ -z "${nodes}" ]]; then
        error "  Could not enumerate cluster nodes"
        ERRORS=$((ERRORS + 1))
        return
    fi

    for node in ${nodes}; do
        # Read the FULL bridge-vids value of the lan stanza (may be a single
        # range like "2-4094" or a space-separated list like "200 210 ..."), so
        # the post-apply idempotency check compares the whole list, not just $1.
        actual=$(ssh -o BatchMode=yes root@"${node}.mgmt.internal" \
            "awk -v b='${LAN_BRIDGE}' '\$1==\"iface\" && \$2==b {f=1; next} f && \$1==\"bridge-vids\" {\$1=\"\"; sub(/^[ \t]+/,\"\"); print; exit} \$1==\"iface\"{f=0}' /etc/network/interfaces" \
            2>/dev/null || true)
        actual="${actual//$'\r'/}"
        actual="${actual#"${actual%%[![:space:]]*}"}"   # ltrim
        actual="${actual%"${actual##*[![:space:]]}"}"    # rtrim

        if [[ "${actual}" == "${desired}" ]]; then
            info "  ${GN}✓${CL} ${node}: bridge-vids in sync"
            continue
        fi
        DRIFT=$((DRIFT + 1))
        warn "  ${node}: bridge-vids DRIFT: '${actual:-<unset>}' → '${desired}'"

        if [[ "${apply}" -ne 1 ]]; then
            continue
        fi
        # Operator-gated apply: rewrite the lan stanza's bridge-vids and ifreload.
        # Disruptive on a live node — backup first.
        warn "  ${node}: applying bridge-vids (backup /etc/network/interfaces, then ifreload -a)"
        if ssh -o BatchMode=yes root@"${node}.mgmt.internal" "
                set -e
                cp -a /etc/network/interfaces /etc/network/interfaces.proxmox-manager.bak
                awk -v want='${desired}' '
                    /^iface ${LAN_BRIDGE} /{f=1}
                    f && /bridge-vids/{sub(/bridge-vids.*/, \"bridge-vids \" want); f=0}
                    {print}
                ' /etc/network/interfaces.proxmox-manager.bak > /etc/network/interfaces
                ifreload -a
            " >/dev/null 2>&1; then
            info "  ${GN}✓${CL} ${node}: bridge-vids applied"
            CHANGED=$((CHANGED + 1))
            DRIFT=$((DRIFT - 1))
        else
            error "  ${node}: bridge-vids apply failed (interfaces restored from .bak on the node)"
            ERRORS=$((ERRORS + 1))
        fi
    done
    return 0
}

# ── show <vmname> ────────────────────────────────────────────────────

show_vm() {
    local vmname="$1"
    local f="${CONFIG_DIR}/${vmname}.json"
    [[ -f "$f" ]] || die "Module config not found: ${f}"

    local vmid trunks0 trunks1 vm_map node node_fqdn
    vmid=$(_mod_field "$f" vmid)
    trunks0=$(_mod_field "$f" trunks0)
    trunks1=$(_mod_field "$f" trunks1)
    [[ -z "${vmid}" ]] && die "No vmid in ${f}"

    vm_map=$(_vm_node_map)
    node=$(awk -v id="${vmid}" '$1==id {print $2; exit}' <<< "${vm_map}")
    [[ -z "${node}" ]] && die "VM ${vmname} (vmid ${vmid}) not found in cluster"
    node_fqdn="${node}.mgmt.internal"

    info "${BOLD}${vmname}${CL} (vmid ${vmid}) on ${node}"
    local idx decl desired live_net live_trunks
    for idx in 0 1; do
        decl=$([[ "${idx}" -eq 0 ]] && echo "${trunks0}" || echo "${trunks1}")
        [[ -z "${decl}" ]] && continue
        desired=$(_norm "$(vmnet_resolve_trunks "${decl}" "${ZONES_FILE}" 2>/dev/null || true)")
        live_net=$(ssh -o BatchMode=yes root@"${node_fqdn}" "qm config ${vmid}" 2>/dev/null \
            | awk -F': ' "/^net${idx}:/ {print \$2; exit}")
        live_trunks=$(_norm "$(vmnet_parse "${live_net}" trunks)")
        printf "  net%s  declared=%-6s  desired(vlan)=%s\n" "${idx}" "${decl}" "${desired:-<none>}"
        printf "        actual(vlan)=%s  %s\n" "${live_trunks:-<none>}" \
            "$([[ "${desired}" == "${live_trunks}" ]] && echo "${GN}✓ in sync${CL}" || echo "${RD}✗ drift${CL}")"
    done
}

# ── Summary ──────────────────────────────────────────────────────────

summary() {
    echo ""
    if [[ "${ERRORS}" -gt 0 ]]; then
        error "${ERRORS} error(s); ${CHANGED} change(s) applied; ${DRIFT} still out of sync"
        exit 1
    fi
    if [[ "${DRIFT}" -gt 0 ]]; then
        warn "${DRIFT} control point(s) out of sync (${CHANGED} applied). Re-run with --apply to converge."
        exit 2
    fi
    info "${GN}Proxmox network in sync${CL} (${CHANGED} change(s) applied)"
}

# ── Argument parsing ─────────────────────────────────────────────────

main() {
    local cmd="${1:-}"
    [[ -z "${cmd}" ]] && { usage; exit 0; }
    cli_gate usage "${CLI_SPEC}" "$@"
    shift || true

    [[ -f "${ZONES_FILE}" ]] || die "zones.json not found: ${ZONES_FILE}"

    local apply=0 arg vmname=""
    for arg in "$@"; do
        case "${arg}" in
            --apply) apply=1 ;;
            -*) die "Unknown option: ${arg}" ;;
            *) vmname="${arg}" ;;
        esac
    done

    case "${cmd}" in
        reconcile)
            reconcile_trunks "${apply}"
            echo ""
            reconcile_bridge_vids 0   # report-only inside reconcile (apply is gated)
            summary
            ;;
        trunks)
            reconcile_trunks "${apply}"
            summary
            ;;
        bridge-vids)
            reconcile_bridge_vids "${apply}"
            summary
            ;;
        show)
            [[ -n "${vmname}" ]] || die "show requires a <vmname>"
            show_vm "${vmname}"
            ;;
        cpu-inventory)
            cpu_inventory "${apply}"
            exit $?
            ;;
        live-ok)
            # Two positionals, so the generic loop above (which keeps only the
            # last non-flag) is not enough — read them straight from "$@".
            [[ $# -ge 2 ]] || die "live-ok requires <vmname> <dst-node>"
            live_ok "$1" "$2"
            exit $?
            ;;
        *)
            die "Unknown command: ${cmd} (try --help)"
            ;;
    esac
}

# Only run when executed directly — allows the unit test to source and exercise
# the pure helper functions (_norm, _desired_bridge_vids) without a live cluster.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
