#!/usr/bin/env bash
#
# switch-manager — TAPPaaS physical-switch network provider (ADR-008, #339)
#
# Reconciles managed switches to zones.json (the single source of truth) so a
# zone's VLAN is carried on every node-uplink trunk. It maintains two files:
#
#   switch-configuration-actual.json   what is REALLY in the network (facts):
#       controllers, switches, and per-port topology (which node/AP/switch a
#       port connects to) + the VLAN config currently present once configured.
#   switch-configuration-desired.json  what zones.json IMPLIES — REGENERATED
#       from actual's topology + the active VLAN set (never hand-edited).
#
# Inventory (three tiers, all in actual):
#   controller  a management plane (e.g. UniFi OS) that adopts switches. Adding
#               one interrogates it → uploads its switches + ports.
#   switch      managed:auto (ports uploaded by interrogate, via a controller or
#               its own API) or managed:manual (ports added by hand).
#   port        {type,target,targetPort,...}; type ∈ node|switch|ap|device|uplink,
#               or {parked:true, zone} (#853): a port TAPPaaS does not use, an
#               access port in the park zone (iotLocal unless --park-zone).
#               `lag: <name>` puts it in a link aggregate (802.3ad LAG) with the
#               switch's other ports of that name; the lowest-numbered one leads
#               it, and carries `lagMembers` in desired and actual. Every other
#               member carries `lagLead: <lead>` (#854): it follows the lead's
#               VLANs, has no VLAN set of its own, and nothing is pushed to it.
#
# Five-verb provider contract (ADR-008 order):
#   interrogate     live/controller/manual state → actual.json (via vendor plugin)
#   update-desired  actual topology + zones.json → desired.json (regenerated)
#   delta           desired vs actual → VLANs to add/remove per port
#   apply           push via vendor plugin, or print manual steps
#   confirm         record applied VLAN config into actual.json
#   reconcile       = the five verbs in order (apply only with --apply)
#
# Vendor automation lives in scripts/plugins/<vendor>.sh; manual.sh is the
# fallback (prints a delta for manual application). A switch with managed:manual
# always uses manual.sh even if its brand has a plugin.
#
# Usage: see `switch-manager --help`.
#

set -euo pipefail

# shellcheck source=../../tappaas-cicd/scripts/common-install-routines.sh disable=SC1091
. /home/tappaas/bin/common-install-routines.sh
# shellcheck source=../../cluster/lib/vm-net.sh disable=SC1091
. /home/tappaas/TAPPaaS/src/foundation/cluster/lib/vm-net.sh

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
readonly SCRIPT_DIR
# shellcheck source=../../lib/cli-gate.sh
. "${SCRIPT_DIR}/../../lib/cli-gate.sh"
# PLUGIN_DIR is env-overridable so tests can supply stub vendor plugins.
PLUGIN_DIR="${PLUGIN_DIR:-/home/tappaas/TAPPaaS/src/foundation/network/scripts/plugins}"; readonly PLUGIN_DIR
readonly ZONES_FILE="${CONFIG_DIR}/zones.json"
readonly ACTUAL="${CONFIG_DIR}/switch-configuration-actual.json"
readonly DESIRED="${CONFIG_DIR}/switch-configuration-desired.json"

readonly PORT_TYPES="node switch ap device uplink"
JSON=0
# The zone a port TAPPaaS does not use is parked in (#853); --park-zone overrides.
PARK_ZONE="iotLocal"
PARK_REFUSED=0
# interrogate --no-park (#860): read only — the post-sweep read never parks.
NO_PARK=0
# Port types that are VLAN trunks (carry the full active VLAN set).
_is_trunk_type() { case " ${1} " in *" node "*|*" switch "*|*" ap "*|*" uplink "*) return 0;; *) return 1;; esac; }

# ── Usage ────────────────────────────────────────────────────────────

usage() {
    cat <<'EOF'
Usage: switch-manager <command> [args]

Inventory (recorded in switch-configuration-actual.json):
  add-controller <name> --vendor <v> --ip <ip> [--managed auto]
  remove-controller <name>
  add-switch <name> --vendor <v> --managed auto|manual [--controller <c>]
        [--ip <ip>] [--model <m>] [--location <l>] [--description <d>]
  remove-switch <name>
  add-port <switch> <port> --type node|switch|ap|device|uplink
        [--target <t>] [--target-port <tp>] [--mode trunk|access]
        [--zone <z>] [--native <vlan>] [--tagged 210,220] [--description <d>]
  update-port <switch> <port> [ ...same flags... ]
  update-port <switch> <port> --park [--park-zone <zone>]
                          park the port on the switch now (an access port in
                          iotLocal), then record it as parked
  remove-port <switch> <port> [--park-zone <zone>]
                          the same: the port goes back to parked
  lag set <switch> <name> --ports <p,p,...> [--apply]
                          ports become one LACP aggregate (a LAG named <name>);
                          --apply programs that switch at once
  lag remove <switch> <name> [--apply]
  lag list [<switch>] [--json]
  list [--json]
  list-ports [<switch>] [--json]
                          one line per port: actual config + drift vs zones.json
  show <controller|switch>

--json on list, list-ports and lag list prints the same facts as JSON.

Reconciliation (five-verb provider contract, run in this order):
  interrogate [--park-zone <zone>] [--no-park]
                          controller/auto switches -> actual.json (via plugin);
                          a port with no record and no link is recorded parked
                          (not with --no-park: read only, as after a sweep);
                          each switch read records when (lastRead)
  update-desired          actual topology + zones.json -> desired.json
  delta                   desired-vs-actual VLAN differences per port
  apply                   push delta via plugin (manual plugin prints steps)
  confirm [<switch>...]   record applied VLAN config in actual.json (all, or just
                          the named switches — use after hand-tagging a manual one)
  reconcile [--apply] [--park-zone <zone>]
                          run all five in order (apply only with --apply)

managed:manual switches are configured by hand (manual.sh prints what to tag);
managed:auto switches are programmed by their vendor plugin.

A parked port is an access port in the iotLocal zone (tier 6, no internet,
nothing else reachable): a device plugged into it gets an address and can do no
harm. The controller's own default profile is never restored (see README).
EOF
}

# What each verb accepts (lib/cli-gate.sh; '=' marks an option with a value).
readonly PORT_OPTS='--type= --target= --target-port= --mode= --zone= --native= --tagged= --description='
readonly CLI_SPEC="
add-controller: --vendor= --ip= --managed=
remove-controller:
add-switch: --vendor= --ip= --managed= --controller= --model= --location= --description=
remove-switch:
add-port: ${PORT_OPTS}
update-port: ${PORT_OPTS} --park --park-zone=
remove-port: --park-zone=
lag: --ports= --apply --json
list: --json
list-ports: --json
show:
interrogate: --park-zone= --no-park
update-desired:
delta:
apply:
confirm:
reconcile: --apply --park-zone=
"

# ── State files ──────────────────────────────────────────────────────

ensure_files() {
    local f
    for f in "${ACTUAL}" "${DESIRED}"; do
        if [[ ! -f "${f}" ]]; then
            jq -n '{"$schema":"switch-configuration-schema.json","version":"2.0","controllers":{},"switches":{},"accessPoints":{}}' > "${f}"
        fi
    done
}

# Atomic jq update of actual: jq_actual '<filter>' [args...]
jq_actual() {
    local filter="$1"; shift
    local tmp; tmp="$(mktemp)"
    if jq "$@" "${filter}" "${ACTUAL}" > "${tmp}"; then mv "${tmp}" "${ACTUAL}"
    else rm -f "${tmp}"; die "Failed to update ${ACTUAL}"; fi
}

# Which port each LAG member follows (#854), as a jq def over one switch.
# UniFi takes an aggregate's VLANs from its lead port; a member's own port
# config is ignored while the aggregate stands, so it has no drift of its own.
# A port declared in a LAG follows the lowest-numbered port of that LAG (as
# `lag set` documents); an unrecorded port the switch reports inside an
# aggregate follows the port that lists it in its live members. A recorded
# port outside any declared LAG follows nothing: if the switch still has it in
# an aggregate, the next apply takes that aggregate apart.
readonly LAG_LEADS_JQ='
    def lag_leads:
        if .ports == null then . else
        .ports as $ps
        | ([ $ps | to_entries[] | select((.value.lag // "") != "") | {lag: .value.lag, k: .key} ]
           | group_by(.lag) | map(map(.k) | sort_by(tonumber)) | map(select(length > 1))) as $decl
        | ([ $ps | to_entries[] | select(((.value.lagMembers // []) | length) > 1)
             | .key as $l | .value.lagMembers[] | tostring | select(. != $l) | {k: ., lead: $l} ]) as $live
        | .ports = ($ps | with_entries(
            .key as $k
            | (if (.value.lag // "") != "" then ([ $decl[] | select(index($k) != null) | .[0] ][0] // null)
               elif (.value.type // null) == null and (.value.parked // false) != true then ([ $live[] | select(.k == $k) | .lead ][0] // null)
               else null end) as $lead
            | if $lead != null and $lead != $k then .value.lagLead = $lead else .value |= del(.lagLead) end))
        end;'

# Record each member's lead in actual (interrogate, lag set/remove).
mark_lag_leads() { jq_actual "${LAG_LEADS_JQ}"' .switches |= map_values(lag_leads)'; }

# Active VLAN tags as a JSON array of ints (the trunk set for node uplinks).
active_vlans_json() {
    vmnet_all_active_tags "${ZONES_FILE}" | tr ';' '\n' | sed '/^$/d' | jq -R 'tonumber' | jq -s 'sort'
}

# ── Controller inventory ─────────────────────────────────────────────

cmd_add_controller() {
    local name="$1"; shift || true
    [[ -n "${name}" ]] || die "add-controller requires a <name>"
    local vendor="" ip="" managed="auto"
    while [[ $# -gt 0 ]]; do case "$1" in
        --vendor) vendor="$2"; shift 2 ;;
        --ip) ip="$2"; shift 2 ;;
        --managed) managed="$2"; shift 2 ;;
        *) die "add-controller: unknown option '$1'" ;;
    esac; done
    [[ -n "${vendor}" ]] || die "add-controller requires --vendor"
    [[ -n "${ip}" ]] || die "add-controller requires --ip"
    jq -e --arg n "${name}" '.controllers | has($n)' "${ACTUAL}" >/dev/null \
        && die "Controller '${name}' already exists"
    jq_actual '.controllers[$n] = {vendor:$v, managementIp:$ip, managed:$mg}' \
        --arg n "${name}" --arg v "${vendor}" --arg ip "${ip}" --arg mg "${managed}"
    info "${GN}✓${CL} added controller '${name}' (${vendor}, ${ip})"
    info "  run 'switch-manager interrogate' to upload its switches + ports"
}

cmd_remove_controller() {
    local name="$1"
    [[ -n "${name}" ]] || die "remove-controller requires a <name>"
    jq -e --arg n "${name}" '.controllers | has($n)' "${ACTUAL}" >/dev/null \
        || die "Controller '${name}' not found"
    jq_actual 'del(.controllers[$n])' --arg n "${name}"
    info "${GN}✓${CL} removed controller '${name}'"
}

# ── Switch inventory ─────────────────────────────────────────────────

cmd_add_switch() {
    local name="$1"; shift || true
    [[ -n "${name}" ]] || die "add-switch requires a <name>"
    local vendor="" ip="" model="" location="" description="" managed="" controller=""
    while [[ $# -gt 0 ]]; do case "$1" in
        --vendor) vendor="$2"; shift 2 ;;
        --ip) ip="$2"; shift 2 ;;
        --managed) managed="$2"; shift 2 ;;
        --controller) controller="$2"; shift 2 ;;
        --model) model="$2"; shift 2 ;;
        --location) location="$2"; shift 2 ;;
        --description) description="$2"; shift 2 ;;
        *) die "add-switch: unknown option '$1'" ;;
    esac; done
    [[ -n "${vendor}" ]] || die "add-switch requires --vendor"
    [[ -n "${managed}" ]] || die "add-switch requires --managed (auto|manual)"
    [[ "${managed}" == "auto" || "${managed}" == "manual" ]] || die "add-switch: --managed must be 'auto' or 'manual'"
    [[ -z "${controller}" ]] || jq -e --arg c "${controller}" '.controllers | has($c)' "${ACTUAL}" >/dev/null \
        || die "controller '${controller}' not found (add-controller first)"
    jq -e --arg n "${name}" '.switches | has($n)' "${ACTUAL}" >/dev/null \
        && die "Switch '${name}' already exists (remove-switch first to recreate)"
    jq_actual '.switches[$n] = {vendor:$v, managed:$mg, controller:(if $c=="" then null else $c end), managementIp:$ip, model:$m, location:$loc, description:$d, ports:{}}' \
        --arg n "${name}" --arg v "${vendor}" --arg mg "${managed}" --arg c "${controller}" \
        --arg ip "${ip}" --arg m "${model}" --arg loc "${location}" --arg d "${description}"
    info "${GN}✓${CL} added switch '${name}' (${vendor}, ${managed}${controller:+, controller=${controller}}${ip:+, ${ip}})"
    if [[ "${managed}" == "manual" ]]; then
        info "  add its uplink ports:  switch-manager add-port ${name} <port> --type node --target tappaasN --target-port ethX"
    elif [[ -z "${controller}" ]]; then
        info "  run 'switch-manager interrogate' to upload its ports"
    fi
    return 0
}

cmd_remove_switch() {
    local name="$1"
    [[ -n "${name}" ]] || die "remove-switch requires a <name>"
    jq -e --arg n "${name}" '.switches | has($n)' "${ACTUAL}" >/dev/null || die "Switch '${name}' not found"
    jq_actual 'del(.switches[$n])' --arg n "${name}"
    info "${GN}✓${CL} removed switch '${name}'"
}

# ── Port inventory (add/update/remove) ───────────────────────────────

_port_set() { # _port_set <add|update> <switch> <port> [flags...]
    local op="$1" sw="$2" port="$3"; shift 3 2>/dev/null || die "${op}-port requires <switch> <port>"
    [[ -n "${sw}" && -n "${port}" ]] || die "${op}-port requires <switch> <port>"
    jq -e --arg n "${sw}" '.switches | has($n)' "${ACTUAL}" >/dev/null || die "Switch '${sw}' not found"
    local exists registered
    exists=$(jq -r --arg n "${sw}" --arg p "${port}" '.switches[$n].ports | has($p)' "${ACTUAL}")
    # A port interrogate found but nobody registered, or a parked one (#853),
    # may be given a type by add-port as well as by update-port.
    registered=$(jq -r --arg n "${sw}" --arg p "${port}" '.switches[$n].ports[$p].type // null | . != null' "${ACTUAL}")
    if [[ "${op}" == "add" && "${registered}" == "true" ]]; then die "Port '${port}' already on '${sw}' (use update-port)"; fi

    local type="" target="" target_port="" mode="" zone="" native="" tagged="" description="" park=0
    while [[ $# -gt 0 ]]; do case "$1" in
        --park) park=1; shift ;;
        --type) type="$2"; shift 2 ;;
        --target) target="$2"; shift 2 ;;
        --target-port) target_port="$2"; shift 2 ;;
        --mode) mode="$2"; shift 2 ;;
        --zone) zone="$2"; shift 2 ;;
        --native) native="$2"; shift 2 ;;
        --tagged) tagged="$2"; shift 2 ;;
        --description) description="$2"; shift 2 ;;
        *) die "${op}-port: unknown option '$1'" ;;
    esac; done
    if [[ "${park}" == 1 ]]; then
        [[ "${op}" == "update" ]] || die "--park is for update-port"
        [[ -z "${type}${target}${target_port}${mode}${zone}${native}${tagged}${description}" ]] \
            || die "update-port --park takes no other port flag (--park-zone names the zone)"
        park_port "${sw}" "${port}"
        return
    fi
    if [[ "${op}" == "update" && "${exists}" != "true" ]]; then die "Port '${port}' not on '${sw}' (use add-port)"; fi
    if [[ -n "${type}" ]]; then printf '%s' "${PORT_TYPES}" | tr ' ' '\n' | grep -qxF "${type}" \
        || die "${op}-port: --type must be one of: ${PORT_TYPES}"; fi
    [[ "${op}" == "add" && -z "${type}" ]] && die "add-port requires --type (${PORT_TYPES})"

    # Start from the existing port (update) or a fresh object (add). Default mode
    # follows the type: trunk for node/switch/ap/uplink, access for device.
    local cur upd
    cur=$(jq -c --arg n "${sw}" --arg p "${port}" '.switches[$n].ports[$p] // {}' "${ACTUAL}")
    upd="${cur}"
    # A parked port given a type is in use: it is no longer parked, and the park
    # zone is not its zone.
    [[ -n "${type}" ]] && upd=$(jq -c 'if .parked == true then del(.parked, .zone) else . end' <<<"${upd}")
    [[ -n "${type}" ]]        && upd=$(jq -c --arg v "${type}" '.type=$v' <<<"${upd}")
    [[ -n "${target}" ]]      && upd=$(jq -c --arg v "${target}" '.target=$v' <<<"${upd}")
    [[ -n "${target_port}" ]] && upd=$(jq -c --arg v "${target_port}" '.targetPort=$v' <<<"${upd}")
    [[ -n "${zone}" ]]        && upd=$(jq -c --arg v "${zone}" '.zone=$v' <<<"${upd}")
    [[ -n "${description}" ]] && upd=$(jq -c --arg v "${description}" '.description=$v' <<<"${upd}")
    [[ -n "${native}" ]]      && upd=$(jq -c --argjson v "${native}" '.nativeVlan=$v' <<<"${upd}")
    if [[ -n "${tagged}" ]]; then
        local tj; tj=$(echo "${tagged}" | tr ',;' '\n' | sed '/^$/d' | jq -R 'tonumber' | jq -s 'sort')
        upd=$(jq -c --argjson v "${tj}" '.taggedVlans=$v' <<<"${upd}")
    fi
    # Set mode: explicit flag wins; else derive from the (possibly new) type.
    local efftype; efftype=$(jq -r '.type // ""' <<<"${upd}")
    if [[ -n "${mode}" ]]; then upd=$(jq -c --arg v "${mode}" '.mode=$v' <<<"${upd}")
    elif [[ -z "$(jq -r '.mode // ""' <<<"${upd}")" && -n "${efftype}" ]]; then
        if _is_trunk_type "${efftype}"; then upd=$(jq -c '.mode="trunk"' <<<"${upd}")
        else upd=$(jq -c '.mode="access"' <<<"${upd}"); fi
    fi
    jq_actual '.switches[$n].ports[$p] = $port' --arg n "${sw}" --arg p "${port}" --argjson port "${upd}"
    info "${GN}✓${CL} ${sw} port ${port}: $(jq -c . <<<"${upd}")"
}

cmd_add_port()    { _port_set add "$@"; }
cmd_update_port() { _port_set update "$@"; }

# remove-port: the port goes back to parked (#853) — on the switch first, then
# in its record. Dropping the record alone left the switch as TAPPaaS last set
# it (a native VLAN included), and no verb took that back.
cmd_remove_port() {
    local sw="$1" port="$2"
    [[ -n "${sw}" && -n "${port}" ]] || die "remove-port requires <switch> <port>"
    jq -e --arg n "${sw}" --arg p "${port}" '.switches[$n].ports | has($p)' "${ACTUAL}" >/dev/null \
        || die "Port '${port}' not found on '${sw}'"
    park_port "${sw}" "${port}"
}

# ── Parking (#853): a port TAPPaaS does not use ──────────────────────
# A parked port is an access port in the park zone (iotLocal: tier 6, no
# internet, nothing else reachable). A device plugged into it gets an address,
# so the port is seen to work, and can do no harm. The controller's own default
# profile is never restored: on UniFi that is "All", a trunk of every network
# with the default network untagged — exactly the exposure parking removes —
# and what "default" means differs per vendor and is not a zones.json state.

# The park zone's VLAN on stdout; non-zero, saying why, when it cannot park.
park_vlan() {
    local z="${1:-${PARK_ZONE}}" v st
    if ! jq -e --arg z "${z}" 'has($z) and ($z | startswith("_") | not)' "${ZONES_FILE}" >/dev/null 2>&1; then
        error "zones.json has no zone '${z}' to park ports in — add it (network-manager) or name another: --park-zone <zone>" >&2
        return 1
    fi
    v=$(jq -r --arg z "${z}" '.[$z].vlantag // 0' "${ZONES_FILE}")
    if [[ ! "${v}" =~ ^[0-9]+$ || "${v}" -le 0 ]]; then
        error "zone '${z}' has no VLAN tag — a port cannot be parked in it; name another: --park-zone <zone>" >&2
        return 1
    fi
    st=$(jq -r --arg z "${z}" '.[$z].state // ""' "${ZONES_FILE}")
    [[ "${st}" == "Active" || "${st}" == "Mandatory" ]] \
        || warn "zone '${z}' is ${st:-without a state}: a device on a parked port gets no address until it is active" >&2
    echo "${v}"
}

# Program ONE port as parked, now: the plugin converges a desired that holds
# only this port, so no other pending change on the switch goes with it.
# rc 0 programmed, 2 printed for a manual switch, other: not programmed.
park_on_switch() {
    local sw="$1" port="$2" vlan="$3" plugin tmpd changes rc=0
    plugin=$(plugin_for_switch "${sw}")
    tmpd=$(mktemp)
    jq -n --slurpfile a "${ACTUAL}" --arg n "${sw}" --arg p "${port}" --arg z "${PARK_ZONE}" --argjson v "${vlan}" '
        {switches: {($n): (($a[0].switches[$n] | del(.ports))
            + {ports: {($p): {parked: true, zone: $z, mode: "access", nativeVlan: $v}}})}}' > "${tmpd}"
    changes=$(jq -nc --arg p "${port}" --arg z "${PARK_ZONE}" --argjson v "${vlan}" \
        '{changes: [{action: "park", port: $p, description: "port \($p): park in \($z) — an access port on VLAN \($v), nothing tagged"}]}')
    # shellcheck disable=SC1090
    ( . "${plugin}"; SWITCH_DESIRED="${tmpd}" plugin_apply "${sw}" "${changes}" ) || rc=$?
    rm -f "${tmpd}"
    if [[ "${rc}" -ne 0 && "$(basename "${plugin}")" == "manual.sh" ]]; then return 2; fi
    return "${rc}"
}

# park_port <switch> <port>: park it on the switch, then record it as parked.
# The record changes only once the switch has it (or, on a manual switch, once
# the steps are printed — the drift then shows until `confirm <switch>`).
park_port() {
    local sw="$1" port="$2" cur lag lead vlan rc=0
    jq -e --arg n "${sw}" '.switches | has($n)' "${ACTUAL}" >/dev/null || die "Switch '${sw}' not found"
    cur=$(jq -c --arg n "${sw}" --arg p "${port}" "${LAG_LEADS_JQ}"' .switches[$n] | lag_leads | .ports[$p] // {}' "${ACTUAL}")
    lag=$(jq -r '.lag // ""' <<<"${cur}")
    [[ -z "${lag}" ]] || die "${sw} port ${port} is in LAG ${lag}: take the aggregate apart first (switch-manager lag remove '${sw}' ${lag} --apply)"
    lead=$(jq -r '.lagLead // ""' <<<"${cur}")
    [[ -z "${lead}" ]] || die "${sw} port ${port} follows port ${lead} in an aggregate the switch has: take it apart on the controller first"
    vlan=$(park_vlan) || exit 1
    park_on_switch "${sw}" "${port}" "${vlan}" || rc=$?
    case "${rc}" in
        0) jq_actual '.switches[$n].ports[$p] = (($c | {link, source} | with_entries(select(.value != null)))
                + {parked: true, zone: $z, mode: "access", nativeVlan: $v, lagMembers: []})' \
               --arg n "${sw}" --arg p "${port}" --arg z "${PARK_ZONE}" --argjson v "${vlan}" --argjson c "${cur}"
           cmd_update_desired >/dev/null
           info "${GN}✓${CL} ${sw} port ${port}: parked in ${PARK_ZONE} (access, VLAN ${vlan}) — on the switch and in its record" ;;
        2) jq_actual '.switches[$n].ports[$p] = (($c | {mode, nativeVlan, taggedVlans, link, source} | with_entries(select(.value != null)))
                + {parked: true, zone: $z})' \
               --arg n "${sw}" --arg p "${port}" --arg z "${PARK_ZONE}" --argjson c "${cur}"
           cmd_update_desired >/dev/null
           info "${sw} port ${port}: recorded as parked in ${PARK_ZONE}; set it by hand as printed, then: switch-manager confirm '${sw}'" ;;
        *) die "${sw} port ${port}: not parked on the switch ($(basename "$(plugin_for_switch "${sw}")" .sh)) — its record is unchanged" ;;
    esac
}

# Interrogate's parking: on the switches just read, every port with no record
# and NO LINK is recorded parked; the next apply sets it on the switch. A port
# with a link but no record is left as the switch has it and named: on a fresh
# registration the node uplinks are such ports, and parking them would cut the
# nodes off. Also left: a disabled port, and one inside an aggregate.
park_unrecorded() {
    local names="$1" found cand vlan
    found=$(jq -c --argjson names "${names}" "${LAG_LEADS_JQ}"'
        [ .switches // {} | to_entries[] | select(.key as $k | $names | index($k)) | .key as $s
          | .value | lag_leads | .ports // {} | to_entries[]
          | select((.value.type // null) == null and (.value.parked // false) != true and (.value.disabled // false) != true
                   and (.value.lagLead // null) == null and ((.value.lagMembers // []) | length) <= 1)
          | {switch: $s, port: .key, link: (.value.link // "unknown")} ] | sort_by(.switch, (.port | tonumber))' "${ACTUAL}")
    jq -r 'group_by(.switch)[] | map(select(.link != "down")) | select(length > 0)
        | "  \(.[0].switch): port(s) \(map(.port) | join(", ")) have no record and a link (or none reported) — left as the switch has them; register (add-port) or park (update-port --park)"' <<<"${found}" \
        | while IFS= read -r l; do warn "${l}"; done
    cand=$(jq -c 'map(select(.link == "down"))' <<<"${found}")
    [[ "$(jq length <<<"${cand}")" -gt 0 ]] || return 0
    vlan=$(park_vlan) || { error "  ports with no record and no link are not parked: $(jq -r 'map("\(.switch) \(.port)") | join(", ")' <<<"${cand}")"; return 1; }
    jq_actual 'reduce $cand[] as $c (.; .switches[$c.switch].ports[$c.port] += {parked: true, zone: $z})' \
        --argjson cand "${cand}" --arg z "${PARK_ZONE}"
    jq -r --arg z "${PARK_ZONE}" --argjson v "${vlan}" 'group_by(.switch)[]
        | "  \(.[0].switch): parked port(s) \(map(.port) | join(", ")) in \($z) (VLAN \($v); no record, no link) — the next apply sets them"' <<<"${cand}" \
        | while IFS= read -r l; do info "${l}"; done
    return 0
}

# ── lag: a link aggregate (LACP) across ports of one switch (#40) ────
# Declared like the VLANs: the ports carry `lag: <name>`, update-desired gives
# the lead port its members, and the plugin forms (or takes apart) the aggregate.
# A LAG spans one switch: across two it needs MC-LAG, which this does not model.
cmd_lag() {
    local sub="${1:-}"; shift || true
    local sw="" name="" ports="" apply=0
    while [[ $# -gt 0 ]]; do case "$1" in
        --ports) ports="$2"; shift 2 ;;
        --apply) apply=1; shift ;;
        -*) die "lag ${sub}: unknown option '$1'" ;;
        *) if [[ -z "${sw}" ]]; then sw="$1"; elif [[ -z "${name}" ]]; then name="$1"; else die "lag ${sub}: unexpected '$1'"; fi; shift ;;
    esac; done
    case "${sub}" in
        list)
            if [[ "${JSON}" == 1 ]]; then
                jq --arg sw "${sw}" '[.switches // {} | to_entries[] | select($sw == "" or .key == $sw) | .key as $s
                    | [ .value.ports // {} | to_entries[] | select((.value.lag // "") != "") | {lag: .value.lag, p: .key, live: (.value.lagMembers // [])} ]
                    | group_by(.lag)[] | ([.[].live[]] | unique) as $live
                    | {switch: $s, name: .[0].lag, ports: map(.p), live: $live, formed: ($live | length > 0)}]' "${ACTUAL}"
                return 0
            fi
            jq -r --arg sw "${sw}" '.switches // {} | to_entries[] | select($sw == "" or .key == $sw) | .key as $s
                | [ .value.ports // {} | to_entries[] | select((.value.lag // "") != "") | {lag: .value.lag, p: .key, live: (.value.lagMembers // [])} ]
                | group_by(.lag)[] | "\($s)  LAG \(.[0].lag): ports \(map(.p) | join("+"))  (live: \([.[].live[]] | unique | map(tostring) | join("+") | if . == "" then "not formed" else . end))"' "${ACTUAL}"
            return 0 ;;
        set|remove) ;;
        *) die "lag: set | remove | list" ;;
    esac
    [[ -n "${sw}" && -n "${name}" ]] || die "lag ${sub} <switch> <name>"
    jq -e --arg n "${sw}" '.switches | has($n)' "${ACTUAL}" >/dev/null || die "Switch '${sw}' not found"
    if [[ "${sub}" == set ]]; then
        local pj
        pj=$(tr ',;' '\n' <<<"${ports}" | sed '/^$/d' | jq -R . | jq -sc 'unique')
        [[ "$(jq length <<<"${pj}")" -ge 2 ]] || die "lag set: --ports needs two or more ports of ${sw}"
        local bad
        bad=$(jq -r --arg n "${sw}" --argjson pj "${pj}" '[ $pj[] as $p | select((.switches[$n].ports[$p].type // null) == null) | $p ] | join(", ")' "${ACTUAL}")
        [[ -z "${bad}" ]] || die "lag set: port(s) ${bad} not registered on ${sw} — add-port <switch> <port> --type node --target <node> --target-port <nic> first"
        bad=$(jq -r --arg n "${sw}" --arg l "${name}" --argjson pj "${pj}" '[ $pj[] as $p | .switches[$n].ports[$p].lag // "" | select(. != "" and . != $l) ] | unique | join(", ")' "${ACTUAL}")
        [[ -z "${bad}" ]] || die "lag set: a port is in LAG ${bad} already — lag remove it first"
        jq_actual '.switches[$n].ports |= with_entries(
                if (.key as $k | $pj | index($k)) != null then .value.lag = $l
                elif (.value.lag // "") == $l then .value |= del(.lag) else . end)' \
            --arg n "${sw}" --arg l "${name}" --argjson pj "${pj}"
        mark_lag_leads
        info "${GN}✓${CL} ${sw}: LAG ${name} on ports $(jq -r 'join("+")' <<<"${pj}") (led by port $(jq -r 'sort_by(tonumber) | .[0]' <<<"${pj}"))"
    else
        jq -e --arg n "${sw}" --arg l "${name}" '[.switches[$n].ports[] | select(.lag == $l)] | length > 0' "${ACTUAL}" >/dev/null \
            || { info "${sw}: no LAG ${name} — nothing to remove"; [[ "${apply}" == 1 ]] || return 0; }
        jq_actual '.switches[$n].ports |= map_values(if (.lag // "") == $l then del(.lag) else . end)' --arg n "${sw}" --arg l "${name}"
        mark_lag_leads
        info "${GN}✓${CL} ${sw}: LAG ${name} removed from the declaration"
    fi
    [[ "${apply}" == 1 ]] || { info "  programs the switch at the next: switch-manager reconcile --apply  (or lag ${sub} … --apply)"; return 0; }
    apply_one "${sw}"
}

# Program ONE switch now: refresh its state, regenerate desired, push its delta
# and confirm it — the slice of reconcile --apply a LAG change needs, without
# touching other switches. Non-zero when the switch was not programmed.
apply_one() {
    local sw="$1" changes plugin rc=0
    cmd_interrogate >/dev/null || die "${sw}: could not read the switches — nothing applied"
    cmd_update_desired >/dev/null
    changes=$(compute_delta | jq -c --arg s "${sw}" '{changes: (.[$s].changes // [])}')
    if [[ "$(jq '.changes | length' <<<"${changes}")" -eq 0 ]]; then
        info "  ${GN}✓${CL} ${sw}: in sync"; return 0
    fi
    jq -r '.changes[] | "    \(.action): \(.description)"' <<<"${changes}"
    plugin=$(plugin_for_switch "${sw}")
    # shellcheck disable=SC1090
    ( . "${plugin}"; plugin_apply "${sw}" "${changes}" ) || rc=$?
    if [[ "${rc}" -ne 0 ]]; then
        error "${sw}: not programmed ($(basename "${plugin}" .sh))"; return 2
    fi
    cmd_confirm "${sw}" >/dev/null
    info "  ${GN}✓${CL} ${sw}: applied via $(basename "${plugin}" .sh)"
}

# ── list / show ──────────────────────────────────────────────────────

cmd_list() {
    if [[ "${JSON}" == 1 ]]; then
        jq '{controllers: [.controllers // {} | to_entries[] | {name: .key} + .value],
             switches: [.switches // {} | to_entries[]
                        | {name: .key} + (.value | del(.ports)) + {ports: (.value.ports // {} | length)}],
             accessPoints: (.accessPoints // {} | length)}' "${ACTUAL}"
        return 0
    fi
    local cc sc
    cc=$(jq -r '.controllers // {} | length' "${ACTUAL}")
    sc=$(jq -r '.switches // {} | length' "${ACTUAL}")
    info "${BOLD}Controllers (${cc}):${CL}"
    jq -r '.controllers // {} | to_entries[] | "  \(.key)  [\(.value.vendor)]  \(.value.managementIp)"' "${ACTUAL}"
    info "${BOLD}Switches (${sc}):${CL}"
    jq -r '.switches // {} | to_entries[] | "  \(.key)  [\(.value.vendor)]  \(.value.managed)\(if .value.controller then " via "+.value.controller else "" end)  ports=\(.value.ports|length)"' "${ACTUAL}"
    local apc; apc=$(jq -r '.accessPoints // {} | length' "${ACTUAL}")
    [[ "${apc}" -gt 0 ]] && info "${BOLD}Access points (${apc}):${CL} (manage with ap-manager)"
    return 0
}

cmd_show() {
    local name="$1"
    [[ -n "${name}" ]] || die "show requires a <name>"
    if jq -e --arg n "${name}" '.switches | has($n)' "${ACTUAL}" >/dev/null; then
        jq --arg n "${name}" '.switches[$n]' "${ACTUAL}"
    elif jq -e --arg n "${name}" '.controllers | has($n)' "${ACTUAL}" >/dev/null; then
        jq --arg n "${name}" '.controllers[$n]' "${ACTUAL}"
    else
        die "No controller or switch named '${name}'"
    fi
}

# ── list-ports: one line per port, actual config + drift vs desired ──
# Read-only: computes the desired VLANs on the fly (same rules as update-desired)
# from actual's topology + zones, so it never writes files and is always current.
cmd_list_ports() {
    local target="${1:-}" active sw
    [[ -z "${target}" ]] || jq -e --arg n "${target}" '.switches | has($n)' "${ACTUAL}" >/dev/null \
        || die "Switch '${target}' not found"
    active=$(active_vlans_json)
    # One view per port — what it is, what it carries, what zones.json wants on it
    # and the drift between the two — rendered as text or (--json) as is.
    # A LAG member that follows its lead (#854) shows the lead's VLANs and what
    # zones.json wants on the lead, and no drift of its own: the lead's drift is
    # reported once, on the lead.
    local view="${LAG_LEADS_JQ}"'
        def port_view($ports; $active; $zones):
            .key as $k | .value as $p
            | ($p.lagLead // null) as $lead
            | (if $lead != null then ($ports[$lead] // $p) else $p end) as $src
            | ($src.type // "") as $t
            | ($src.taggedVlans // []) as $atag
            | ($src.nativeVlan // 0) as $anat
            | (if ($t=="node" or $t=="switch" or $t=="uplink" or $t=="ap") then {mode:"trunk", tagged:$active, nat:0}
               elif $t=="device" or ($src.parked // false) == true then {mode:"access", tagged:[],
                     nat:(($src.zone // "") as $zn | if ($zn!="" and ($zones[$zn].vlantag!=null)) then $zones[$zn].vlantag else $anat end)}
               else null end) as $d
            | (if $d==null or $d.mode!="trunk" or $lead != null then [] else $d.tagged - $atag end) as $add
            | (if $d==null or $d.mode!="trunk" or $lead != null then [] else $atag - $d.tagged end) as $rem
            | {port: $k, type: (($p.type // "") | if .=="" then null else . end), target: ($p.target // null),
               targetPort: ($p.targetPort // null), zone: ($p.zone // null), description: ($p.description // null),
               mode: ($src.mode // "?"), nativeVlan: $anat, taggedVlans: $atag,
               desired: (if $d==null then null else {mode: $d.mode, nativeVlan: $d.nat, taggedVlans: $d.tagged} end),
               drift: (if $d==null then "unmanaged"
                       elif $lead != null then "in-sync"
                       elif (($add|length)>0 or ($rem|length)>0 or ($d.mode=="access" and ($d.nat != $anat or ($src.mode // "access") != "access"))) then "drift"
                       else "in-sync" end),
               add: $add, remove: $rem, lag: ($p.lag // null), lagMembers: ($p.lagMembers // []), lagLead: $lead,
               parked: (($p.parked // false) == true), link: ($p.link // null), disabled: (($p.disabled // false) == true)};
        def ports_of($sw; $active; $zones):
            (.switches[$sw] | lag_leads | .ports // {}) as $ports
            | $ports | to_entries | sort_by(.key|tonumber) | .[] | port_view($ports; $active; $zones);'
    if [[ "${JSON}" == 1 ]]; then
        jq --argjson active "${active}" --slurpfile z "${ZONES_FILE}" --arg sw "${target}" "${view}"'
            [.switches // {} | keys[] | select($sw == "" or . == $sw)] as $names
            | [$names[] as $n | {switch: $n, lastRead: (.switches[$n].lastRead // null), ports: [ports_of($n; $active; $z[0])]}]' "${ACTUAL}"
        return 0
    fi
    while IFS= read -r sw; do
        [[ -z "${sw}" ]] && continue
        info "${BOLD}${sw}${CL} — actual port config (drift vs zones.json):"
        jq -r --argjson active "${active}" --slurpfile z "${ZONES_FILE}" --arg sw "${sw}" "${view}"'
            ports_of($sw; $active; $z[0])
            | (if .lagLead != null then "follows port \(.lagLead)"
               elif .drift=="unmanaged" then "untouched (unmanaged\(if .disabled then ", disabled" elif .link then ", link \(.link)" else "" end))"
               elif .drift=="in-sync" then "in sync"
               elif .desired.mode=="trunk" then "DRIFT +\(.add|join(",")) -\(.remove|join(","))"
               elif .mode!="access" then "DRIFT \(.mode) native \(.nativeVlan) -> access vlan \(.desired.nativeVlan)"
               else "DRIFT native \(.nativeVlan) -> \(.desired.nativeVlan)" end) as $status
            | "  port \(.port): "
              + (if .parked then "parked (\(.zone // "?"))" elif .type==null then "—" else "\(.type) → \(.target // "?")\(if .targetPort then "/"+.targetPort else "" end)" end)
              + "  | actual: \(.mode) "
              + (if .mode=="access" then "vlan \(.nativeVlan)" else (if (.taggedVlans|length)>0 then (.taggedVlans|map(tostring)|join(",")) else "-" end) end)
              + "  | \($status)"
              + (if (.lag // "") != "" then "  | LAG \(.lag)" else "" end)
              + (if (.lagMembers | length) > 0 then " (live: \(.lagMembers | map(tostring) | join("+")))" else "" end)
        ' "${ACTUAL}"
    done < <(if [[ -n "${target}" ]]; then echo "${target}"; else jq -r '.switches // {} | keys[]' "${ACTUAL}"; fi)
    [[ -n "${target}" || "$(jq -r '.switches // {} | length' "${ACTUAL}")" -gt 0 ]] || info "  (no switches in inventory)"
    return 0
}

# ── Plugin selection ─────────────────────────────────────────────────

select_plugin() {
    local vendor="$1" p
    for p in "${PLUGIN_DIR}"/*.sh; do
        [[ "$(basename "$p")" == "manual.sh" ]] && continue
        # shellcheck disable=SC1090
        ( . "$p"; plugin_supports "${vendor}" ) >/dev/null 2>&1 && { echo "$p"; return 0; }
    done
    echo "${PLUGIN_DIR}/manual.sh"
}

# Plugin for an inventory switch, honouring managed:manual (always manual.sh).
plugin_for_switch() {
    local name="$1" vendor managed
    managed=$(jq -r --arg n "${name}" '.switches[$n].managed // "auto"' "${ACTUAL}")
    [[ "${managed}" == "manual" ]] && { echo "${PLUGIN_DIR}/manual.sh"; return 0; }
    vendor=$(jq -r --arg n "${name}" '.switches[$n].vendor' "${ACTUAL}")
    select_plugin "${vendor}"
}

# ── Verb 1: interrogate (controllers + auto switches -> actual) ──────
# Merges live/controller-reported port VLAN config into actual WITHOUT clobbering
# operator topology annotations (type/target/targetPort/zone) already recorded.
cmd_interrogate() {
    info "${BOLD}interrogate${CL} (controllers + auto switches → actual.json)"
    ensure_files
    local name vendor ip plugin state tmp prc failed=0 seen='[]'

    # Controllers: upload their switches + ports. The plugin's stderr is left
    # alone — it says WHY a device could not be read (#733); stdout is its answer.
    while IFS= read -r name; do
        [[ -z "${name}" ]] && continue
        vendor=$(jq -r --arg n "${name}" '.controllers[$n].vendor' "${ACTUAL}")
        ip=$(jq -r --arg n "${name}" '.controllers[$n].managementIp' "${ACTUAL}")
        plugin=$(select_plugin "${vendor}")
        # shellcheck disable=SC1090
        ( . "${plugin}"; declare -F plugin_controller_interrogate >/dev/null ) || { info "  controller ${name}: ${vendor} plugin has no controller interrogate — skipped"; continue; }
        prc=0
        # shellcheck disable=SC1090
        state=$( . "${plugin}"; plugin_controller_interrogate "${name}" "${ip}" ) || prc=$?
        if [[ "${prc}" -ne 0 ]] || ! jq -e 'type == "object"' >/dev/null 2>&1 <<< "${state}"; then
            warn "  controller ${name}: not interrogated — actual left unchanged"
            failed=$((failed + 1)); continue
        fi
        [[ "${state}" != "{}" ]] || { info "  controller ${name}: nothing uploaded"; continue; }
        tmp="$(mktemp)"
        # ACTUAL: merge each reported switch (meta + controller ref + ports, live
        # config overlaid on operator annotations); and mark each AP's wired uplink
        # switch port as an AP trunk so update-desired carries the WiFi VLANs.
        jq --arg c "${name}" --argjson st "${state}" '
            reduce ($st.switches // {} | to_entries[]) as $s (.;
              .switches[$s.key] = ((.switches[$s.key] // {}) * $s.value
                | .controller = $c | .managed = "auto"))
            | reduce ($st.aps // {} | to_entries[]) as $a (.;
                ($a.value.uplinkSwitch) as $usw | ($a.value.uplinkPort) as $up
                | if ($usw != "" and $up != "" and (.switches[$usw] != null))
                  then .switches[$usw].ports[$up] = ((.switches[$usw].ports[$up] // {}) + {type:"ap", target:$a.key, mode:"trunk"})
                  else . end )' \
            "${ACTUAL}" > "${tmp}" && mv "${tmp}" "${ACTUAL}"
        seen=$(jq -c --argjson st "${state}" '. + ($st.switches // {} | keys)' <<<"${seen}")
        # DESIRED: auto-register discovered APs into ap-manager's inventory
        # (it keeps .accessPoints in desired), preserving any operator-set SSIDs.
        if [[ "$(echo "${state}" | jq -r '.aps // {} | length')" -gt 0 ]]; then
            tmp="$(mktemp)"
            jq --argjson st "${state}" '
                reduce ($st.aps // {} | to_entries[]) as $a (.;
                  .accessPoints[$a.key] = ((.accessPoints[$a.key] // {})
                    + {vendor:$a.value.vendor, model:$a.value.model, managementIp:$a.value.managementIp,
                       uplinkSwitch:$a.value.uplinkSwitch, uplinkPort:$a.value.uplinkPort,
                       ssids: ((.accessPoints[$a.key].ssids) // {})}))' \
                "${DESIRED}" > "${tmp}" && mv "${tmp}" "${DESIRED}"
        fi
        info "  controller ${name}: uploaded $(echo "${state}" | jq -r '.switches // {} | length') switch(es), $(echo "${state}" | jq -r '.aps // {} | length') AP(s)"
    done < <(jq -r '.controllers // {} | keys[]' "${ACTUAL}")

    # Standalone auto switches (no controller, brand has a device plugin).
    while IFS= read -r name; do
        [[ -z "${name}" ]] && continue
        plugin=$(plugin_for_switch "${name}")
        [[ "$(basename "${plugin}")" == "manual.sh" ]] && continue
        ip=$(jq -r --arg n "${name}" '.switches[$n].managementIp // ""' "${ACTUAL}")
        # shellcheck disable=SC1090
        ( . "${plugin}"; declare -F plugin_interrogate >/dev/null ) || continue
        prc=0
        # shellcheck disable=SC1090
        state=$( . "${plugin}"; plugin_interrogate "${name}" "${ip}" ) || prc=$?
        if [[ "${prc}" -ne 0 ]] || ! jq -e 'type == "object"' >/dev/null 2>&1 <<< "${state}"; then
            warn "  switch ${name}: not interrogated — actual left unchanged"
            failed=$((failed + 1)); continue
        fi
        [[ "${state}" != "{}" ]] || continue
        tmp="$(mktemp)"
        jq --arg n "${name}" --argjson s "${state}" '
            .switches[$n] = ((.switches[$n] // {}) * $s)' \
            "${ACTUAL}" > "${tmp}" && mv "${tmp}" "${ACTUAL}"
        seen=$(jq -c --arg n "${name}" '. + [$n]' <<<"${seen}")
        info "  switch ${name}: uploaded $(echo "${state}" | jq -r '.ports // {} | length') port(s)"
    done < <(jq -r '.switches // {} | to_entries[] | select(.value.controller == null) | .key' "${ACTUAL}")
    mark_lag_leads
    # When each switch was last read (#860): list-ports and the switch-ports
    # gate say how old what they judge is.
    jq_actual 'reduce $seen[] as $s (.; .switches[$s].lastRead = $t)' \
        --argjson seen "${seen}" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # Ports that cannot be parked (no park zone) stay as they are: that refuses
    # the parking, not the read — reconcile still converges everything else.
    # --no-park reads only: an unrecorded port is the switch-ports gate's to name.
    if [[ "${NO_PARK}" == 1 ]]; then
        debug "  --no-park: unrecorded ports are left as the switch has them"
    else
        park_unrecorded "${seen}" || PARK_REFUSED=1
    fi
    if [[ "${failed}" -gt 0 ]]; then
        error "interrogate: ${failed} controller(s)/switch(es) could not be read"
        return 1
    fi
    return 0
}

# ── Verb 2: update-desired (regenerate desired from actual + zones) ──
cmd_update_desired() {
    info "${BOLD}update-desired${CL} (actual topology + zones.json → desired.json)"
    ensure_files
    local active; active=$(active_vlans_json)
    local tmp; tmp="$(mktemp)"
    # Base the new desired on the EXISTING desired (preserving .accessPoints, which
    # ap-manager owns, and any other keys), overriding only .controllers/.switches
    # — those we regenerate from actual's topology (.) + the active VLAN set. All
    # trunk ports (node/switch/uplink/ap) carry the full active set; UniFi auto-
    # manages AP-uplink ports as "all VLANs" anyway, so AP ports match that.
    jq --argjson active "${active}" --slurpfile z "${ZONES_FILE}" --slurpfile cur "${DESIRED}" "${LAG_LEADS_JQ}"'
        ($z[0]) as $zones
        | ($cur[0] // {}) as $des
        | $des
          + { controllers: (.controllers // {}),
              switches: ((.switches // {}) | map_values(
                lag_leads
                | . as $sw
                | $sw + { ports: (($sw.ports // {}) | map_values(
                    . as $p
                    | (.type // "") as $t
                    | if ($t=="node" or $t=="switch" or $t=="uplink" or $t=="ap") then
                        $p + {mode:"trunk", taggedVlans:$active}
                      elif ($t=="device" or (.parked // false) == true) then
                        # A parked port (#853) is an access port in its park zone.
                        ((.zone // "") as $zn
                         | $p + {mode:"access",
                                 nativeVlan: (if ($zn!="" and ($zones[$zn].vlantag != null)) then $zones[$zn].vlantag else (.nativeVlan // 0) end)})
                      else $p end
                )) }
                # A LAG (#40): its lowest port leads and lists the members;
                # every other managed port lists none. A member that follows
                # its lead (#854) has no VLAN set of its own to want.
                | ([ .ports | to_entries[] | select((.value.lag // "") != "") | {lag: .value.lag, idx: (.key | tonumber)} ]
                   | group_by(.lag) | map(map(.idx) | sort)) as $groups
                | .ports |= with_entries(
                    (.key | tonumber) as $i
                    | if (.value.type // null) == null and (.value.parked // false) != true then .
                      else .value.lagMembers = ([ $groups[] | select(.[0] == $i and length > 1) ][0] // [])
                      end
                    | if (.value.lagLead // null) != null then .value |= del(.mode, .nativeVlan, .taggedVlans) else . end)
              )) }' "${ACTUAL}" > "${tmp}" && mv "${tmp}" "${DESIRED}"
    info "  active VLAN set: $(echo "${active}" | jq -rc 'join(",")')"
    info "  desired regenerated for $(jq -r '.switches // {} | length' "${DESIRED}") switch(es)"
    return 0
}

# ── Verb 3: delta (desired vs actual, per port) ─────────────────────
compute_delta() {
    jq -n --slurpfile d "${DESIRED}" --slurpfile a "${ACTUAL}" '
      ($d[0].switches // {}) as $des
      | ($a[0].switches // {}) as $act
      | reduce ($des | keys[]) as $sw ({};
          . + {($sw): {
              changes: [
                # A member following its lead (#854) is set through the lead.
                ($des[$sw].ports // {} | to_entries[] | select((.value.lagLead // null) == null)) as $p
                | ($act[$sw].ports[$p.key]) as $ap
                | if $p.value.mode=="trunk" then
                    ((($p.value.taggedVlans // []) - (($ap.taggedVlans) // [])) as $addv
                     | (((($ap.taggedVlans) // []) - ($p.value.taggedVlans // []))) as $delv
                     | if ($addv|length)>0 or ($delv|length)>0 then
                         {action:"trunk-vlans", port:$p.key,
                          description:"port \($p.key) (\($p.value.type // "trunk") \($p.value.target // "")) trunk: +\($addv|join(",")) -\($delv|join(","))"}
                       else empty end)
                  elif $p.value.mode=="access" then
                    # A trunk that should be an access port is a change even when
                    # its native VLAN is already the one wanted.
                    (if (($p.value.nativeVlan // 0) != (($ap.nativeVlan) // 0)) or ((($ap.mode) // "access") != "access") then
                       {action:(if $p.value.parked == true then "park" else "access-vlan" end), port:$p.key,
                        description:(if $p.value.parked == true
                          then "port \($p.key) parked in \($p.value.zone // "?"): \(($ap.mode) // "?") native \(($ap.nativeVlan)//0) -> access VLAN \($p.value.nativeVlan // 0)"
                          else "port \($p.key) access VLAN \(($ap.nativeVlan)//0) -> \($p.value.nativeVlan // 0)" end)}
                     else empty end)
                  else empty end,
                  # A LAG to form or take apart (#40). Only where desired says
                  # (managed ports), against what the switch reports.
                  ( select($p.value.lagMembers != null)
                    | (($ap.lagMembers) // []) as $alag
                    | select(($p.value.lagMembers | sort) != ($alag | sort))
                    | {action:"lag", port:$p.key,
                       description: (if ($p.value.lagMembers | length) > 0
                         then "ports \($p.value.lagMembers | map(tostring) | join("+")) as one LACP aggregate (LAG \($p.value.lag // "")), led by port \($p.key)"
                         else "port \($p.key): take apart the aggregate of ports \($alag | map(tostring) | join("+"))" end)} )
              ]
          }})
    '
}

cmd_delta() {
    local delta total=0 sw n
    delta=$(compute_delta)
    info "${BOLD}delta${CL} (desired vs actual)"
    while IFS= read -r sw; do
        [[ -z "${sw}" ]] && continue
        n=$(echo "${delta}" | jq -r --arg s "${sw}" '.[$s].changes | length')
        total=$((total + n))
        if [[ "${n}" -gt 0 ]]; then
            warn "  ${sw}: ${n} change(s)"
            echo "${delta}" | jq -r --arg s "${sw}" '.[$s].changes[] | "      \(.action): \(.description)"'
        else
            info "  ${GN}✓${CL} ${sw}: in sync"
        fi
    done < <(echo "${delta}" | jq -r 'keys[]')
    [[ "$(echo "${delta}" | jq -r 'keys|length')" -eq 0 ]] && info "  (no switches in inventory)"
    DELTA_TOTAL="${total}"
    return 0
}

# ── Verb 4: apply (plugin push / manual print) ──────────────────────
APPLY_APPLIED_SWITCHES=()
APPLY_MANUAL_SWITCHES=()
cmd_apply() {
    local delta sw changes plugin rc manual=0 applied=0
    delta=$(compute_delta)
    info "${BOLD}apply${CL}"
    while IFS= read -r sw; do
        [[ -z "${sw}" ]] && continue
        changes=$(echo "${delta}" | jq -c --arg s "${sw}" '{changes: .[$s].changes}')
        [[ "$(echo "${changes}" | jq '.changes|length')" -eq 0 ]] && continue
        plugin=$(plugin_for_switch "${sw}")
        rc=0
        # shellcheck disable=SC1090
        ( . "${plugin}"; plugin_apply "${sw}" "${changes}" ) || rc=$?
        if [[ "${rc}" -eq 0 ]]; then
            info "  ${GN}✓${CL} ${sw}: applied via $(basename "${plugin}" .sh)"
            applied=$((applied+1))
            # Only a switch a plugin actually PROGRAMMED may be confirmed.
            APPLY_APPLIED_SWITCHES+=("${sw}")
        else
            manual=$((manual+1))
            APPLY_MANUAL_SWITCHES+=("${sw}")
        fi
    done < <(echo "${delta}" | jq -r 'keys[]')
    APPLY_MANUAL="${manual}"; APPLY_DONE="${applied}"
    return 0
}

# ── Verb 5: confirm (record applied VLAN config into actual) ────────
# confirm [<switch>...] — record the applied VLAN config in actual.json.
#
# actual.json is the record of what is ON THE HARDWARE. Confirming a switch whose
# VLANs a human has not yet tagged writes a FALSE record: the drift disappears
# from `delta`, and the controller reports in-sync while the physical switch is
# still on the old VLANs. So confirmation is opt-in per switch:
#   - `reconcile --apply` confirms ONLY the switches a plugin actually programmed;
#   - a MANUAL switch is confirmed by the operator running `confirm <switch>`
#     after they have tagged the VLANs by hand.
# With no arguments every switch is confirmed (the operator asserting "the
# hardware now matches"), which is the historical behaviour and stays available.
cmd_confirm() {
    local -a only=("$@")
    if [[ ${#only[@]} -gt 0 ]]; then
        info "${BOLD}confirm${CL} (record applied VLAN config for: ${only[*]})"
    else
        info "${BOLD}confirm${CL} (record applied VLAN config in actual.json)"
    fi
    ensure_files
    local tmp filter; tmp="$(mktemp)"
    # jq array of the switches to confirm; empty ⇒ all.
    filter=$(printf '%s\n' "${only[@]+"${only[@]}"}" | jq -R . | jq -s -c 'map(select(. != ""))')
    # Overlay each desired port's computed VLAN config (mode/nativeVlan/taggedVlans)
    # onto the matching actual port, preserving the actual topology annotations.
    jq --slurpfile d "${DESIRED}" --argjson only "${filter}" '
        ($d[0].switches // {}) as $des
        | .switches |= (to_entries | map(
            .key as $sw | .value as $s
            | if (($only | length) > 0 and (($only | index($sw)) == null)) then {key:$sw, value:$s}
              else
                {key:$sw, value: ($s + {ports: (($s.ports // {}) | to_entries | map(
                  .key as $pk | .value as $p
                  | {key:$pk, value: ($p + (($des[$sw].ports[$pk] // {})
                      | {mode, nativeVlan, taggedVlans, lagMembers} | with_entries(select(.value != null))))}
                ) | from_entries)})}
              end
          ) | from_entries)' "${ACTUAL}" > "${tmp}" && mv "${tmp}" "${ACTUAL}"
    info "  ${GN}✓${CL} actual.json updated to match applied desired state"
    return 0
}

# ── reconcile (interrogate → update-desired → delta → apply → confirm) ─
cmd_reconcile() {
    local apply="$1"
    DELTA_TOTAL=0; APPLY_MANUAL=0; APPLY_DONE=0
    local stale=0
    cmd_interrogate || stale=1; echo ""
    cmd_update_desired; echo ""
    cmd_delta; echo ""
    [[ "${PARK_REFUSED}" == 0 ]] || warn "switch-manager: ports with no record and no link were not parked — see interrogate above"
    # A delta against an actual that could not be refreshed is a report, not a
    # plan: applying it would program switches from stale state (#733).
    if [[ "${stale}" -eq 1 ]]; then
        error "switch-manager: not every device could be read — delta shown, nothing applied"
        return 1
    fi
    if [[ "${apply}" -eq 1 ]]; then
        APPLY_APPLIED_SWITCHES=(); APPLY_MANUAL_SWITCHES=()
        SM_AUTOCONFIRM=1 cmd_apply; echo ""   # confirm runs right after → tell manual.sh not to ask for it
        # Confirm ONLY what a plugin actually programmed. A manual switch has had
        # its VLANs PRINTED, not applied — recording those in actual.json would be
        # a false confirm: the drift would vanish from `delta` while the hardware
        # still carries the old VLANs, and the controller would report in-sync.
        # The operator runs `confirm <switch>` once they have tagged them.
        if [[ ${#APPLY_APPLIED_SWITCHES[@]} -gt 0 ]]; then
            cmd_confirm "${APPLY_APPLIED_SWITCHES[@]}"; echo ""
        fi
        if [[ "${APPLY_MANUAL:-0}" -gt 0 ]]; then
            warn "switch-manager: ${APPLY_MANUAL} manual switch(es) still need hand configuration:"
            warn "  tag the VLANs printed above on: ${APPLY_MANUAL_SWITCHES[*]}"
            warn "  then record it with: switch-manager confirm ${APPLY_MANUAL_SWITCHES[*]}"
            info "${GN}switch-manager: applied${CL} (${APPLY_DONE:-0} via plugin, ${APPLY_MANUAL:-0} awaiting manual)"
            # rc 2 = needs-manual, the five-verb provider contract. network-manager
            # (planes.ts classify()) maps it to "needs-manual" and surfaces it
            # instead of reporting a converged plane.
            return 2
        fi
        info "${GN}switch-manager: applied${CL} (${APPLY_DONE:-0} via plugin)"
        return 0
    fi
    if [[ "${DELTA_TOTAL:-0}" -gt 0 ]]; then
        warn "switch-manager: ${DELTA_TOTAL} change(s) pending. Re-run with --apply."
        return 2
    fi
    info "${GN}switch-manager: in sync${CL}"
    return 0
}

# ── Main ─────────────────────────────────────────────────────────────

main() {
    local cmd="${1:-}"
    [[ -z "${cmd}" ]] && { usage; exit 0; }
    cli_gate usage "${CLI_SPEC}" "$@"
    shift || true
    # --json (list, list-ports, lag list) and --park-zone <zone> (the verbs that
    # park, #853) may sit anywhere; the gate refuses them elsewhere.
    local -a rest=()
    local a pz=0
    for a in "$@"; do
        if [[ "${pz}" == 1 ]]; then PARK_ZONE="${a}"; pz=0
        elif [[ "${a}" == --json ]]; then JSON=1
        elif [[ "${a}" == --no-park ]]; then NO_PARK=1
        elif [[ "${a}" == --park-zone ]]; then pz=1
        elif [[ "${a}" == --park-zone=* ]]; then PARK_ZONE="${a#--park-zone=}"
        else rest+=("${a}"); fi
    done
    [[ -n "${PARK_ZONE}" ]] || die "--park-zone needs a zone"
    set -- ${rest[@]+"${rest[@]}"}
    [[ -f "${ZONES_FILE}" ]] || die "zones.json not found: ${ZONES_FILE}"
    ensure_files
    # One vendor login per run, shared by every device's plugin subshell (#733).
    UNIFI_SESSION="$(mktemp -d)"
    export UNIFI_SESSION
    trap 'rm -rf "${UNIFI_SESSION}"' EXIT

    case "${cmd}" in
        add-controller)    cmd_add_controller "$@" ;;
        remove-controller) cmd_remove_controller "${1:-}" ;;
        add-switch)        cmd_add_switch "$@" ;;
        remove-switch)     cmd_remove_switch "${1:-}" ;;
        add-port)          cmd_add_port "$@" ;;
        update-port)       cmd_update_port "$@" ;;
        remove-port)       cmd_remove_port "${1:-}" "${2:-}" ;;
        lag)               cmd_lag "$@" ;;
        list)              cmd_list ;;
        list-ports|--list-ports) cmd_list_ports "${1:-}" ;;
        show)              cmd_show "${1:-}" ;;
        interrogate)       cmd_interrogate; [[ "${PARK_REFUSED}" == 0 ]] || exit 1 ;;
        update-desired)    cmd_update_desired ;;
        delta)             cmd_delta ;;
        apply)             cmd_apply ;;
        confirm)           cmd_confirm "$@" ;;
        reconcile)
            local apply=0
            [[ "${1:-}" == "--apply" ]] && apply=1
            cmd_reconcile "${apply}"
            ;;
        *) die "Unknown command: ${cmd} (try --help)" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
