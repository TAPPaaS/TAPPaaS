#!/usr/bin/env bash
#
# ap-manager — TAPPaaS WiFi access-point network provider (ADR-008, #339)
#
# Owns the site's WiFi networks: each SSID is site-wide (desired `.ssids`),
# bridged to one zone (whose `SSID` field names it) and broadcast by every access
# point on that zone's VLAN, without manual controller edits (#889). It is the
# `ap-manager` provider in the ADR-008 orchestrator model and implements the same
# five-verb contract as switch-manager:
#
#   update-desired  .ssids + zones.json → each AP's SSIDs (VLAN from the zone)
#   interrogate     live AP/controller state → actual (via its controller)
#   delta           desired vs actual per AP (SSID add/remove/vlan/settings, a
#                   changed passphrase) + zone/SSID/uplink validations
#   apply           push via the vendor controller, or print manual steps
#   confirm         record applied state in actual; clear the passphrase marks
#   reconcile       = the five verbs in order (apply only with --apply)
#
# AP inventory (.accessPoints) and the SSIDs (.ssids) live in the SAME files
# switch-manager uses (switch-configuration-{desired,actual}.json). Vendor
# automation is a controller (ADR-035 D4) answering the ap/1 verbs; manual is
# the fallback.
#
# Usage: see `ap-manager --help`.
#

set -euo pipefail

# shellcheck source=../../tappaas-cicd/scripts/common-install-routines.sh disable=SC1091
. /home/tappaas/bin/common-install-routines.sh
# shellcheck source=../../cluster/lib/vm-net.sh disable=SC1091
. /home/tappaas/TAPPaaS/src/foundation/cluster/lib/vm-net.sh

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
readonly SCRIPT_DIR
# shellcheck source=../../lib/cli-gate.sh
. "${SCRIPT_DIR}/../../lib/cli-gate.sh"
# is_placeholder, wlan_zones, the per-AP SSID ceiling — shared with setup-wlan-secrets.sh (#734).
# shellcheck source=../../lib/wlan-lib.sh
. "${SCRIPT_DIR}/../../lib/wlan-lib.sh"
# The controllers: the registry's, plus (tests) every PLUGIN_DIR/*.sh.
# shellcheck source=../../lib/controller-lib.sh
. "${SCRIPT_DIR}/../../lib/controller-lib.sh"
# An AP's location is one of the site's (ADR-036 D2).
# shellcheck source=../../lib/locations.sh
. "${SCRIPT_DIR}/../../lib/locations.sh"
readonly ZONES_FILE="${CONFIG_DIR}/zones.json"
readonly DESIRED="${CONFIG_DIR}/switch-configuration-desired.json"
readonly ACTUAL="${CONFIG_DIR}/switch-configuration-actual.json"

# ── Usage ────────────────────────────────────────────────────────────

usage() {
    cat <<'EOF'
Usage: ap-manager <command> [args]

Inventory:
  add <name> --vendor <v> [--ip <ip>] [--model <m>] [--location <name>] [--description <d>]
  modify <name> [--location <name>] [--description <d>] [--model <m>] [--ip <ip>]
        [--unset location,description]
                          --location is one of the site's locations
                          (site-manager location list); absent, the primary one
  remove <name>
  list [--json]
  show <name>
  validate                every access point's location is one of the site's

SSIDs (site-wide: every access point broadcasts each one, on its zone's VLAN):
  ssid add <ssid> --zone <zone> --security <sec> [--radius <srv>] [--captive] [--disabled]
        [--broadcast-on all|<ap>,<ap>...]
                          also sets the zone's SSID (one SSID per zone)
  ssid modify <ssid> [--zone <zone>] [--security <sec>] [--radius <srv>] [--unset radius]
        [--captive|--no-captive] [--disabled|--enabled] [--broadcast-on all|<ap>,...]
  ssid remove <ssid>      the SSID, the zone's SSID and its passphrase go
  ssid list [--json]      zone, VLAN, security, access points, passphrase set or not
  ssid set-passphrase <ssid> [--file <path>]
                          the WPA passphrase from stdin or the file's first line,
                          never an argument; reconcile --apply pushes it
  ssid <ap> add|remove|list ...   the old per-AP forms, kept for this release

  link <ap> --switch <switch> --port <port>     associate AP uplink to a switch port

Reconciliation (five-verb provider contract):
  update-desired          zones.json -> SSID vlan tracking
  interrogate             live APs -> actual.json (via its controller)
  delta                   show desired-vs-actual + zone/SSID/uplink validations
  apply                   push delta via the controller (manual prints steps)
  confirm                 record applied state in actual.json
  reconcile [--apply]     run all five in order (apply only with --apply)

security: open | wpa2-personal | wpa3-personal | wpa2-enterprise | wpa3-enterprise
EOF
}

# What each verb accepts (lib/cli-gate.sh; '=' marks an option with a value).
readonly CLI_SPEC='
add: --vendor= --ip= --model= --location= --description=
modify: --location= --description= --model= --ip= --unset=
validate:
remove:
list: --json
show:
link: --switch= --port=
ssid add: --zone= --security= --radius= --captive --disabled --broadcast-on=
ssid modify: --zone= --security= --radius= --unset= --captive --no-captive --disabled --enabled --broadcast-on=
ssid remove:
ssid list: --json
ssid set-passphrase: --file=
ssid * add: --zone= --security= --vlan= --radius= --captive --disabled
ssid * remove:
ssid * list:
update-desired:
interrogate:
delta:
apply:
confirm:
reconcile: --apply
'

# ── State files ──────────────────────────────────────────────────────

ensure_files() {
    local f
    for f in "${DESIRED}" "${ACTUAL}"; do
        if [[ ! -f "${f}" ]]; then
            jq -n '{"$schema":"switch-configuration-schema.json","version":"1.0","switches":{},"accessPoints":{},"ssids":{},"wifiController":{}}' > "${f}"
        fi
    done
}

jq_desired() {
    local filter="$1"; shift
    local tmp; tmp="$(mktemp)"
    if jq "$@" "${filter}" "${DESIRED}" > "${tmp}"; then
        mv "${tmp}" "${DESIRED}"
    else
        rm -f "${tmp}"; die "Failed to update ${DESIRED}"
    fi
}

# ── Inventory commands ───────────────────────────────────────────────

cmd_add() {
    local name="$1"; shift
    [[ -n "${name}" ]] || die "add requires a <name>"
    local vendor="" ip="" model="" location="" description="" why
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --vendor) vendor="$2"; shift 2 ;;
            --ip) ip="$2"; shift 2 ;;
            --model) model="$2"; shift 2 ;;
            --location) location="$2"; shift 2 ;;
            --description) description="$2"; shift 2 ;;
            *) die "add: unknown option '$1'" ;;
        esac
    done
    [[ -n "${vendor}" ]] || die "add requires --vendor"
    if jq -e --arg n "${name}" '.accessPoints | has($n)' "${DESIRED}" >/dev/null; then
        die "AP '${name}' already exists"
    fi
    if [[ -n "${location}" ]] && ! why="$(site_location_refusal "${location}")"; then die "add --location: ${why}"; fi
    jq_desired '.accessPoints[$n] = ({vendor:$v, model:$m, managementIp:$ip, ssids:{}}
                + (if $loc == "" then {} else {location:$loc} end) + (if $d == "" then {} else {description:$d} end))' \
        --arg n "${name}" --arg v "${vendor}" --arg m "${model}" --arg ip "${ip}" --arg loc "${location}" --arg d "${description}"
    derive_ap_ssids
    info "${GN}✓${CL} added AP '${name}' (${vendor}${location:+, at ${location}})$(jq -r --arg n "${name}" '.accessPoints[$n].ssids | keys | if length > 0 then ", broadcasting " + join(", ") else "" end' "${DESIRED}")"
}

# modify <name> [--location <n>] [--description <d>] [--model <m>] [--ip <ip>]
# [--unset location,description]: the AP's own record in desired.
cmd_modify() {
    local name="${1:-}"; shift || true
    [[ -n "${name}" ]] || die "modify requires a <name>"
    jq -e --arg n "${name}" '.accessPoints | has($n)' "${DESIRED}" >/dev/null || die "AP '${name}' not found"
    local set='{}' unset='[]' f why
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --location)
                why="$(site_location_refusal "$2")" || die "modify --location: ${why}"
                set=$(jq -c --arg v "$2" '.location=$v' <<<"${set}"); shift 2 ;;
            --description) set=$(jq -c --arg v "$2" '.description=$v' <<<"${set}"); shift 2 ;;
            --model) set=$(jq -c --arg v "$2" '.model=$v' <<<"${set}"); shift 2 ;;
            --ip) set=$(jq -c --arg v "$2" '.managementIp=$v' <<<"${set}"); shift 2 ;;
            --unset)
                for f in ${2//,/ }; do
                    [[ "${f}" == location || "${f}" == description ]] || die "modify --unset: only location and description (got '${f}')"
                    unset=$(jq -c --arg f "${f}" '. + [$f]' <<<"${unset}")
                done
                shift 2 ;;
            *) die "modify: unknown option '$1'" ;;
        esac
    done
    [[ "${set}" != '{}' || "${unset}" != '[]' ]] || die "modify: nothing to change (--location, --description, --model, --ip, --unset)"
    jq_desired '.accessPoints[$n] |= ((. + $set) | delpaths([$unset[] | [.]]))' \
        --arg n "${name}" --argjson set "${set}" --argjson unset "${unset}"
    info "${GN}✓${CL} AP '${name}': $(jq -r '[to_entries[] | "\(.key)=\(.value)"] | join(", ")' <<<"${set}")$(jq -r 'if length > 0 then " unset " + join(",") else "" end' <<<"${unset}")"
}

# validate: every AP's location names one of the site's locations (ADR-036
# D2); free text is reported with the command that fixes it (migration 0021
# moves it into the description).
cmd_validate() {
    local errs=0 name loc why
    while IFS=$'\t' read -r name loc; do
        [[ -n "${loc}" ]] || continue
        why="$(site_location_refusal "${loc}")" && continue
        errs=$((errs + 1))
        error "access point '${name}': location '${loc}': ${why} — ap-manager modify '${name}' --location <name> --description '${loc}'"
    done < <(jq -r '.accessPoints // {} | to_entries[] | [.key, (.value.location // "")] | @tsv' "${DESIRED}")
    if [[ "${errs}" -gt 0 ]]; then
        error "validate: ${errs} location(s) name no location of the site"
        return 1
    fi
    info "${GN}validate ok${CL} ($(jq -r '.accessPoints // {} | length' "${DESIRED}") access point(s))"
    return 0
}

cmd_remove() {
    local name="$1"
    [[ -n "${name}" ]] || die "remove requires a <name>"
    jq -e --arg n "${name}" '.accessPoints | has($n)' "${DESIRED}" >/dev/null \
        || die "AP '${name}' not found"
    # An SSID broadcast on a list of APs loses this one; one left on none says so.
    jq_desired 'del(.accessPoints[$n])
        | if has("ssids") then .ssids |= map_values(if (.broadcastOn | type) == "array" then .broadcastOn -= [$n] else . end) else . end' --arg n "${name}"
    info "${GN}✓${CL} removed AP '${name}'"
    jq -r '.ssids // {} | to_entries[] | select(.value.broadcastOn == []) | .key' "${DESIRED}" | while IFS= read -r s; do
        warn "  SSID '${s}' is now broadcast by no access point: ap-manager ssid modify '${s}' --broadcast-on all"
    done
}

cmd_list() {
    if [[ "${1:-}" == --json ]]; then
        jq '[.accessPoints // {} | to_entries[] | {name: .key} + (.value | del(.ssids, .uplinkSwitch, .uplinkPort))
             + {uplink: (if .value.uplinkSwitch then {switch: .value.uplinkSwitch, port: .value.uplinkPort} else null end),
                ssids: [.value.ssids // {} | to_entries[] | {name: .key} + .value]}]' "${DESIRED}"
        return 0
    fi
    local count
    count=$(jq -r '.accessPoints // {} | length' "${DESIRED}")
    info "${BOLD}Access points (${count}):${CL}"
    jq -r '.accessPoints // {} | to_entries[] | "  \(.key)  [\(.value.vendor)]  \(.value.managementIp // "-")  ssids=\(.value.ssids|length)  uplink=\(.value.uplinkSwitch // "-"):\(.value.uplinkPort // "-")\(if (.value.location // "") != "" then "  at " + .value.location else "" end)"' "${DESIRED}"
    return 0
}

cmd_show() {
    local name="$1"
    [[ -n "${name}" ]] || die "show requires a <name>"
    jq -e --arg n "${name}" '.accessPoints | has($n)' "${DESIRED}" >/dev/null \
        || die "AP '${name}' not found"
    jq --arg n "${name}" '.accessPoints[$n]' "${DESIRED}"
}

cmd_link() {
    local ap="$1"; shift
    [[ -n "${ap}" ]] || die "link requires an <ap>"
    jq -e --arg n "${ap}" '.accessPoints | has($n)' "${DESIRED}" >/dev/null \
        || die "AP '${ap}' not found"
    local switch="" port=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --switch) switch="$2"; shift 2 ;;
            --port) port="$2"; shift 2 ;;
            *) die "link: unknown option '$1'" ;;
        esac
    done
    [[ -n "${switch}" && -n "${port}" ]] || die "link requires --switch and --port"
    jq_desired '.accessPoints[$n].uplinkSwitch=$s | .accessPoints[$n].uplinkPort=$p' \
        --arg n "${ap}" --arg s "${switch}" --arg p "${port}"
    info "${GN}✓${CL} linked AP '${ap}' → ${switch}:${port}"
}

# ── SSIDs: site-wide networks (#889) ─────────────────────────────────
#
# An SSID is ONE site-wide network in desired `.ssids{<name>}`: the zone it
# bridges to, how clients join, and which access points broadcast it
# (`broadcastOn`: "all", the default, or a list of APs). The VLAN is the zone's.
# The zone's own `SSID` field names it; ap-manager owns that field and writes it
# through network-manager set-ssid, so zones.json keeps one writer. The
# passphrase lives only in the secrets file (wlan-lib.sh); setting one marks the
# SSID `passphraseChanged` so the next reconcile pushes it to every AP.
#
# Each AP's `ssids{}` is DERIVED from the site-wide list (derive_ap_ssids), in
# the shape the vendor controllers read: {vlan, zone, security, enabled,
# radiusServer?, captivePortal?}. It is rewritten by every change here.

readonly SECURITIES="open wpa2-personal wpa3-personal wpa2-enterprise wpa3-enterprise"
# ap-manager's writer of the zone's SSID (network-manager set-ssid).
NETWORK_MANAGER="${AP_NETWORK_MANAGER:-network-manager}"

is_personal() { [[ "$1" == wpa2-personal || "$1" == wpa3-personal ]]; }
is_enterprise() { [[ "$1" == wpa2-enterprise || "$1" == wpa3-enterprise ]]; }

ssid_entry() { jq -c --arg s "$1" '.ssids[$s] // null' "${DESIRED}"; }
zone_exists() { jq -e --arg z "$1" 'has($z) and ($z | startswith("_") | not)' "${ZONES_FILE}" >/dev/null; }
zone_ssid() { jq -r --arg z "$1" '.[$z].SSID // "" | strings' "${ZONES_FILE}"; }
ap_exists() { jq -e --arg n "$1" '.accessPoints // {} | has($n)' "${DESIRED}" >/dev/null; }

# Rewrite every AP's ssids{} from the site-wide list. The VLAN is the zone's
# vlantag (0 when the zone is missing — delta says so).
# Per-AP SSIDs and no site-wide list: a site that has not run migration 0025.
# Deriving would wipe them, so every verb that writes stops before it starts.
require_site_wide() {
    if jq -e '(has("ssids") | not) and ([.accessPoints // {} | .[] | .ssids // {} | length] | add // 0) > 0' "${DESIRED}" >/dev/null; then
        die "the access points still declare SSIDs one by one: migration 0025 folds them into the site-wide list (site-manager update runs it) — nothing changed"
    fi
}

derive_ap_ssids() {
    require_site_wide
    jq_desired '(.ssids // {}) as $ss
        | .accessPoints = ((.accessPoints // {}) | with_entries(.key as $ap | .value.ssids = (
            $ss | with_entries(
                select((.value.broadcastOn // "all") == "all" or ((.value.broadcastOn | type) == "array" and any(.value.broadcastOn[]; . == $ap)))
                | .value = ({vlan: ($z[0][.value.zone].vlantag // 0), zone: .value.zone, security: .value.security,
                             enabled: (.value.disabled != true)}
                            + (if (.value.radius // "") != "" then {radiusServer: .value.radius} else {} end)
                            + (if .value.captive == true then {captivePortal: true} else {} end))))))' \
        --slurpfile z "${ZONES_FILE}"
}

# The APs that broadcast <ssid>, one per line.
ssid_aps() {
    jq -r --arg s "$1" '.accessPoints // {} | to_entries[] | select(.value.ssids // {} | has($s)) | .key' "${DESIRED}"
}

# The passphrase state of an SSID: "not needed" (open or enterprise), "not set",
# "changed" (set, not pushed yet) or "set".
passphrase_state() {
    local s="$1" sec="$2" changed="$3"
    if ! is_personal "${sec}"; then echo "not needed"
    elif ! wlan_secret_has "${s}"; then echo "not set"
    elif [[ "${changed}" == true ]]; then echo "changed"
    else echo "set"; fi
}

# --broadcast-on all|<ap>,<ap>… → JSON ("all" or a list of existing APs).
parse_broadcast_on() {
    local v="$1" ap list='[]'
    if [[ "${v}" == all ]]; then echo '"all"'; return 0; fi
    IFS=',' read -ra aps <<<"${v}"
    for ap in "${aps[@]}"; do
        ap="${ap#"${ap%%[![:space:]]*}"}"; ap="${ap%"${ap##*[![:space:]]}"}"
        [[ -n "${ap}" ]] || continue
        ap_exists "${ap}" || die "--broadcast-on: no access point '${ap}' (ap-manager list)"
        list=$(jq -c --arg a "${ap}" 'if index([$a]) then . else . + [$a] end' <<<"${list}")
    done
    [[ "${list}" != '[]' ]] || die "--broadcast-on: 'all', or the access points by name, comma-separated"
    echo "${list}"
}

# Write <ssid>'s entry (old → new; either may be null) and keep the zone's SSID
# field and every AP's derived view in step. The zone is written first: a
# refusal there leaves the desired state as it was.
ssid_commit() {
    local s="$1" old="$2" new="$3" oldzone newzone
    oldzone=$(jq -r '.zone? // ""' <<<"${old}")
    newzone=$(jq -r '.zone? // ""' <<<"${new}")
    if [[ -n "${newzone}" && "$(zone_ssid "${newzone}")" != "${s}" ]]; then
        "${NETWORK_MANAGER}" set-ssid "${newzone}" "${s}" --zones-file "${ZONES_FILE}" \
            || die "zone '${newzone}': its SSID could not be set (network-manager set-ssid) — nothing changed"
    fi
    if [[ -n "${oldzone}" && "${oldzone}" != "${newzone}" && "$(zone_ssid "${oldzone}")" == "${s}" ]]; then
        "${NETWORK_MANAGER}" set-ssid "${oldzone}" --clear --zones-file "${ZONES_FILE}" \
            || warn "zone '${oldzone}' still names SSID '${s}': network-manager set-ssid ${oldzone} --clear"
    fi
    if [[ "${new}" == null ]]; then
        jq_desired 'del(.ssids[$s])' --arg s "${s}"
    else
        jq_desired '.ssids = ((.ssids // {}) + {($s): $o})' --arg s "${s}" --argjson o "${new}"
    fi
    derive_ap_ssids
}

# After a change: the APs over their ceiling, a UniFi AP left out of a list
# (its controller broadcasts every WLAN on all its APs for now), and the next step.
ssid_after() {
    local s="$1" e ap
    while IFS= read -r ap; do
        [[ -n "${ap}" ]] && { warn_ssid_ceiling "${ap}" || true; }
    done < <(jq -r '.accessPoints // {} | keys[]' "${DESIRED}")
    e=$(ssid_entry "${s}")
    [[ "${e}" != null ]] || return 0
    if [[ "$(jq -r '.broadcastOn // "all" | type' <<<"${e}")" == array ]]; then
        while IFS= read -r ap; do
            [[ -n "${ap}" ]] && warn "  ${ap} is a UniFi access point: the UniFi controller broadcasts '${s}' on all its access points until its plugin supports a list"
        done < <(jq -r --argjson e "${e}" '.accessPoints // {} | to_entries[] | select(.value.vendor == "unifi" and ([.key] | inside($e.broadcastOn) | not)) | .key' "${DESIRED}")
    fi
    if is_personal "$(jq -r .security <<<"${e}")" && ! wlan_secret_has "${s}"; then
        info "  next: its passphrase — ap-manager ssid set-passphrase '${s}' (from stdin or --file)"
    fi
    if [[ -z "$(ssid_aps "${s}")" && "$(jq -r '.accessPoints // {} | length' "${DESIRED}")" -eq 0 ]]; then
        info "  no access point yet: ap-manager add <name> --vendor <v>"
    fi
    info "  to program the access points: ap-manager reconcile --apply"
}

# ssid add <ssid> --zone <z> --security <sec> [--radius <r>] [--captive] [--disabled] [--broadcast-on all|<ap>,…]
ssid_add() {
    local s="${1:-}"; shift || true
    [[ -n "${s}" ]] || die "ssid add requires <ssid>"
    local why; why="$(wlan_ssid_problem "${s}")"; [[ -z "${why}" ]] || die "ssid add '${s}': ${why}"
    [[ "$(ssid_entry "${s}")" == null ]] || die "SSID '${s}' already exists — change it with: ap-manager ssid modify '${s}' …"
    local zone="" security="" radius="" captive=false disabled=false bon='"all"'
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --zone) zone="$2"; shift 2 ;;
            --security) security="$2"; shift 2 ;;
            --radius) radius="$2"; shift 2 ;;
            --captive) captive=true; shift ;;
            --disabled) disabled=true; shift ;;
            --broadcast-on) bon="$(parse_broadcast_on "$2")"; shift 2 ;;
            *) die "ssid add: unknown option '$1'" ;;
        esac
    done
    [[ -n "${zone}" ]] || die "ssid add requires --zone"
    [[ -n "${security}" ]] || die "ssid add requires --security (${SECURITIES// /, })"
    ssid_check_settings "${s}" "${zone}" "${security}" "${radius}"
    local new
    new=$(ssid_object "${zone}" "${security}" "${radius}" "${captive}" "${disabled}" "${bon}" false)
    ssid_commit "${s}" null "${new}"
    info "${GN}✓${CL} SSID '${s}' → zone ${zone} (VLAN $(jq -r --arg z "${zone}" '.[$z].vlantag // "?"' "${ZONES_FILE}")), ${security}, on $(ssid_on_text "${s}")"
    ssid_after "${s}"
}

# The site-wide entry, written the same way by add, modify and the old forms.
ssid_object() {
    jq -nc --arg z "$1" --arg sec "$2" --arg r "$3" --argjson cap "$4" --argjson dis "$5" --argjson bon "$6" --argjson ch "$7" \
        '{zone: $z, security: $sec}
         + (if $r != "" then {radius: $r} else {} end)
         + (if $cap then {captive: true} else {} end)
         + (if $dis then {disabled: true} else {} end)
         + {broadcastOn: $bon}
         + (if $ch then {passphraseChanged: true} else {} end)'
}

# Where it is broadcast, for a message.
ssid_on_text() {
    local aps; aps="$(ssid_aps "$1" | paste -sd, -)"
    if [[ "$(jq -r --arg s "$1" '.ssids[$s].broadcastOn // "all" | type' "${DESIRED}")" == string ]]; then
        echo "every access point${aps:+ (${aps//,/, })}"
    else
        echo "${aps:-no access point}"
    fi
}

# The zone exists, can carry WiFi and carries no other SSID; the security is
# one ap-manager knows; a RADIUS server goes with enterprise only.
ssid_check_settings() {
    local s="$1" zone="$2" security="$3" radius="$4" other cur
    zone_exists "${zone}" || die "zone '${zone}' not found in ${ZONES_FILE} (network-manager list)"
    [[ " ${SECURITIES} " == *" ${security} "* ]] || die "--security '${security}': one of ${SECURITIES// /, }"
    [[ -z "${radius}" ]] || is_enterprise "${security}" || die "--radius goes with wpa2-enterprise or wpa3-enterprise"
    other=$(jq -r --arg z "${zone}" --arg s "${s}" '[.ssids // {} | to_entries[] | select(.value.zone == $z and .key != $s) | .key] | first // ""' "${DESIRED}")
    [[ -z "${other}" ]] || die "zone '${zone}' already carries SSID '${other}' — one SSID per zone: ap-manager ssid remove '${other}', or ssid modify '${other}' --zone <another>"
    cur="$(zone_ssid "${zone}")"
    if [[ -n "${cur}" && "${cur}" != "${s}" ]] && ! is_placeholder "${cur}"; then
        info "  zone '${zone}' named SSID '${cur}', which no access point declared: it now names '${s}'"
    fi
    return 0
}

# ssid modify <ssid> [--zone z] [--security s] [--radius r | --unset radius]
#   [--captive | --no-captive] [--disabled | --enabled] [--broadcast-on all|<ap>,…]
ssid_modify() {
    local s="${1:-}"; shift || true
    [[ -n "${s}" ]] || die "ssid modify requires <ssid>"
    local old; old=$(ssid_entry "${s}")
    [[ "${old}" != null ]] || die "SSID '${s}' not found (ap-manager ssid list)"
    local zone security radius captive disabled bon changed=0 f
    zone=$(jq -r .zone <<<"${old}"); security=$(jq -r .security <<<"${old}"); radius=$(jq -r '.radius // ""' <<<"${old}")
    captive=$(jq -r '.captive == true' <<<"${old}"); disabled=$(jq -r '.disabled == true' <<<"${old}")
    bon=$(jq -c '.broadcastOn // "all"' <<<"${old}")
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --zone) zone="$2"; shift 2 ;;
            --security) security="$2"; shift 2 ;;
            --radius) radius="$2"; shift 2 ;;
            --captive) captive=true; shift ;;
            --no-captive) captive=false; shift ;;
            --disabled) disabled=true; shift ;;
            --enabled) disabled=false; shift ;;
            --broadcast-on) bon="$(parse_broadcast_on "$2")"; shift 2 ;;
            --unset)
                for f in ${2//,/ }; do
                    [[ "${f}" == radius ]] || die "ssid modify --unset: only radius (got '${f}')"
                    radius=""
                done
                shift 2 ;;
            *) die "ssid modify: unknown option '$1'" ;;
        esac
        changed=1
    done
    [[ "${changed}" -eq 1 ]] || die "ssid modify: nothing to change (--zone, --security, --radius, --captive, --disabled, --enabled, --broadcast-on, --unset radius)"
    is_enterprise "${security}" || radius=""
    ssid_check_settings "${s}" "${zone}" "${security}" "${radius}"
    local new
    new=$(ssid_object "${zone}" "${security}" "${radius}" "${captive}" "${disabled}" "${bon}" "$(jq -r '.passphraseChanged == true' <<<"${old}")")
    if [[ "$(jq -S . <<<"${new}")" == "$(jq -S . <<<"${old}")" ]]; then
        if [[ "$(zone_ssid "${zone}")" != "${s}" ]]; then
            ssid_commit "${s}" "${old}" "${new}"   # the zone's SSID only
            info "${GN}✓${CL} zone '${zone}' names SSID '${s}' again"
            return 0
        fi
        info "SSID '${s}': already as requested — no change"
        return 0
    fi
    ssid_commit "${s}" "${old}" "${new}"
    info "${GN}✓${CL} SSID '${s}': $(jq -r -n --argjson o "${old}" --argjson n "${new}" \
        '[($n | keys_unsorted[]) as $k | select($k != "passphraseChanged" and $o[$k] != $n[$k]) | "\($k) \($o[$k] // "-" | tostring) → \($n[$k] | tostring)"]
         + [($o | keys_unsorted[]) as $k | select($n | has($k) | not) | "\($k) removed"] | join(", ")')"
    ssid_after "${s}"
}

# ssid remove <ssid>: the network goes, the zone's SSID with it, and its passphrase.
ssid_remove() {
    local s="${1:-}"
    [[ -n "${s}" ]] || die "ssid remove requires <ssid>"
    local old; old=$(ssid_entry "${s}")
    [[ "${old}" != null ]] || die "SSID '${s}' not found (ap-manager ssid list)"
    ssid_commit "${s}" "${old}" null
    wlan_secret_del "${s}"
    info "${GN}✓${CL} removed SSID '${s}' (zone $(jq -r .zone <<<"${old}"))"
    info "  ap-manager reconcile shows it to remove on each access point that still broadcasts it"
}

# ssid list [--json]: every site-wide SSID with its zone, VLAN, security, where
# it is broadcast and whether its passphrase is set — never the passphrase.
ssid_list() {
    local json
    json=$(jq -c --slurpfile z "${ZONES_FILE}" '
        . as $d | [(.ssids // {}) | to_entries[] | .key as $s | .value as $v | {
            name: $s, zone: $v.zone, vlan: ($z[0][$v.zone].vlantag // null), security: $v.security,
            radius: ($v.radius // null), captive: ($v.captive == true), disabled: ($v.disabled == true),
            broadcastOn: ($v.broadcastOn // "all"),
            accessPoints: [$d.accessPoints // {} | to_entries[] | select(.value.ssids // {} | has($s)) | .key],
            passphraseChanged: ($v.passphraseChanged == true)}]' "${DESIRED}")
    local i n s sec ch out='[]' st
    n=$(jq 'length' <<<"${json}")
    for ((i = 0; i < n; i++)); do
        s=$(jq -r --argjson i "${i}" '.[$i].name' <<<"${json}")
        sec=$(jq -r --argjson i "${i}" '.[$i].security' <<<"${json}")
        ch=$(jq -r --argjson i "${i}" '.[$i].passphraseChanged' <<<"${json}")
        st=$(passphrase_state "${s}" "${sec}" "${ch}")
        out=$(jq -c --argjson i "${i}" --arg st "${st}" --argjson j "${json}" '. + [$j[$i] + {passphrase: $st}]' <<<"${out}")
    done
    if [[ "${1:-}" == --json ]]; then jq . <<<"${out}"; return 0; fi
    info "${BOLD}SSIDs ($(jq length <<<"${out}")):${CL}"
    jq -r '.[] | "  \(.name)  zone \(.zone) (VLAN \(.vlan // "?"))  \(.security)\(if .disabled then "  disabled" else "" end)  passphrase \(.passphrase)  on \(if .broadcastOn == "all" then "all" else (.broadcastOn | join(",")) end): \(.accessPoints | join(", ") | if . == "" then "-" else . end)"' <<<"${out}"
    return 0
}

# ssid set-passphrase <ssid> [--file <path>]: the WPA passphrase, from the file's
# first line or stdin (asked twice, hidden, at a terminal) — never an argument,
# which would land in the shell history and the process list. Stored in the
# secrets file; the SSID is marked so the next reconcile pushes it.
ssid_set_passphrase() {
    local s="${1:-}"; shift || true
    [[ -n "${s}" ]] || die "ssid set-passphrase requires <ssid> (the passphrase comes from stdin or --file)"
    local file=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --file) file="$2"; shift 2 ;;
            *) die "ssid set-passphrase: '$1' — the passphrase is never an argument: pipe it on stdin or use --file <path>" ;;
        esac
    done
    local e; e=$(ssid_entry "${s}")
    [[ "${e}" != null ]] || die "SSID '${s}' not found — declare it first: ap-manager ssid add '${s}' --zone <zone> --security wpa2-personal"
    local sec; sec=$(jq -r .security <<<"${e}")
    is_personal "${sec}" || die "SSID '${s}' is ${sec}: only wpa2-personal and wpa3-personal take a passphrase"
    local pass="" p2 why
    if [[ -n "${file}" ]]; then
        [[ -r "${file}" ]] || die "--file ${file}: not readable"
        IFS= read -r pass < "${file}" || true
    elif [[ -t 0 ]]; then
        read -rs -p "passphrase for ${s}: " pass; echo >&2
        read -rs -p "again: " p2; echo >&2
        [[ "${pass}" == "${p2}" ]] || die "the two passphrases differ — nothing stored"
    else
        IFS= read -r pass || true
    fi
    pass="${pass%$'\r'}"
    why="$(wlan_passphrase_problem "${pass}")"; [[ -z "${why}" ]] || die "SSID '${s}': ${why} — nothing stored"
    if [[ "$(wlan_secret_get "${s}")" == "${pass}" ]]; then
        info "SSID '${s}': that passphrase is already stored — no change"
        return 0
    fi
    wlan_secret_set "${s}" "${pass}"
    jq_desired '.ssids[$s].passphraseChanged = true' --arg s "${s}"
    info "${GN}✓${CL} passphrase for '${s}' stored in ${WLAN_SECRETS_FILE} (mode 600)"
    info "  ap-manager reconcile --apply pushes it to $(ssid_on_text "${s}")"
}

# ── The per-AP forms, kept for one release ────────────────────────────
#
#   ssid <ap> add <ssid> …   → ssid add (or modify, when it exists): every AP
#                              broadcasts it; --vlan must be the zone's.
#   ssid <ap> remove <ssid>  → <ap> stops broadcasting it; the SSID goes when
#                              no access point would broadcast it.
#   ssid <ap> list           → the SSIDs <ap> broadcasts, as before.
legacy_note() { echo "[Info]  'ap-manager ssid <ap> $1' is the old per-AP form, kept for this release: SSIDs are site-wide now — ap-manager ssid $1 …" >&2; }

legacy_ssid_add() {
    local ap="$1" s="${2:-}"; shift 2 2>/dev/null || die "ssid <ap> add requires <ssid>"
    local -a pass=()
    local vlan="" zone="" security="" radius="" captive=false disabled=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --vlan) vlan="$2"; shift 2 ;;
            --zone) zone="$2"; pass+=("$1" "$2"); shift 2 ;;
            --security) security="$2"; pass+=("$1" "$2"); shift 2 ;;
            --radius) radius="$2"; pass+=("$1" "$2"); shift 2 ;;
            --captive) captive=true; pass+=("$1"); shift ;;
            --disabled) disabled=true; pass+=("$1"); shift ;;
            *) die "ssid add: unknown option '$1'" ;;
        esac
    done
    [[ -n "${zone}" ]] || die "ssid add requires --zone"
    [[ -n "${security}" ]] || die "ssid add requires --security"
    if [[ -n "${vlan}" ]]; then
        local zv; zv=$(jq -r --arg z "${zone}" '.[$z].vlantag // ""' "${ZONES_FILE}")
        [[ "${vlan}" == "${zv}" ]] || die "--vlan ${vlan}: an SSID is on its zone's VLAN (zone '${zone}' is VLAN ${zv:-?}); pick the zone instead"
    fi
    local old; old=$(ssid_entry "${s}")
    if [[ "${old}" == null ]]; then
        ssid_add "${s}" "${pass[@]}"
        return 0
    fi
    # It exists: the old form replaced the entry, so its settings are the ones given.
    local -a mod=(--zone "${zone}" --security "${security}")
    if [[ -n "${radius}" ]]; then mod+=(--radius "${radius}"); else mod+=(--unset radius); fi
    if [[ "${captive}" == true ]]; then mod+=(--captive); else mod+=(--no-captive); fi
    if [[ "${disabled}" == true ]]; then mod+=(--disabled); else mod+=(--enabled); fi
    local bon; bon=$(jq -c '.broadcastOn // "all"' <<<"${old}")
    if [[ "$(jq -r 'type' <<<"${bon}")" == array ]]; then
        mod+=(--broadcast-on "$(jq -r --arg a "${ap}" '(if index([$a]) then . else . + [$a] end) | join(",")' <<<"${bon}")")
    fi
    ssid_modify "${s}" "${mod[@]}"
}

legacy_ssid_remove() {
    local ap="$1" s="${2:-}"
    [[ -n "${s}" ]] || die "ssid remove requires <ssid-name>"
    jq -e --arg n "${ap}" --arg s "${s}" '.accessPoints[$n].ssids // {} | has($s)' "${DESIRED}" >/dev/null \
        || die "SSID '${s}' not found on AP '${ap}'"
    local old rest
    old=$(ssid_entry "${s}")
    rest=$(ssid_aps "${s}" | { grep -vxF -- "${ap}" || true; } | paste -sd, -)
    if [[ "${old}" == null || -z "${rest}" ]]; then
        if [[ "${old}" == null ]]; then
            derive_ap_ssids
        else
            ssid_remove "${s}"
        fi
        return 0
    fi
    ssid_modify "${s}" --broadcast-on "${rest}"
}

cmd_ssid() {
    local first="${1:-}"
    [[ "${first}" == list || "${2:-}" == list ]] || require_site_wide
    case "${first}" in
        add)            shift; ssid_add "$@" ;;
        modify)         shift; ssid_modify "$@" ;;
        remove)         shift; ssid_remove "${1:-}" ;;
        list)           shift; ssid_list "${1:-}" ;;
        set-passphrase) shift; ssid_set_passphrase "$@" ;;
        "") die "ssid requires add|modify|remove|list|set-passphrase (see ap-manager ssid --help)" ;;
        *)
            local ap="${first}" sub="${2:-}"
            shift 2 2>/dev/null || die "ssid requires add|modify|remove|list|set-passphrase"
            ap_exists "${ap}" || die "AP '${ap}' not found (or '${ap}' is not an ssid verb: add|modify|remove|list|set-passphrase)"
            case "${sub}" in
                add)    legacy_note add; legacy_ssid_add "${ap}" "$@" ;;
                remove) legacy_note remove; legacy_ssid_remove "${ap}" "${1:-}" ;;
                list)   jq --arg n "${ap}" '.accessPoints[$n].ssids // {}' "${DESIRED}" ;;
                *) die "ssid: unknown subcommand '${sub}' (add|remove|list)" ;;
            esac
            ;;
    esac
}

# Say so when an AP broadcasts more SSIDs than its ceiling (wlan-lib.sh). Before
# reconcile --apply creates them, not after. Returns 1 when over.
warn_ssid_ceiling() {
    local ap="$1" n max
    n=$(wlan_ssid_count "${ap}" "${DESIRED}")
    max=$(wlan_max_ssids "${ap}" "${DESIRED}")
    [[ "${n}" -gt "${max}" ]] || return 0
    warn "  AP '${ap}' broadcasts ${n} SSIDs, more than ${max}: each one beacons on every radio and takes airtime from the rest"
    warn "    fold zones onto fewer SSIDs, or accept it for this AP: set .accessPoints[\"${ap}\"].maxSsids"
    return 1
}

# ── Phase 0: update-desired (each AP's SSIDs from the site-wide list) ──

cmd_update_desired() {
    info "${BOLD}update-desired${CL} (site-wide SSIDs + zones.json → each AP's SSIDs)"
    local before after
    before=$(jq -c '[.accessPoints // {} | to_entries[] | {(.key): .value.ssids}] | add // {}' "${DESIRED}")
    derive_ap_ssids
    after=$(jq -c '[.accessPoints // {} | to_entries[] | {(.key): .value.ssids}] | add // {}' "${DESIRED}")
    info "  SSIDs: $(jq -r '.ssids // {} | length' "${DESIRED}") site-wide, on $(jq -r '.accessPoints // {} | length' "${DESIRED}") access point(s)$(
        [[ "${before}" == "${after}" ]] || echo "; access points' SSIDs re-derived (a zone's VLAN, the list or the inventory changed)")"
    return 0
}

# ── Phase 1: interrogate (via its controller; manual = no-op) ────────

cmd_interrogate() {
    info "${BOLD}interrogate${CL} (live APs → actual.json)"
    ensure_files
    local names name vendor ip ctl state prc tmp failed=0
    names=$(jq -r '.accessPoints // {} | keys[]' "${DESIRED}")
    if [[ -z "${names}" ]]; then info "  (no APs in inventory)"; return 0; fi
    while IFS= read -r name; do
        vendor=$(jq -r --arg n "${name}" '.accessPoints[$n].vendor' "${DESIRED}")
        ip=$(jq -r --arg n "${name}" '.accessPoints[$n].managementIp // ""' "${DESIRED}")
        ctl=$(ctl_for_vendor ap-manager "${vendor}")
        # The controller's stderr is left alone: it says WHY a device could not
        # be read (#733). Only stdout is its answer.
        prc=0
        state=$(ctl_run "${ctl}" ap-interrogate --ap "${name}" --ip "${ip}") || prc=$?
        if [[ "${prc}" -ne 0 ]] || ! jq -e 'type == "object"' >/dev/null 2>&1 <<< "${state}"; then
            warn "  ${name}: not interrogated — actual left unchanged"
            failed=$((failed + 1)); continue
        fi
        info "  ${name}: interrogated via $(ctl_label "${ctl}")"
        [[ "${state}" != "{}" ]] || continue
        tmp="$(mktemp)"
        # Merge (not replace) so operator/auto-detected fields like
        # uplinkSwitch/uplinkPort survive an interrogate that only reports
        # vendor/model/managementIp/ssids.
        if jq --arg n "${name}" --argjson s "${state}" '.accessPoints[$n] = ((.accessPoints[$n] // {}) * $s)' "${ACTUAL}" > "${tmp}"; then
            mv "${tmp}" "${ACTUAL}"
        else
            rm -f "${tmp}"
            warn "  ${name}: its answer could not be merged into actual — left unchanged"
            failed=$((failed + 1))
        fi
    done <<< "${names}"
    if [[ "${failed}" -gt 0 ]]; then
        error "interrogate: ${failed} AP(s) could not be read"
        return 1
    fi
    return 0
}

# ── Phase 2: delta (desired vs actual + zone/uplink validations) ────

compute_delta() {
    jq -n --slurpfile d "${DESIRED}" --slurpfile a "${ACTUAL}" '
      ($d[0].accessPoints // {}) as $des
      | ($a[0].accessPoints // {}) as $act
      | ($d[0].ssids // {}) as $ss
      | reduce ($des | keys[]) as $ap ({};
          . + {($ap): {
              changes: [
                ($des[$ap].ssids // {} | to_entries[]) as $s
                | ($act[$ap].ssids[$s.key]) as $as
                | if $as == null then
                    {action:"create-ssid", ssid:$s.key,
                     description:"SSID \($s.key) (VLAN \($s.value.vlan), zone \($s.value.zone)) not on AP yet"}
                  elif ($as.vlan != $s.value.vlan) then
                    {action:"ssid-vlan", ssid:$s.key,
                     description:"SSID \($s.key) VLAN \($as.vlan) -> \($s.value.vlan)"}
                  elif (($as.security // $s.value.security) != $s.value.security)
                       or ((if ($as | has("enabled")) then $as.enabled else $s.value.enabled end) != $s.value.enabled) then
                    {action:"ssid-settings", ssid:$s.key,
                     description:"SSID \($s.key) \([(if ($as.security // $s.value.security) != $s.value.security then "security \($as.security) -> \($s.value.security)" else empty end),
                                                (if (if ($as | has("enabled")) then $as.enabled else $s.value.enabled end) != $s.value.enabled then (if $s.value.enabled then "enable" else "disable" end) else empty end)] | join(", "))"}
                  elif ($ss[$s.key].passphraseChanged == true) then
                    {action:"ssid-passphrase", ssid:$s.key,
                     description:"SSID \($s.key): a new passphrase to push (from the secrets file)"}
                  else empty end
              ],
              removed: [
                (($act[$ap].ssids // {} | keys) - ($des[$ap].ssids // {} | keys))[]
              ]
          }})
    '
}

# Validate the WiFi wiring and print warnings; sets VALIDATION_WARN:
#   - each active zone's SSID is a site-wide SSID bridged to that zone (a
#     template placeholder such as <IOT_SSID> is no SSID: the zone has no WiFi
#     until `ssid add` names one, and nothing is said about it);
#     an enabled SSID some access point broadcasts;
#   - each site-wide SSID bridges to a zone that exists, is on, and names it;
#   - no AP over its SSID ceiling; each AP's uplink port carries its SSIDs' VLANs.
validate() {
    VALIDATION_WARN=0
    local zone ssid_name site vz vstate vname en aps
    # Active zones with an SSID. An Inactive or Disabled zone keeps its SSID but
    # broadcasts nothing; a template placeholder was never chosen: the zone has
    # no WiFi, and `ssid add` replaces it when one is named (#734, #889).
    while IFS=$'\t' read -r zone ssid_name _; do
        [[ -z "${ssid_name}" || "${ssid_name}" == "null" ]] && continue
        is_placeholder "${ssid_name}" && continue
        site=$(jq -r --arg s "${ssid_name}" '.ssids[$s].zone // ""' "${DESIRED}")
        if [[ -z "${site}" ]]; then
            warn "  zone '${zone}' names SSID '${ssid_name}', which ap-manager does not hold: ap-manager ssid add '${ssid_name}' --zone ${zone} --security <sec>"
            VALIDATION_WARN=$((VALIDATION_WARN + 1))
        elif [[ "${site}" != "${zone}" ]]; then
            warn "  zone '${zone}' names SSID '${ssid_name}', which bridges to zone '${site}'"
            VALIDATION_WARN=$((VALIDATION_WARN + 1))
        fi
    done < <(wlan_zones "${ZONES_FILE}")

    # Each site-wide SSID: its zone exists, is on and names it; broadcast somewhere.
    while IFS=$'\t' read -r ssid_name zone en; do
        [[ -n "${ssid_name}" ]] || continue
        if ! zone_exists "${zone}"; then
            warn "  SSID '${ssid_name}' bridges to zone '${zone}', which does not exist: ap-manager ssid modify '${ssid_name}' --zone <zone>"
            VALIDATION_WARN=$((VALIDATION_WARN + 1)); continue
        fi
        vstate=$(jq -r --arg z "${zone}" '.[$z].state // "Active"' "${ZONES_FILE}")
        vname=$(zone_ssid "${zone}")
        if [[ "${vname}" != "${ssid_name}" ]]; then
            warn "  SSID '${ssid_name}' bridges to zone '${zone}', which names ${vname:-no SSID}: ap-manager ssid modify '${ssid_name}' --zone ${zone} rewrites it"
            VALIDATION_WARN=$((VALIDATION_WARN + 1))
        fi
        [[ "${en}" == true ]] || continue
        if [[ "${vstate}" != Active && "${vstate}" != Mandatory ]]; then
            warn "  SSID '${ssid_name}' bridges to zone '${zone}', which is ${vstate}: devices that join get no network (ap-manager ssid modify '${ssid_name}' --disabled)"
            VALIDATION_WARN=$((VALIDATION_WARN + 1))
        fi
        aps=$(ssid_aps "${ssid_name}")
        if [[ -z "${aps}" ]]; then
            if [[ "$(jq -r '.accessPoints // {} | length' "${DESIRED}")" -eq 0 ]]; then
                warn "  SSID '${ssid_name}' (zone '${zone}'): no access point is registered to broadcast it (ap-manager add)"
            else
                warn "  SSID '${ssid_name}' (zone '${zone}'): no AP broadcasts it (ap-manager ssid modify '${ssid_name}' --broadcast-on all)"
            fi
            VALIDATION_WARN=$((VALIDATION_WARN + 1))
        fi
    done < <(jq -r '.ssids // {} | to_entries[] | [.key, .value.zone, (.value.disabled != true)] | @tsv' "${DESIRED}")

    # No AP over its SSID ceiling (wlan-lib.sh).
    while IFS= read -r ap; do
        [[ -n "${ap}" ]] || continue
        warn_ssid_ceiling "${ap}" || VALIDATION_WARN=$((VALIDATION_WARN + 1))
    done < <(jq -r '.accessPoints // {} | keys[]' "${DESIRED}")

    # AP uplink port must carry each SSID's VLAN (cross-check against switch config)
    local ap up_sw up_port carried vlan ssid
    while IFS= read -r ap; do
        up_sw=$(jq -r --arg n "${ap}" '.accessPoints[$n].uplinkSwitch // ""' "${DESIRED}")
        up_port=$(jq -r --arg n "${ap}" '.accessPoints[$n].uplinkPort // ""' "${DESIRED}")
        [[ -z "${up_sw}" || -z "${up_port}" ]] && continue
        carried=$(jq -c --arg s "${up_sw}" --arg p "${up_port}" '.switches[$s].ports[$p].taggedVlans // []' "${DESIRED}")
        while IFS=$'\t' read -r ssid vlan; do
            [[ -z "${vlan}" ]] && continue
            if [[ "$(echo "${carried}" | jq --argjson v "${vlan}" 'index($v) != null')" != "true" ]]; then
                warn "  AP '${ap}' uplink ${up_sw}:${up_port} does not carry VLAN ${vlan} (SSID '${ssid}')"
                VALIDATION_WARN=$((VALIDATION_WARN + 1))
            fi
        done < <(jq -r --arg n "${ap}" '.accessPoints[$n].ssids // {} | to_entries[] | "\(.key)\t\(.value.vlan)"' "${DESIRED}")
    done < <(jq -r '.accessPoints // {} | keys[]' "${DESIRED}")
    return 0
}

cmd_delta() {
    local delta total=0
    delta=$(compute_delta)
    info "${BOLD}delta${CL} (desired vs actual)"
    local ap
    # One AP per LINE: a name may contain a space ("Nano HD"), and a word-split
    # loop saw two APs that exist nowhere — each reported in sync, so a real
    # delta on the AP itself was never shown.
    while IFS= read -r ap <&3; do
        local n r
        n=$(echo "${delta}" | jq -r --arg a "${ap}" '.[$a].changes | length')
        r=$(echo "${delta}" | jq -r --arg a "${ap}" '.[$a].removed | length')
        total=$((total + n + r))
        if [[ "${n}" -gt 0 ]]; then
            warn "  ${ap}: ${n} change(s)"
            echo "${delta}" | jq -r --arg a "${ap}" '.[$a].changes[] | "      \(.action): \(.description)"'
        else
            info "  ${GN}✓${CL} ${ap}: SSIDs in sync"
        fi
        [[ "${r}" -gt 0 ]] && warn "  ${ap}: ${r} SSID(s) to remove: $(echo "${delta}" | jq -r --arg a "${ap}" '.[$a].removed | join(", ")')"
    done 3< <(jq -r 'keys[]' <<< "${delta}")
    [[ "$(echo "${delta}" | jq -r 'keys|length')" -eq 0 ]] && info "  (no APs in inventory)"
    validate
    DELTA_TOTAL=$((total + VALIDATION_WARN))
    return 0
}

# ── Phase 3 / 4: apply / confirm ────────────────────────────────────

cmd_apply() {
    local delta ap vendor changes ctl rc manual=0 applied=0
    delta=$(compute_delta)
    info "${BOLD}apply${CL}"
    # One AP per line, on fd 3 so a controller reading stdin cannot eat the list.
    while IFS= read -r ap <&3; do
        changes=$(echo "${delta}" | jq -c --arg a "${ap}" '{changes: .[$a].changes}')
        [[ "$(echo "${changes}" | jq '.changes|length')" -eq 0 ]] && continue
        vendor=$(jq -r --arg n "${ap}" '.accessPoints[$n].vendor' "${DESIRED}")
        ctl=$(ctl_for_vendor ap-manager "${vendor}")
        rc=0
        ctl_run "${ctl}" ap-apply --ap "${ap}" --changes-json "${changes}" >/dev/null || rc=$?
        if [[ "${rc}" -eq 0 ]]; then info "  ${GN}✓${CL} ${ap}: applied via $(ctl_label "${ctl}")"; applied=$((applied+1))
        else manual=$((manual+1)); fi
    done 3< <(jq -r 'keys[]' <<< "${delta}")
    APPLY_MANUAL="${manual}"; APPLY_DONE="${applied}"
    return 0
}

cmd_confirm() {
    info "${BOLD}confirm${CL} (record applied state in actual.json)"
    ensure_files
    local tmp; tmp="$(mktemp)"
    jq --slurpfile d "${DESIRED}" '.accessPoints = ($d[0].accessPoints // {})' "${ACTUAL}" > "${tmp}" && mv "${tmp}" "${ACTUAL}"
    info "  ${GN}✓${CL} actual.json AP state updated to match desired"
    local pushed
    pushed=$(jq -r '[.ssids // {} | to_entries[] | select(.value.passphraseChanged == true) | .key] | join(", ")' "${DESIRED}")
    if [[ -n "${pushed}" ]]; then
        jq_desired '.ssids |= map_values(del(.passphraseChanged))'
        info "  ${GN}✓${CL} passphrase pushed: ${pushed}"
    fi
    return 0
}

cmd_reconcile() {
    local apply="$1"
    DELTA_TOTAL=0; APPLY_MANUAL=0; APPLY_DONE=0; VALIDATION_WARN=0
    cmd_update_desired; echo ""
    local stale=0
    cmd_interrogate || stale=1; echo ""
    cmd_delta; echo ""
    # A delta against an actual that could not be refreshed is a report, not a
    # plan: applying it would push changes on stale state (#733).
    if [[ "${stale}" -eq 1 ]]; then
        error "ap-manager: not all APs could be read — delta shown, nothing applied"
        return 1
    fi
    if [[ "${apply}" -eq 1 ]]; then
        cmd_apply; echo ""
        if [[ "${APPLY_MANUAL:-0}" -eq 0 ]]; then
            cmd_confirm
            info "${GN}ap-manager: converged${CL} (${APPLY_DONE:-0} applied)"
            [[ "${VALIDATION_WARN:-0}" -gt 0 ]] && { warn "ap-manager: ${VALIDATION_WARN} validation warning(s)"; return 2; }
            return 0
        fi
        warn "ap-manager: ${APPLY_MANUAL} AP(s) need MANUAL application — apply, then run: ap-manager confirm"
        return 2
    fi
    if [[ "${DELTA_TOTAL:-0}" -gt 0 ]]; then
        warn "ap-manager: ${DELTA_TOTAL} change(s)/warning(s) pending. Re-run with --apply."
        return 2
    fi
    info "${GN}ap-manager: in sync${CL}"
    return 0
}

# ── Main ─────────────────────────────────────────────────────────────

main() {
    local cmd="${1:-}"
    [[ -z "${cmd}" ]] && { usage; exit 0; }
    cli_gate usage "${CLI_SPEC}" "$@"
    shift || true
    [[ -f "${ZONES_FILE}" ]] || die "zones.json not found: ${ZONES_FILE}"
    ensure_files
    case "${cmd}" in add|remove|update-desired|apply|confirm|reconcile) require_site_wide ;; esac
    # One vendor login per run, shared by every AP's controller run (#733).
    UNIFI_SESSION="$(mktemp -d)"
    export UNIFI_SESSION
    trap 'rm -rf "${UNIFI_SESSION}"' EXIT

    case "${cmd}" in
        add)            cmd_add "$@" ;;
        modify)         cmd_modify "$@" ;;
        validate)       cmd_validate ;;
        remove)         cmd_remove "${1:-}" ;;
        list)           cmd_list "${1:-}" ;;
        show)           cmd_show "${1:-}" ;;
        link)           cmd_link "$@" ;;
        ssid)           cmd_ssid "$@" ;;
        update-desired) cmd_update_desired ;;
        interrogate)    cmd_interrogate ;;
        delta)          cmd_delta ;;
        apply)          cmd_apply ;;
        confirm)        cmd_confirm ;;
        reconcile)
            local apply=0
            [[ "${1:-}" == "--apply" ]] && apply=1
            cmd_reconcile "${apply}"
            ;;
        *) die "Unknown command: ${cmd} (try --help)" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
