        },
        {
          "flag": "--usb",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "key export|import: a USB stick in a node — encrypted with a password, verified, ejected."
        },
        {
          "flag": "--node",
          "takesValue": true,
          "arg": "N",
          "choices": null,
          "repeatable": false,
          "description": "key export|import --usb: the node holding the stick (default tappaas1)."
        },
        {
          "flag": "--format",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "key export --usb: erase the stick even if it is a key stick written before (default: rewrite only its keys, keep everything else on it)."
        },
        {
          "flag": "--device",
          "takesValue": true,
          "arg": "D",
          "choices": null,
          "repeatable": false,
          "description": "key export --usb: the stick, as the node lists it (/dev/sdb) — no insert-and-press-Enter, no choice; refused unless it is a USB disk not in use. The web console passes this."
        },
        {
          "flag": "--yes",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "key export --usb --device: no typed confirmation — the caller showed the operator what is erased or kept."
        },
        {
          "flag": "--password-stdin",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "key export --usb --device: the password is the first line of stdin (never on a command line), once, 12+ characters."
        },
        {
          "flag": "--file",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "key export|import: a directory — the keys UNENCRYPTED; guard what holds them."
        },
        {
          "flag": "--dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "key stamp: the keys a stick was just found to hold. The USB export and import call this."
        },
        {
          "flag": "--label",
          "takesValue": true,
          "arg": "TEXT",
          "choices": null,
          "repeatable": false,
          "description": "key stamp: what the stick is (node, vendor, serial)."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $CONFIG_DIR or /home/tappaas/config)."
        },
        {
          "flag": "--pbs",
          "takesValue": true,
          "arg": "HOST",
          "choices": null,
