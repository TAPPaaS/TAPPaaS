    {
      "verb": "report",
      "keys": [
        [
          "report"
        ]
      ],
      "usage": "report [--json] [--discover]",
      "note": "(ADR-040: send the organizations, roles, groups and users to the CMDB)",
      "details": null,
      "positionals": [],
      "options": [
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Print the report instead of sending it."
        },
        {
          "flag": "--discover",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Full depth (D15): also Authentik's providers, applications, outposts and flows, on the identity module's CI."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Identity directory (default: $TAPPAAS_CONFIG/identities)"
        },
        {
          "flag": "--no-reconcile",
          "takesValue": false,
