{
  "manifest": 1,
  "name": "identity-manager",
  "version": "0.1.0",
  "tagline": "TAPPaaS Identity → Authentik manager",
  "common": [
    {
      "flag": "--config-dir",
      "takesValue": true,
      "arg": "DIR",
      "choices": null,
      "repeatable": false,
      "description": "Identity directory (default: $TAPPAAS_CONFIG/identities)"
    },
    {
      "flag": "--no-reconcile",
      "takesValue": false,
      "arg": null,
      "choices": null,
      "repeatable": false,
      "description": "add/modify/delete: write config only, do NOT push to identity"
    }
  ],
  "verbs": [
    {
      "verb": "bootstrap",
      "keys": [
        [
          "bootstrap"
        ]
      ],
      "usage": "bootstrap --org O --user U --email E [--minimal-org DIR] [--force] [--skip-validate]",
      "note": "(seeds config/identities from minimal-org/ — the retired user-setup.sh)",
      "details": null,
      "positionals": [],
      "options": [
        {
          "flag": "--org",
          "takesValue": true,
          "arg": "O",
          "choices": null,
          "repeatable": false,
          "description": "organization slug (= the TAPPaaS installation name)"
        },
        {
          "flag": "--user",
          "takesValue": true,
          "arg": "U",
          "choices": null,
          "repeatable": false,
          "description": "the installer's username (slug)"
        },
        {
          "flag": "--email",
          "takesValue": true,
          "arg": "E",
          "choices": null,
          "repeatable": false,
          "description": "the installer's primary email address"
        },
        {
          "flag": "--minimal-org",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "template source (default: the component's minimal-org/)"
        },
        {
          "flag": "--force",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "overwrite a non-empty destination"
        },
        {
          "flag": "--skip-validate",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "skip the post-copy reference validation"
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Identity directory (default: $TAPPAAS_CONFIG/identities)"
        },
        {
          "flag": "--no-reconcile",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "add/modify/delete: write config only, do NOT push to identity"
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "none",
        "touches": "seeds config/identities from the minimal org; nothing reaches Authentik until reconcile --apply"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": [
        {
          "flag": "--force",
          "consequence": "overwrite a non-empty destination"
        }
      ]
    },
    {
      "verb": "reconcile",
      "keys": [
        [
          "reconcile"
        ],
        [
          "sync"
        ]
      ],
      "usage": "reconcile [--apply]",
      "note": "(alias: sync, deprecated)",
      "details": null,
      "positionals": [],
      "options": [
        {
          "flag": "--apply",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "push the plan to Authentik (default is PREVIEW)"
        },
        {
          "flag": "--dry-run",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "deprecated no-op (preview is already the default)"
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
