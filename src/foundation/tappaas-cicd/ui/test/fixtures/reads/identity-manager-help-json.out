    {
      "verb": "user reset-password",
      "keys": [
        [
          "user",
          "reset-password"
        ]
      ],
      "usage": "user reset-password <name> [--link | --password-stdin]",
      "note": null,
      "details": null,
      "positionals": [
        {
          "name": "name",
          "optional": false,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--link",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "(default) Print a one-time link where the user sets a password of their own; the link is the authentication, it expires unused. Needs Authentik's recovery flow (identity's update.sh makes it)."
        },
        {
          "flag": "--password-stdin",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Set the password that is the first line of stdin: never on a command line, never printed. The console's way; 8 characters or more."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Identity directory (default: $TAPPAAS_CONFIG/identities)"
        },
        {
          "flag": "--no-reconcile",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "add/modify/delete: write config only, do NOT push to identity"
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "none",
        "touches": "gives the user a new way in: a one-time link to set their own password (printed), or a password read from stdin"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
