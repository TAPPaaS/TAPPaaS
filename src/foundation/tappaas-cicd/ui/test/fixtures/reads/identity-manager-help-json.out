    {
      "verb": "<kind> list",
      "keys": [
        [
          "role",
          "list"
        ],
        [
          "org",
          "list"
        ],
        [
          "organization",
          "list"
        ],
        [
          "group",
          "list"
        ],
        [
          "user",
          "list"
        ]
      ],
      "usage": "<kind> list [--json] [--deep] [--declared]",
      "note": "(group: the model's groups and, marked by their origin, the ones a module or Authentik declares; user: the model's users and Authentik's akadmin and outpost accounts)",
      "details": null,
      "positionals": [],
      "options": [
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "structured output (default is human-readable)"
        },
        {
          "flag": "--deep",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "org/group only: recurse into groups + user membership"
        },
        {
          "flag": "--declared",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "group/user only: just the groups a module or Authentik declares, or the users Authentik's bootstrap does (no config file), with their origin"
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Identity directory (default: $TAPPAAS_CONFIG/identities)"
        },
        {
          "flag": "--no-reconcile",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "add/modify/delete: write config only, do NOT push to identity"
        }
      ],
      "open": false,
      "effect": "read",
      "preview": {
        "kind": "read"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [
        {
          "flag": "--deep",
          "touches": "runs the deep suite: creates and removes zztest guests"
        }
      ],
      "disruptions": []
    },
