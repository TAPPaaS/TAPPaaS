        },
        {
          "flag": "--no-reconcile",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "add/modify/delete: write config only, do NOT push to identity"
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "apply-flag",
        "flag": "--apply"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
