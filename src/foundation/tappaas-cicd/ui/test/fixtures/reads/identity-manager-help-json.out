    {
      "verb": "<kind> add",
      "keys": [
        [
          "role",
          "add"
        ],
        [
          "org",
          "add"
        ],
        [
          "organization",
          "add"
        ],
        [
          "group",
          "add"
        ],
        [
          "user",
          "add"
        ]
      ],
      "usage": "<kind> add <name> [field flags] [--force] [--no-reconcile]",
      "note": null,
      "details": "modify also takes --set <field>=<value> (repeatable) and --unset <field>, by the\nschema's field name (user: displayName, primaryEmail, state, roles, memberOf); the\nflags below are shortcuts for them, one field each (ADR-020 D11).\nField flags (write the validated config, then push it to the identity service):\n  role:  --displayName V  --description V\n  org:   --displayName V  --type V  --owner USER  --parentOrg ORG\n  group: --displayName V  --type V  --ownerOrg ORG  --roles \"a,b\"  --add-roles R  --remove-roles R\n  user:  --displayName V  --email ADDR  --state planned|active|suspended|terminated\n         --roles \"a,b\"  --groups \"g1,g2\"  --add-roles R  --remove-roles R  --add-groups G  --remove-groups G",
      "positionals": [
        {
          "name": "name",
          "optional": false,
          "repeatable": false
        },
        {
          "name": "field",
          "optional": true,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--force",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "overwrite an existing entity"
        },
        {
          "flag": "--no-reconcile",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "add/modify/delete: write config only, do NOT push to identity"
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Identity directory (default: $TAPPAAS_CONFIG/identities)"
        }
      ],
      "open": true,
      "effect": "write",
      "preview": {
        "kind": "none",
        "touches": "writes the entity into config/identities and pushes it to Authentik (with --no-reconcile: config only, then reconcile)"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": [
        {
          "flag": "--force",
          "consequence": "overwrite an existing entity"
        }
      ]
    },
