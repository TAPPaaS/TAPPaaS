    "sentence": "a warning or critical performance failure on a machine crosses runs-on to its dependant as a warning impact",
    "state": "",
    "decidesNow": 0
  },
  {
    "id": "core.rollup.site",
    "kind": "rollup",
    "description": "The site is the worst of everything on it that is not itself a sum.",
    "when": {
      "object": {
        "class": "site"
      }
    },
    "members": "all",
    "fn": "worst",
    "origin": "core",
    "sentence": "a site is the worst of everything that is not a sum",
    "state": "",
    "decidesNow": 32
  },
  {
    "id": "core.rollup.collection",
    "kind": "rollup",
    "description": "A cluster, an environment or a group is the worst of its members and what serves it.",
    "when": {
      "object": {
        "class": "collection"
      }
    },
    "members": [
      {
        "relations": [
          "member-of",
          "serves"
        ],
        "walk": "inbound"
      }
    ],
    "fn": "worst",
    "origin": "core",
    "sentence": "a collection is the worst of what is member-of or serves it",
    "state": "",
    "decidesNow": 45
  },
  {
    "id": "core.rollup.place",
    "kind": "rollup",
    "description": "A room or a rack is the worst of what is placed in it and the nodes its assets are allocated to.",
    "when": {
      "object": {
        "class": "place"
      }
    },
    "members": [
      {
        "relations": [
          "placed-in",
          "at"
        ],
        "walk": "inbound",
        "transitive": true
      },
      {
        "relations": [
          "allocated-to"
        ],
        "walk": "outbound"
      }
    ],
    "fn": "worst",
    "origin": "core",
    "sentence": "a place is the worst of what is placed-in or at it, all the way, then allocated-to from it",
    "state": "",
    "decidesNow": 51
  },
  {
    "id": "core.rollup.environment-score",
    "kind": "rollup",
    "description": "An environment's security is its own risk score, not the worst of its members; the modules that set it are the roots.",
    "when": {
      "object": {
        "class": "environment"
      },
      "condition": {
        "type": "security"
      }
    },
    "fn": "own",
    "origin": "core",
    "sentence": "an environment's security is its own, not a sum of its members",
    "state": "",
    "decidesNow": 3
  },
  {
    "id": "core.rollup.zone-score",
    "kind": "rollup",
    "description": "A zone's security is its own risk score, the sum of its modules': never a root.",
    "when": {
      "object": {
        "class": "zone"
      },
      "condition": {
        "type": "security"
      }
    },
    "fn": "own",
    "enabled": false,
    "origin": "core",
    "sentence": "a zone's security is its own, not a sum of its members",
    "state": "held: an example of a held rule",
    "decidesNow": 0
  },
  {
    "id": "site.classify.quiet-root-key",
    "kind": "classify",
    "description": "The root key on the cluster was rotated on purpose.",
    "when": {
      "finding": {
        "source": "alerts",
        "labels": {
          "alertname": "RootKeyChanged"
        }
      },
      "object": {
        "name": "cluster"
      }
    },
    "quiet": true,
    "origin": "site",
    "sentence": "a finding from alerts, alertname RootKeyChanged on an object named cluster is kept and quiet",
    "state": "added",
    "decidesNow": 0
  }
]
