  {
    "id": "core.propagate.stored-on.down",
    "kind": "propagate",
    "description": "A failed pool takes down the guests and datastores whose data is on it; a degraded pool reaches none of them.",
    "when": {
      "relation": "stored-on",
      "condition": {
        "type": "operational",
        "status": "critical"
      }
    },
    "as": {
      "status": "critical"
    },
