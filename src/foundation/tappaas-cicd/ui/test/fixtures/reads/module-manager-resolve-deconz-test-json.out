      "value": "[{\"port\":8080,\"protocol\":\"TCP\",\"description\":\"deCONZ REST (zigbee) — HA cross-zone srvHome->iotCloud + diyHue@localhost + Phoscon via mgmt proxy. NOT exposed to SysAP.\"},{\"port\":8443,\"protocol\":\"TCP\",\"description\":\"deCONZ websocket (zigbee) — HA deconz integration live events, cross-zone srvHome->iotCloud\"},{\"port\":80,\"protocol\":\"TCP\",\"description\":\"diyHue Hue API (hue-bridge) — SysAP/free@home control, INTRA-zone iotCloud\"},{\"port\":443,\"protocol\":\"TCP\",\"description\":\"diyHue Hue API TLS (hue-bridge) — genuine Hue-grade endpoint for SysAP, INTRA-zone iotCloud\"},{\"port\":1900,\"protocol\":\"UDP\",\"description\":\"SSDP discovery (hue-bridge) — diyHue advertises the bridge to the SysAP, INTRA-zone iotCloud\"},{\"port\":2100,\"protocol\":\"UDP\",\"description\":\"diyHue Hue Entertainment streaming (hue-bridge)\"},{\"port\":1982,\"protocol\":\"UDP\",\"description\":\"diyHue (hue-bridge)\"}]",
