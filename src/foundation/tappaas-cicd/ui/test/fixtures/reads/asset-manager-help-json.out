        ],
        [
          "mount",
          "add"
        ]
      ],
      "usage": "place <device> (--rack <rack> --u <n> | --room <room> | --in <asset> [--bay <bay>]) [--height <n>] [--width full|half|third] [--slot <n>] [--face front|rear] [--faceplate <vendor/model>] [--label <text>] [--description <text>] [--topology <file>] [--check]",
      "note": null,
      "details": null,
      "positionals": [
        {
          "name": "device",
          "optional": false,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--rack",
          "takesValue": true,
          "arg": "<rack>",
          "choices": null,
          "repeatable": false,
          "description": "In this rack."
        },
        {
          "flag": "--u",
          "takesValue": true,
          "arg": "<n>",
          "choices": null,
          "repeatable": false,
          "description": "The lowest rack unit it takes, as the rack numbers them."
        },
        {
          "flag": "--room",
          "takesValue": true,
          "arg": "<room>",
          "choices": null,
          "repeatable": false,
          "description": "Loose in this room, in no rack (no --rack, no --u): its plate gives its size."
        },
        {
          "flag": "--in",
          "takesValue": true,
          "arg": "<asset>",
          "choices": null,
          "repeatable": false,
          "description": "A disk only: into this asset (a server), out of stock or out of the asset it was in — the move."
        },
        {
          "flag": "--bay",
          "takesValue": true,
          "arg": "<bay>",
          "choices": null,
          "repeatable": false,
          "description": "With --in: the bay, as the asset labels it (default: the one it had there, else its by-id name)."
        },
        {
          "flag": "--height",
          "takesValue": true,
          "arg": "<n>",
          "choices": null,
          "repeatable": false,
          "description": "In a rack: the units it takes (default: its faceplate's, else 1)."
        },
        {
          "flag": "--width",
          "takesValue": true,
          "arg": "full|half|third",
          "choices": [
            "full",
            "half",
            "third"
          ],
          "repeatable": false,
          "description": "In a rack: full (default), half or third of its width."
        },
        {
          "flag": "--slot",
          "takesValue": true,
          "arg": "<n>",
          "choices": null,
          "repeatable": false,
          "description": "A half or third: its column, 0 at the left."
        },
        {
          "flag": "--face",
          "takesValue": true,
          "arg": "front|rear",
          "choices": [
            "front",
            "rear"
          ],
          "repeatable": false,
          "description": "In a rack: front (default) or rear."
        },
        {
          "flag": "--faceplate",
          "takesValue": true,
          "arg": "<vendor/model>",
          "choices": null,
          "repeatable": false,
          "description": "The catalog's plate (faceplates list); unset, the catalog's suggestion for its model."
        },
        {
          "flag": "--label",
          "takesValue": true,
          "arg": "<text>",
          "choices": null,
          "repeatable": false,
          "description": "The label on the device."
        },
        {
