{
  "manifest": 1,
  "name": "module-manager",
  "version": "0.1.0",
  "tagline": "TAPPaaS module lifecycle manager (ADR-007 #3)",
  "common": [
    {
      "flag": "--config-dir",
      "takesValue": true,
      "arg": "DIR",
      "choices": null,
      "repeatable": false,
      "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
    },
    {
      "flag": "--json",
      "takesValue": false,
      "arg": null,
      "choices": null,
      "repeatable": false,
      "description": "Machine-readable output (list / show / validate)."
    }
  ],
  "verbs": [
    {
      "verb": "list",
      "keys": [
        [
          "list"
        ]
      ],
      "usage": "list [--diff] [--services] [--resolution] [--json]",
      "note": null,
      "details": null,
      "positionals": [],
      "options": [
        {
          "flag": "--diff",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Per-module three-way (released/desired/running) drift rollup across every module."
        },
        {
          "flag": "--services",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "--diff: also check each module's dependency-service state (one firewall/API round-trip per dependency — OFF by default across the fleet)."
        },
        {
          "flag": "--resolution",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Which path locates each module's source directory (.moduleSource / repository catalog / neither). Offline; flags modules nothing can resolve."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Machine-readable output (list / show / validate)."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "read",
      "preview": {
        "kind": "read"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
