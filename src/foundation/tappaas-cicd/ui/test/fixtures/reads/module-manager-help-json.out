      "verb": "suspend",
      "keys": [
        [
          "suspend"
        ]
      ],
      "usage": "suspend <module> [--no-update]",
      "note": "(#428: stop the guest and keep everything else; patched by the nightly update, stopped again after)",
      "details": "The guest stops — through HA for an HA guest, which then keeps it stopped; otherwise with\nonboot cleared, so a node reboot does not start it. Config, backups, DNS and the published\nroute stay. The config is marked suspended and the health check reports it as suspended, not\ndown. The nightly update still patches it (#890): after every other module, when it fits on its\nnode, it is resumed, updated, tested and suspended again. A machine cannot be suspended.",
      "positionals": [
        {
          "name": "module",
          "optional": false,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--no-update",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Keep it out of that patch pass too — for a module stopped because it is broken. Resume clears it."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Machine-readable output (list / show / validate)."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "none",
        "touches": "stops the guest and keeps it stopped; config, backups, DNS and route stay; the nightly update still patches it"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
