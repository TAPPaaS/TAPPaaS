{
  "id": "core.propagate.member-of.zone-address",
  "origin": "core",
  "state": "as released",
  "sentence": "a critical operational failure on a zone crosses member-of to an address as a critical impact",
  "record": {
    "id": "core.propagate.member-of.zone-address",
    "kind": "propagate",
    "description": "An address in a zone that is down is cut off with it. What else is in a zone is the network module's to say.",
    "when": {
      "relation": "member-of",
      "provider": {
        "class": "zone"
      },
      "dependant": {
        "class": "address"
      },
      "condition": {
        "type": "operational",
        "status": "critical"
      }
    },
    "as": {
      "status": "critical"
    }
  },
