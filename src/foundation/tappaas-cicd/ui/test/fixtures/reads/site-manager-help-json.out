      "verb": "update",
      "keys": [
        [
          "update"
        ]
      ],
      "usage": "update [--dry-run] [--force] [--allow-disruption] [--no-git-pull] | update --stop",
      "note": "(run the whole-site update sweep NOW — packages update-tappaas)",
      "details": null,
      "positionals": [],
      "options": [
        {
          "flag": "--dry-run",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Preview the update plan; change nothing."
        },
        {
          "flag": "--force",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Update every module even when its pre-update test failed fatally, or its status is archived/external. Never reboots anything."
        },
        {
          "flag": "--allow-disruption",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Open the downtime window for this run: a module with rebootOk may be rebooted or migrated offline, the others keep their disruptive changes deferred. Never overrides rebootOk:false — that is `module-manager module update <m> --allow-disruption`."
        },
        {
          "flag": "--no-git-pull",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Update whatever is checked out; skip pulling each repository (test local, not-yet-pushed changes)."
        },
        {
          "flag": "--stop",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Stop the running update gracefully: the module in progress finishes, the rest are skipped (the next update takes them), and the run is recorded as interrupted. Ctrl-C only stops following a run; `sudo systemctl stop update-tappaas.service` stops it at once, without rolling back the module in progress."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Machine-readable output for list/show."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "dry-run-flag",
        "flag": "--dry-run"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": [
        {
          "flag": "--force",
          "consequence": "Update every module even when its pre-update test failed fatally, or its status is archived/external. Never reboots anything."
        },
        {
          "flag": "--allow-disruption",
          "consequence": "Open the downtime window for this run: a module with rebootOk may be rebooted or migrated offline, the others keep their disruptive changes deferred. Never overrides rebootOk:false — that is `module-manager module update <m> --allow-disruption`."
        }
      ]
