    {
      "verb": "node delete",
      "keys": [
        [
          "node",
          "delete"
        ]
      ],
      "usage": "node delete <name> [--apply] [--shutdown | --erase | --lost] [--asset keep|remove] [--archive] [--yes] [--config-only]",
      "note": null,
      "details": null,
      "positionals": [
        {
          "name": "name",
          "optional": false,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--apply",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Remove it from the cluster (pvecm delnode, /etc/pve/nodes/<n>, storage entries, known_hosts, its DNS entry, its switch ports parked); then its node record is deleted and its asset released. Refused while anything holds it; asks for the node name."
        },
        {
          "flag": "--shutdown",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Power the node off first — Proxmox removes a node only once it is off. A node that is already down needs nothing."
        },
        {
          "flag": "--erase",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Before the power-off: destroy its ZFS pools and wipe their disks, wipe the boot disk's partitions and partition table, delete its boot entry. Asks for ERASE as well. Implies --shutdown."
        },
        {
          "flag": "--lost",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "The node is down for good: the guests the cluster still places on it are lost with it (their configs saved on the mothership first), replication jobs touching it are removed, HA rules naming it stay. Refused for a node that answers. Its asset is removed (--asset remove) unless --asset keep is given."
        },
        {
          "flag": "--asset",
          "takesValue": true,
          "arg": "keep|remove",
          "choices": [
            "keep",
            "remove"
          ],
          "repeatable": false,
          "description": "The machine's asset. keep (default): released from the node, back in stock or still placed for its next role, its cables recorded. remove: released, then its recorded cables, its placement and its record are removed with the records of the disks it holds (asset-manager's verbs): the machine leaves the site with its disks. The CMDB keeps its history either way."
        },
        {
          "flag": "--archive",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Keep the node's record archived (listed as archived on the modules list) instead of deleting it, for a script that reads it afterwards."
        },
        {
          "flag": "--yes",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "With --apply: no typed confirmation (the node name, and ERASE) — for the web console, which has the node's name typed before Apply, and for a script."
        },
        {
          "flag": "--config-only",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Only delete (or with --archive, archive) the node's record and release its asset; the cluster is not touched."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Machine-readable output for list/show."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "apply-flag",
        "flag": "--apply"
      },
      "destructive": true,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": [
        {
          "flag": "--yes",
          "consequence": "With --apply: no typed confirmation (the node name, and ERASE) — for the web console, which has the node's name typed before Apply, and for a script."
        }
      ]
    },
