    {
      "verb": "node network set",
      "keys": [
        [
          "node",
          "network",
          "set"
        ]
      ],
      "usage": "node network set <node> [--lan-ports <a,b>] [--lan-mode <m>] [--lan-primary <if>] [--mtu <n>] [--switch-port <sw>:<p>] [--no-wan | --wan-port <p> [--wan-switch-port <sw>:<p>]] [--switch-wait <s>] [--config-only] [--apply] [--yes]",
      "note": null,
      "details": null,
      "positionals": [
        {
          "name": "node",
          "optional": false,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--lan-ports",
          "takesValue": true,
          "arg": "<a,b>",
          "choices": null,
          "repeatable": false,
          "description": "Ports by name or MAC. One port, or two or more bonded as lanbond."
        },
        {
          "flag": "--lan-mode",
          "takesValue": true,
          "arg": "<m>",
          "choices": null,
          "repeatable": false,
          "description": "active-backup (default: any switches, any speeds — 10G + 1G) or lacp (equal speeds; the switch side one LAG: one switch or a stack/MLAG pair)."
        },
        {
          "flag": "--lan-primary",
          "takesValue": true,
          "arg": "<if>",
          "choices": null,
          "repeatable": false,
          "description": "active-backup: the port that carries traffic when up (default: the fastest)."
        },
        {
          "flag": "--mtu",
          "takesValue": true,
          "arg": "<n>",
          "choices": null,
          "repeatable": false,
          "description": "MTU on the bond and the lan bridge (the switch ports must match)."
        },
        {
          "flag": "--switch-port",
          "takesValue": true,
          "arg": "<sw>:<p>",
          "choices": null,
          "repeatable": false,
          "description": "The switch port a lan port being added is cabled to: made the node's trunk on the switch before the node changes (on a switch TAPPaaS programs; on another, set it by hand)."
        },
        {
          "flag": "--no-wan",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "The wan bridge gives up its port, so it can join the lan bond (e.g. a 1G wan port as lan's backup leg). The node can then no longer carry the firewall's WAN; refused while a guest uses the wan bridge."
        },
        {
          "flag": "--wan-port",
          "takesValue": true,
          "arg": "<p>",
          "choices": null,
          "repeatable": false,
          "description": "The wan bridge carries <p> (by name or MAC): the reverse of --no-wan, so the firewall's WAN role can move to this node (#849). Not one of the lan ports. Moving the firewall's failover there also takes the network module's HANode and the switch port as an access port in the WAN VLAN (cluster README)."
        },
        {
          "flag": "--wan-switch-port",
          "takesValue": true,
          "arg": "<sw>:<p>",
          "choices": null,
          "repeatable": false,
          "description": "With --wan-port: the switch port the WAN cable reaches, made an access port in the WAN zone before the node changes."
        },
        {
          "flag": "--switch-wait",
          "takesValue": true,
          "arg": "<s>",
          "choices": null,
          "repeatable": false,
          "description": "With --apply: wait up to <s> seconds (30–1800, default 30) for the change to verify, to configure the switch side meanwhile — e.g. the LAG for lacp, once the node speaks it. Needs the drained node's HA watchdog released."
        },
        {
          "flag": "--config-only",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Declare only, without contacting the node (ports by MAC)."
        },
        {
          "flag": "--apply",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Converge: drain the node (HA maintenance), carry lan on the declared ports under a 45s rollback, confirm from the mothership, bring the node back. One node at a time."
        },
        {
          "flag": "--yes",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Do not ask for the node name."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Machine-readable output for list/show."
        }
      ],
      "open": false,
      "effect": "write",
