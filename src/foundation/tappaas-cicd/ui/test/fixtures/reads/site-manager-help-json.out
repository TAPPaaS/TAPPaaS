    {
      "verb": "node add",
      "keys": [
        [
          "node",
          "add"
        ]
      ],
      "usage": "node add <N> [--adopt <ipv4>] [--asset <a>] [--switch-port <sw>:<p>] [--mac <m>] [--boot-disk <d>] [--boot-mirror <d>] [--boot-filesystem zfs|ext4] [--wan-port <if>|--no-wan] [--lan-ports <a,b>] [--lan-mode <m>] [--lan-primary <if>] [--ttl <s>] [--no-reboot] [--config-only [--storage-pools <a,b>]] [--yes]",
      "note": null,
      "details": null,
      "positionals": [
        {
          "name": "N",
          "optional": false,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--adopt",
          "takesValue": true,
          "arg": "<ipv4>",
          "choices": null,
          "repeatable": false,
          "description": "Do not install: join a Proxmox installed by hand, reached as root over ssh at <ipv4> with the cicd key authorized; it moves to the node's management address in the join. The install options (--switch-port, --mac, --boot-*, --ttl) do not apply."
        },
        {
          "flag": "--asset",
          "takesValue": true,
          "arg": "<a>",
          "choices": null,
          "repeatable": false,
          "description": "The asset the machine is (asset-manager asset list: a server in stock or placed, in no role): checked before anything is installed, and its recorded cable and MAC stand in for --switch-port and --mac. Blank: once the node has joined, its serial and MACs are matched against the free server assets, and an asset is created (srv-NN) when none matches (ADR-040 D8)."
        },
        {
          "flag": "--switch-port",
          "takesValue": true,
          "arg": "<sw>:<p>",
          "choices": null,
          "repeatable": false,
          "description": "The switch and port the machine is cabled to. On a switch TAPPaaS manages, the port is set up as a trunk port, and the machine's MAC is learned there when it boots the installer (blank MAC). On a switch TAPPaaS does not program, configure the port by hand as a trunk port that also carries all the VLAN tagged traffic, and give --mac (blank: the first machine that asks gets the answer)."
        },
        {
          "flag": "--mac",
          "takesValue": true,
          "arg": "<m>",
          "choices": null,
          "repeatable": false,
          "description": "The MAC of the cabled card (aa:bb:cc:dd:ee:ff), from the machine's label, its BIOS or its BMC. Blank: learned on --switch-port; with no switch port either, the first machine that asks for an install answer while the boot window is open gets it (a cluster node never does) — keep --ttl short then."
        },
        {
          "flag": "--boot-disk",
          "takesValue": true,
          "arg": "<d>",
          "choices": null,
          "repeatable": false,
          "description": "The disk to install Proxmox on (wiped), can be the model name or size if it is unique. Blank: the smallest SSD or NVMe disk, and both when the smallest two are alike (mirrored). ask: chosen on the node's console."
        },
        {
          "flag": "--boot-mirror",
          "takesValue": true,
          "arg": "<d>",
          "choices": null,
          "repeatable": false,
          "description": "A second disk to mirror the boot pool onto, named like --boot-disk. Blank: a mirror only when --boot-disk finds two disks alike. none: one disk."
        },
        {
          "flag": "--boot-filesystem",
          "takesValue": true,
          "arg": "zfs|ext4",
          "choices": [
            "zfs",
            "ext4"
          ],
          "repeatable": false,
          "description": "The boot disk's filesystem; zfs (default) lets the boot pool carry the guests on a node with no data disk (ADR-037 D1), ext4 only with data disks."
        },
        {
          "flag": "--wan-port",
          "takesValue": true,
          "arg": "<if>|--no-wan",
          "choices": null,
          "repeatable": false,
          "description": "the node's WAN interface."
        },
        {
          "flag": "--no-wan",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "the node has no WAN port."
        },
        {
          "flag": "--lan-ports",
          "takesValue": true,
          "arg": "<a,b>",
          "choices": null,
          "repeatable": false,
          "description": "the node's lan port(s); two or more bond under lan as lanbond. Default: auto-detected, one port."
        },
        {
          "flag": "--lan-mode",
          "takesValue": true,
          "arg": "<m>",
          "choices": null,
          "repeatable": false,
          "description": "active-backup (default for 2+ ports: any switches, any speeds) or lacp (equal speeds; the switch side one LAG)."
        },
        {
          "flag": "--lan-primary",
          "takesValue": true,
          "arg": "<if>",
          "choices": null,
          "repeatable": false,
          "description": "active-backup: the port that carries traffic when up (default: the fastest)."
        },
        {
          "flag": "--ttl",
          "takesValue": true,
          "arg": "<s>",
          "choices": null,
          "repeatable": false,
          "description": "Seconds the boot window stays open (default 7200)."
        },
        {
          "flag": "--no-reboot",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Do not reboot the node after its first update. By default it reboots into the kernel that update installed, before it takes guests, when the cluster keeps quorum without it."
        },
        {
          "flag": "--config-only",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Only write the node's pvehost record, config/<N>.json (no machine contact)."
        },
        {
          "flag": "--storage-pools",
          "takesValue": true,
          "arg": "<a,b>",
          "choices": null,
          "repeatable": false,
          "description": "with --config-only: the pools to record. A node that joins records the zpools found on it; new pools are node storage add."
        },
        {
          "flag": "--yes",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Do not ask for the node's lan ports after the install: one port, auto-detected (also when --wan-port or --no-wan is given)."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Machine-readable output for list/show."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "none",
        "touches": "joins a node: installs it on a ZFS boot pool (network boot or the USB stick), adds it to the cluster and registers it as a pvehost instance; its data pools are node storage add"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": [
        {
          "flag": "--yes",
          "consequence": "Do not ask for the node's lan ports after the install: one port, auto-detected (also when --wan-port or --no-wan is given)."
        }
      ]
    },
