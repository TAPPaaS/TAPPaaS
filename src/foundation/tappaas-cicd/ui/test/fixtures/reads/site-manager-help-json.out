    {
      "verb": "node storage add",
      "keys": [
        [
          "node",
          "storage",
          "add"
        ]
      ],
      "usage": "node storage add <node> <pool> --disks <d,d> --layout single|mirror|raidz1|raidz2 [--wipe]",
      "note": null,
      "details": null,
      "positionals": [
        {
          "name": "node",
          "optional": false,
          "repeatable": false
        },
        {
          "name": "pool",
          "optional": false,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--disks",
          "takesValue": true,
          "arg": "<d,d>",
          "choices": null,
          "repeatable": false,
          "description": "The disks, by serial or /dev/disk/by-id name, as node storage <node> lists them. A kernel name (nvme0n1) is refused: it can change between boots. The boot disk and a disk in a live pool are always refused."
        },
        {
          "flag": "--layout",
          "takesValue": true,
          "arg": "single|mirror|raidz1|raidz2",
          "choices": [
            "single",
            "mirror",
            "raidz1",
            "raidz2"
          ],
          "repeatable": false,
          "description": "single (1 disk, no redundancy), mirror (2 or more), raidz1 (3 or more, one disk may fail), raidz2 (4 or more, two may fail)."
        },
        {
          "flag": "--wipe",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Erase disks that carry data or an old pool's label. Without it such a disk is a refusal and nothing is erased."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Machine-readable output for list/show."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "none",
        "touches": "builds a ZFS data pool on the node's disks and registers it as the node's storage"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
