{
  "manifest": 1,
  "name": "site-manager",
  "version": "0.1.0",
  "tagline": "TAPPaaS Site manager: the site, its nodes, its repositories and its updates",
  "common": [
    {
      "flag": "--config-dir",
      "takesValue": true,
      "arg": "DIR",
      "choices": null,
      "repeatable": false,
      "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
    },
    {
      "flag": "--json",
      "takesValue": false,
      "arg": null,
      "choices": null,
      "repeatable": false,
      "description": "Machine-readable output for list/show."
    }
  ],
  "verbs": [
    {
      "verb": "site show",
      "keys": [
        [
          "site",
          "show"
        ]
      ],
      "usage": "site show [--json]",
      "note": null,
      "details": null,
      "positionals": [],
      "options": [
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Machine-readable output for list/show."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "read",
      "preview": {
        "kind": "read"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "site modify",
      "keys": [
        [
          "site",
          "modify"
        ]
      ],
      "usage": "site modify <field options> [--check [--json]]",
      "note": null,
      "details": null,
      "positionals": [],
      "options": [
        {
          "flag": "--check",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "say what would change, in one line; write nothing."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "with --check: the whole resulting site.json, for machines."
        },
        {
          "flag": "--set",
          "takesValue": true,
          "arg": "<field>=<value>",
          "choices": null,
          "repeatable": false,
          "description": "set any field site-fields.json classes in-place, by its name (dotted inside an object: backup.target, updateSchedule.hour); repeat it. The options below are shortcuts, one field each (ADR-020 D11)."
        },
        {
          "flag": "--unset",
          "takesValue": true,
          "arg": "<field",
          "choices": null,
          "repeatable": false,
          "description": "remove optional fields (supportEmail, branding.logo, …); a required field and the update schedule cannot be removed."
        },
        {
          "flag": "--channel",
          "takesValue": true,
          "arg": "<c>",
          "choices": null,
          "repeatable": false,
          "description": "release channel: unstable | staging | production. Checks EVERY registered repository against the branch it declares for that channel in its channels.json, warns where they disagree or where none is declared, and proposes the fix; moving towards production needs --force."
        },
        {
          "flag": "--force",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "authorize a channel move towards production — older code, and migrations do not run backwards."
        },
        {
          "flag": "--displayName",
          "takesValue": true,
          "arg": "<s>",
          "choices": null,
          "repeatable": false,
          "description": "display name"
        },
        {
          "flag": "--owner",
          "takesValue": true,
          "arg": "<org>",
          "choices": null,
          "repeatable": false,
          "description": "owning organization"
        },
        {
          "flag": "--email",
          "takesValue": true,
          "arg": "<addr>",
          "choices": null,
          "repeatable": false,
          "description": "admin email"
        },
        {
          "flag": "--supportEmail",
          "takesValue": true,
          "arg": "<addr>",
          "choices": null,
          "repeatable": false,
          "description": "where an alert's support bundle is to be forwarded (#883): one e-mail address; empty by default, \"\" clears it"
        },
        {
          "flag": "--automaticReboot",
          "takesValue": true,
          "arg": "true|false",
          "choices": [
            "true",
            "false"
          ],
          "repeatable": false,
          "description": "allow update reboots"
        },
        {
          "flag": "--ipv6",
          "takesValue": true,
          "arg": "true|false",
          "choices": [
            "true",
            "false"
          ],
          "repeatable": false,
          "description": "the site supports IPv6: OPNsense's 'Allow IPv6', applied by the next network update (default false)"
        },
        {
          "flag": "--requireSigned",
          "takesValue": true,
          "arg": "true|false",
          "choices": [
            "true",
            "false"
          ],
          "repeatable": false,
          "description": "refuse to update a staging/production repository that signs no releases (ADR-033 D9; default false). A repository that lists signing keys is verified either way; one that declares no channels (no channels.json) is unstable, and moves unverified with a warning."
        },
        {
          "flag": "--snapshotRetention",
          "takesValue": true,
          "arg": "<n>",
          "choices": null,
          "repeatable": false,
          "description": "VM snapshots kept per module"
        },
        {
          "flag": "--backupTarget",
          "takesValue": true,
          "arg": "<s>",
          "choices": null,
          "repeatable": false,
          "description": "backup.target"
        },
        {
          "flag": "--backupOffsite",
          "takesValue": true,
          "arg": "<s>",
          "choices": null,
          "repeatable": false,
          "description": "backup.offsite"
        },
        {
          "flag": "--backupDefaultSchedule",
          "takesValue": true,
          "arg": "<s>",
          "choices": null,
          "repeatable": false,
          "description": "backup.defaultSchedule: daily | weekly | monthly | HH:MM"
        },
        {
          "flag": "--backupDefaultRetention",
          "takesValue": true,
          "arg": "<s>",
          "choices": null,
          "repeatable": false,
          "description": "backup.defaultRetention, e.g. 90d"
        },
        {
          "flag": "--primaryLocation",
          "takesValue": true,
          "arg": "<name>",
          "choices": null,
          "repeatable": false,
          "description": "the location the site is at: one of the site's locations (location list), with a timezone — the site's"
        },
        {
          "flag": "--locale",
          "takesValue": true,
          "arg": "<l>",
          "choices": null,
          "repeatable": false,
          "description": "the site's POSIX locale, e.g. en_US"
        },
        {
          "flag": "--keyboard",
          "takesValue": true,
          "arg": "<kb>",
          "choices": null,
          "repeatable": false,
          "description": "the console keyboard layout every OS family is set from, e.g. dk"
        },
        {
          "flag": "--brandingLogo",
          "takesValue": true,
          "arg": "<path>",
          "choices": null,
          "repeatable": false,
          "description": "branding.logo — the sign-in page's logo (svg, png, jpg, webp), relative to the config dir; applied by the identity update"
        },
        {
          "flag": "--brandingLogoDark",
          "takesValue": true,
          "arg": "<path>",
          "choices": null,
          "repeatable": false,
          "description": "branding.logoDark — its dark-theme variant, same file type"
        },
        {
          "flag": "--dnssec",
          "takesValue": true,
          "arg": "true|false",
          "choices": [
            "true",
            "false"
          ],
          "repeatable": false,
          "description": "the firewall's resolver validates DNSSEC (default true); applied by the next network update"
        },
        {
          "flag": "--dnsBlocklistsLists",
          "takesValue": true,
          "arg": "<a,b>",
          "choices": null,
          "repeatable": false,
          "description": "dnsBlocklists.lists — OPNsense blocklist codes (atf, hgz011, oisd1, ag, …); '' blocks nothing. Applied by the next network update"
        },
        {
          "flag": "--dnsBlocklistsZones",
          "takesValue": true,
          "arg": "<a,b>",
          "choices": null,
          "repeatable": false,
          "description": "dnsBlocklists.zones — the zones whose clients are filtered; '' filters every client"
        },
        {
          "flag": "--dnsBlocklistsAllow",
          "takesValue": true,
          "arg": "<a,b>",
          "choices": null,
          "repeatable": false,
          "description": "dnsBlocklists.allow — domains never blocked"
        },
        {
          "flag": "--diskAutoGrowEnabled",
          "takesValue": true,
          "arg": "true|false",
          "choices": [
            "true",
            "false"
          ],
          "repeatable": false,
          "description": "diskAutoGrow.enabled — grow a VM's disk when its / fills up, at every module update"
        },
        {
          "flag": "--diskAutoGrowThreshold",
          "takesValue": true,
          "arg": "<pct>",
          "choices": null,
          "repeatable": false,
          "description": "diskAutoGrow.threshold — grow at or over this % full (default 80)"
        },
        {
          "flag": "--diskAutoGrowGrowPercent",
          "takesValue": true,
          "arg": "<pct>",
          "choices": null,
          "repeatable": false,
          "description": "diskAutoGrow.growPercent — grow by this % of the disk (default 50)"
        },
        {
          "flag": "--diskAutoGrowMinGrowGB",
          "takesValue": true,
          "arg": "<gb>",
          "choices": null,
          "repeatable": false,
          "description": "diskAutoGrow.minGrowGB — and by at least this many GB (default 5)"
        },
        {
          "flag": "--diskAutoGrowPoolCeiling",
          "takesValue": true,
          "arg": "<pct>",
          "choices": null,
          "repeatable": false,
          "description": "diskAutoGrow.poolCeiling — only while the pool stays at or under this % used (default 80)"
        },
        {
          "flag": "--networkIsp",
          "takesValue": true,
          "arg": "<s>",
          "choices": null,
          "repeatable": false,
          "description": "network.isp"
        },
        {
          "flag": "--networkPublicIp",
          "takesValue": true,
          "arg": "<ip>",
          "choices": null,
          "repeatable": false,
          "description": "network.publicIp (or auto)"
        },
        {
          "flag": "--updateFrequency",
          "takesValue": true,
          "arg": "<f>",
          "choices": null,
          "repeatable": false,
          "description": "daily | weekly | monthly | none"
        },
        {
          "flag": "--updateWeekday",
          "takesValue": true,
          "arg": "<Day>",
          "choices": null,
          "repeatable": false,
          "description": "Monday … Sunday (weekly/monthly only)"
        },
        {
          "flag": "--updateHour",
          "takesValue": true,
          "arg": "<0-23>",
          "choices": null,
          "repeatable": false,
          "description": "hour of the update window"
        },
        {
          "flag": "--healthAssessInterval",
          "takesValue": true,
          "arg": "<min>",
          "choices": null,
          "repeatable": false,
          "description": "health.assessInterval — minutes between health-manager assess runs, 1-1440 (default 5; ADR-041 D2)"
        },
        {
          "flag": "--alertsIncludeLines",
          "takesValue": true,
          "arg": "true|false",
          "choices": [
            "true",
            "false"
          ],
          "repeatable": false,
          "description": "alerts.includeLines — alert mails carry the log lines a rule asks for (default true; ADR-039)"
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "dry-run-flag",
        "flag": "--check"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": [
        {
          "flag": "--force",
          "consequence": "authorize a channel move towards production — older code, and migrations do not run backwards."
        }
      ]
    },
    {
      "verb": "location list",
      "keys": [
        [
          "location",
          "list"
        ]
      ],
      "usage": "location list [--json]",
      "note": "(the site's places; * marks the primary one)",
      "details": null,
      "positionals": [],
      "options": [
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Machine-readable output for list/show."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "read",
      "preview": {
        "kind": "read"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "location show",
      "keys": [
        [
          "location",
          "show"
        ]
      ],
      "usage": "location show <name> [--json]",
      "note": "(its place, and what names it)",
      "details": null,
      "positionals": [
        {
          "name": "name",
          "optional": false,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Machine-readable output for list/show."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "read",
      "preview": {
        "kind": "read"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "location add",
      "keys": [
        [
          "location",
          "add"
        ]
      ],
      "usage": "location add <name> --country <CC> [--displayName <s>] [--kind site|remote] [--city <c>] [--address <a>] [--timezone <tz>] [--latitude <deg>] [--longitude <deg>] [--primary] [--check]",
      "note": null,
      "details": null,
      "positionals": [
        {
          "name": "name",
          "optional": false,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--country",
          "takesValue": true,
          "arg": "<CC>",
          "choices": null,
          "repeatable": false,
          "description": "ISO 3166-1 alpha-2 country code (required)."
        },
        {
          "flag": "--displayName",
          "takesValue": true,
          "arg": "<s>",
          "choices": null,
          "repeatable": false,
          "description": "the name shown (default: the name)."
        },
        {
          "flag": "--kind",
          "takesValue": true,
          "arg": "site|remote",
          "choices": [
            "site",
            "remote"
          ],
          "repeatable": false,
          "description": "site (default): a place of this site's own equipment — its building, a provider's data centre. remote: another site's, a backup buddy's."
        },
        {
          "flag": "--city",
          "takesValue": true,
          "arg": "<c>",
          "choices": null,
          "repeatable": false,
          "description": "the city — lets an off-site copy in the same country show it is elsewhere."
        },
        {
          "flag": "--address",
          "takesValue": true,
          "arg": "<a>",
          "choices": null,
          "repeatable": false,
          "description": "the street address, or the provider and data centre — for an off-site copy in the same city."
        },
        {
          "flag": "--timezone",
          "takesValue": true,
          "arg": "<tz>",
          "choices": null,
          "repeatable": false,
          "description": "IANA timezone; required for the primary location, whose timezone is the site's."
        },
        {
          "flag": "--latitude",
          "takesValue": true,
          "arg": "<deg>",
          "choices": null,
          "repeatable": false,
          "description": "decimal degrees, north positive (read by modules that need a position)."
        },
        {
          "flag": "--longitude",
          "takesValue": true,
          "arg": "<deg>",
          "choices": null,
          "repeatable": false,
          "description": "decimal degrees, east positive."
        },
        {
          "flag": "--primary",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "make it the primary location: the site is here, and every node and guest takes its timezone. The site's first own location is primary without it."
        },
        {
          "flag": "--check",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "say what would change, in one line; write nothing."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "with --check: the whole resulting site.json, for machines."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "dry-run-flag",
        "flag": "--check"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "location modify",
      "keys": [
        [
          "location",
          "modify"
        ]
      ],
      "usage": "location modify <name> [--set <field>=<value>]... [--displayName <s>] [--kind site|remote] [--country <CC>] [--city <c>] [--address <a>] [--timezone <tz>] [--latitude <deg>] [--longitude <deg>] [--unset <f,g>] [--check]",
      "note": null,
      "details": null,
      "positionals": [
        {
          "name": "name",
          "optional": false,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--set",
          "takesValue": true,
          "arg": "<field>=<value>",
          "choices": null,
          "repeatable": true,
          "description": "set a field by its name (displayName, kind, country, city, address, timezone, latitude, longitude); repeat it. The options below are shortcuts, one field each (ADR-020 D11)."
        },
        {
          "flag": "--displayName",
          "takesValue": true,
          "arg": "<s>",
          "choices": null,
          "repeatable": false,
          "description": "the name shown; '' (or --unset) clears this and the other optional fields."
        },
        {
          "flag": "--kind",
          "takesValue": true,
          "arg": "site|remote",
          "choices": [
            "site",
            "remote"
          ],
          "repeatable": false,
          "description": "site: this site's own equipment is there; remote: another site's place."
        },
        {
          "flag": "--country",
          "takesValue": true,
          "arg": "<CC>",
          "choices": null,
          "repeatable": false,
          "description": "ISO 3166-1 alpha-2 country code."
        },
        {
          "flag": "--city",
          "takesValue": true,
          "arg": "<c>",
          "choices": null,
          "repeatable": false,
          "description": "the city."
        },
        {
          "flag": "--address",
          "takesValue": true,
          "arg": "<a>",
          "choices": null,
          "repeatable": false,
          "description": "the street address, or the provider and data centre."
        },
        {
          "flag": "--timezone",
          "takesValue": true,
          "arg": "<tz>",
          "choices": null,
          "repeatable": false,
          "description": "IANA timezone; on the primary location it is the site's — every node and guest is set to it at the next update."
        },
        {
          "flag": "--latitude",
          "takesValue": true,
          "arg": "<deg>",
          "choices": null,
          "repeatable": false,
          "description": "decimal degrees, north positive."
        },
        {
          "flag": "--longitude",
          "takesValue": true,
          "arg": "<deg>",
          "choices": null,
          "repeatable": false,
          "description": "decimal degrees, east positive."
        },
        {
          "flag": "--unset",
          "takesValue": true,
          "arg": "<f,g>",
          "choices": null,
          "repeatable": false,
          "description": "clear these optional fields: displayName, kind, city, address, timezone, latitude, longitude. The country stays, and so does the primary location's timezone."
        },
        {
          "flag": "--check",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "say what would change, in one line; write nothing."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "with --check: the whole resulting site.json, for machines."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "dry-run-flag",
        "flag": "--check"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "location delete",
      "keys": [
        [
          "location",
          "delete"
        ]
      ],
      "usage": "location delete <name> [--check]",
      "note": "(refused for the primary location and for one a peer, room or device names)",
      "details": null,
      "positionals": [
        {
          "name": "name",
          "optional": false,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--check",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "say whether it can go, in one line; write nothing."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "with --check: the whole resulting site.json, for machines."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $TAPPAAS_CONFIG or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "dry-run-flag",
        "flag": "--check"
      },
      "destructive": true,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "node list",
      "keys": [
        [
          "node",
          "list"
        ]
      ],
      "usage": "node list [--json]",
      "note": "(the cluster's nodes: their pvehost instances, with their storage pools)",
      "details": null,
      "positionals": [],
      "options": [
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
