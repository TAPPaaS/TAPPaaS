      "usage": "rules add|edit|enable|disable|delete|restore|take|keep|accept [<target>] [--set path=value]... [--unset path]... [--file F] [--field F] [--origin O] [--note N] [--apply] [--force]",
      "note": null,
      "details": "Change what this site runs, kept in config/health/: an update never changes a rule edited here and never brings back one deleted here. delete is undone by restore; take takes the release (or one field), keep keeps the edit and marks it reviewed, accept runs a held rule. An apply that changes the active set recalculates health at once.",
      "positionals": [
        {
          "name": "target",
          "optional": true,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--set",
          "takesValue": true,
          "arg": "path=value",
          "choices": null,
          "repeatable": true,
          "description": "edit: set a field of the record (as.status=warning, when.dependant.zone=dmz); repeatable."
        },
        {
          "flag": "--unset",
          "takesValue": true,
          "arg": "path",
          "choices": null,
          "repeatable": true,
          "description": "edit: remove a field; repeatable."
        },
        {
          "flag": "--file",
          "takesValue": true,
          "arg": "F",
          "choices": null,
          "repeatable": false,
          "description": "add: the site's own records; edit: the record whole."
        },
        {
          "flag": "--field",
          "takesValue": true,
          "arg": "F",
          "choices": null,
          "repeatable": false,
          "description": "take: one field from the release, not the whole record."
