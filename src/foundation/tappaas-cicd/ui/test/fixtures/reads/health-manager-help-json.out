{
  "manifest": 1,
  "name": "health-manager",
  "version": "0.1.0",
  "tagline": "TAPPaaS cluster health manager (read-only)",
  "common": [
    {
      "flag": "--config-dir",
      "takesValue": true,
      "arg": "DIR",
      "choices": null,
      "repeatable": false,
      "description": "Config root (default: $CONFIG_DIR or /home/tappaas/config)."
    }
  ],
  "verbs": [
    {
      "verb": "validate",
      "keys": [
        [
          "validate"
        ]
      ],
      "usage": "validate [--live] [--threshold PCT] [--memory-threshold PCT] [--json] [--config-dir DIR]",
      "note": null,
      "details": "Reads the conditions the last assess wrote: the gates' table, and exit 1 on any critical\ncondition that is neither derived, acknowledged nor in maintenance. With no recent assess, or a\nthreshold given, it assesses first; with no CMDB it runs the gates itself.",
      "positionals": [],
      "options": [
        {
          "flag": "--live",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Run assess first: the planes as they are now, not as of the last run."
        },
        {
          "flag": "--threshold",
          "takesValue": true,
          "arg": "PCT",
          "choices": null,
          "repeatable": false,
          "description": "Disk-usage threshold percent (default 80)."
        },
        {
          "flag": "--memory-threshold",
          "takesValue": true,
          "arg": "PCT",
          "choices": null,
          "repeatable": false,
          "description": "Committed-memory percent of a node's physical RAM before the gate fails (default 100)."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Print every gate as JSON: status, detail and its findings, each with the module, node, pool, disk or peer it is about."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $CONFIG_DIR or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "read",
      "preview": {
        "kind": "read"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "capacity",
      "keys": [
        [
          "capacity"
        ]
      ],
      "usage": "capacity [--install <instance> | --room-for <module> | --drain <node>] [--memory-threshold PCT] [--json] [--config-dir DIR]",
      "note": null,
      "details": "What each node commits once the update has converged every guest: a VM at its configured memory, a container at its highest use of the last week plus 25% (at least 512 MB, at most its limit). Growth that does not fit under the threshold is held: named, and the update keeps that module at its current memory; everything else goes ahead. A node already over that nothing grows, and growth that fits, warn. Exit 1 only when the module being installed would take its node to the threshold. The update sweep's and install-module's pre-flight.",
      "positionals": [],
      "options": [
        {
          "flag": "--install",
          "takesValue": true,
          "arg": "<instance>",
          "choices": null,
          "repeatable": false,
          "description": "Count this deployed config's memory as new on its node (install-module, before the guest exists)."
        },
        {
          "flag": "--room-for",
          "takesValue": true,
          "arg": "<module>",
          "choices": null,
          "repeatable": false,
          "description": "Instead: would starting this suspended module fit on its node, and which pauseOk modules there \u2014 lowest pausePriority first \u2014 would make it fit. Exit 1 when even that does not."
        },
        {
          "flag": "--drain",
          "takesValue": true,
          "arg": "<node>",
          "choices": null,
          "repeatable": false,
          "description": "Instead: would this node's HA guests fit on the other nodes for its reboot, and which pauseOk modules would make them fit. Exit 1 when even that does not."
        },
        {
          "flag": "--memory-threshold",
          "takesValue": true,
          "arg": "PCT",
          "choices": null,
          "repeatable": false,
          "description": "Percent of a node's RAM the projected commitment must stay under (default 100)."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Print the result as JSON, with `held`: the modules whose growth does not fit (module, node, from, to in bytes)."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $CONFIG_DIR or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "read",
      "preview": {
        "kind": "read"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "vlan-reach",
      "keys": [
        [
          "vlan-reach"
        ]
      ],
      "usage": "vlan-reach [--json] [--config-dir DIR]",
      "note": null,
      "details": "Whether each active zone's VLAN reaches from every node to every other: a switch between the nodes that does not carry a VLAN splits that zone. Says which VLANs must be carried on which nodes' LAN ports. Exit 2 when a VLAN does not cross. The result is kept for the console's Day 1.",
      "positionals": [],
      "options": [
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Print the result as JSON."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $CONFIG_DIR or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "none",
        "touches": "adds a probe VLAN interface on each node's lan bridge for a few seconds, pings the other nodes over IPv6 link-local, and removes it"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "guests",
      "keys": [
        [
          "guests"
        ]
      ],
      "usage": "guests [<node>] [--json] [--config-dir DIR]",
      "note": null,
      "details": "Each guest's memory, declared and used as the balloon reports it, and the ZFS volumes behind it, by module. One node, or every node.",
      "positionals": [
        {
          "name": "node",
          "optional": true,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Print the node's document, or { nodes: [...] } for every node."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $CONFIG_DIR or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "read",
      "preview": {
        "kind": "read"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "update-os",
      "keys": [
        [
          "update-os"
        ]
      ],
      "usage": "update-os <name> <vmid> <node>",
      "note": null,
      "details": "Patches the VM's OS (NixOS rebuild / apt) through update-os.sh; may reboot it.",
      "positionals": [
        {
          "name": "name",
          "optional": false,
          "repeatable": false
        },
        {
          "name": "vmid",
          "optional": false,
          "repeatable": false
        },
        {
          "name": "node",
          "optional": false,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $CONFIG_DIR or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "none",
        "touches": "patches the guest's OS packages and reboots it if they need it"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "scan security",
      "keys": [
        [
          "scan",
          "security"
        ]
      ],
      "usage": "scan security [--if-new-sweep] [--notify]",
      "note": null,
      "details": "Inventories every target \u2014 the mothership, each module's VM or container, the containers\nrunning inside them (by registry digest), the nodes and the firewall \u2014 and matches each\nagainst its layer's CVE source. Read-only on every target. Writes\n~/config/sbom/site.cdx.json (CycloneDX) and ~/config/sbom/cve-status.json; the previous\nstatus is kept as cve-status.previous.json. Runs after every sweep (tappaas-security-scan).",
      "positionals": [],
      "options": [
        {
          "flag": "--if-new-sweep",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Scan only when a sweep has written a result since the last scan (the unit's mode)."
        },
        {
          "flag": "--notify",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Mail the site owner when a fixable CVE or a failed scan is new since the last scan."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $CONFIG_DIR or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "none",
        "touches": "runs the security scan and writes config/sbom"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "scan nix-list",
      "keys": [
        [
          "scan",
          "nix-list"
        ]
      ],
      "usage": "scan nix-list --components <file> [--nixpkgs <path>] [--no-db-update] [--no-vex]",
      "note": null,
      "details": "Matches a package list against the CVE database as if it ran: the release train's\n`tappaas-train preview` uses it for the packages the NEXT nixpkgs pin would bring, which\nnothing runs yet. Same CPE rule, matcher and VEX as `scan security`; writes nothing.\nPrints {\"findings\": [{id, severity, pkg, installed, fixed, purl}], \"suppressed\": [...], \"error\": \"\"}:\n`suppressed` holds what a VEX statement decided.",
      "positionals": [],
      "options": [
        {
          "flag": "--components",
          "takesValue": true,
          "arg": "<file>",
          "choices": null,
          "repeatable": false,
          "description": "JSON array of {name, version} \u2014 the packages to match (required)."
        },
        {
          "flag": "--nixpkgs",
          "takesValue": true,
          "arg": "<path>",
          "choices": null,
          "repeatable": false,
          "description": "The nixpkgs whose CPE vendors to use: the pin being previewed (default: the installed one)."
        },
        {
          "flag": "--no-db-update",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Match against the grype database as it is, without refreshing it first."
        },
        {
          "flag": "--no-vex",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Apply no VEX statement (by default the ones `scan security` applies: <module>-vex.json)."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $CONFIG_DIR or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "none",
        "touches": "scans a component list"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "scan images",
      "keys": [
        [
          "scan",
          "images"
        ]
      ],
      "usage": "scan images --refs <file> [--no-db-update] [--no-vex]",
      "note": null,
      "details": "Scans container images by registry reference, none of which has to run here: the\nrelease preview compares a past release's images with the next one's. trivy fetches each\nimage (layers are cached). Same VEX as `scan security`. Writes nothing. Prints\n{\"<ref>\": {\"findings\": [...], \"suppressed\": [...], \"error\": \"\"}}.",
      "positionals": [],
      "options": [
        {
          "flag": "--refs",
          "takesValue": true,
          "arg": "<file>",
          "choices": null,
          "repeatable": false,
          "description": "JSON array of image references (`<image>:<tag>` or `<image>@sha256:\u2026`) (required)."
        },
        {
          "flag": "--no-db-update",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Match against the trivy database as it is, without refreshing it first."
        },
        {
          "flag": "--no-vex",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Apply no VEX statement (by default the ones `scan security` applies)."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $CONFIG_DIR or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "write",
      "preview": {
        "kind": "none",
        "touches": "scans container images"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "score",
      "keys": [
        [
          "score"
        ]
      ],
      "usage": "score [--details <file>] [--items <file>] [--json]",
      "note": null,
      "details": "The one CVE risk score (ADR-045 D3). Per counted CVE: risk 25/10/3/1 by its TAPPaaS rating,\nopen or carried 20/8 by its severity. Only a module's highest category counts, each further\nitem at half the one before. Levels: ok 0, low <7, medium <16, high <30, critical \u226530. A zone\nis its highest module times its tier's multiplier (0 \u00d72, 1 \u00d71, 2 \u00d70.75, 3 \u00d70.5, 4 \u00d70.25,\n5\u20136 \u00d70.1, none \u00d71); an environment the highest of its zones; the site the highest of its\nenvironments and of the zones in none. A release has no zones: its highest module. Writes nothing.",
      "positionals": [],
      "options": [
        {
          "flag": "--details",
          "takesValue": true,
          "arg": "<file>",
          "choices": null,
          "repeatable": false,
          "description": "A release preview's details (config/train-preview-details.json): each module's release score."
        },
        {
          "flag": "--items",
          "takesValue": true,
          "arg": "<file>",
          "choices": null,
          "repeatable": false,
          "description": "{modules: {<m>: [{id, state, severity, rating}]}, placement?, zones?}: a site's scores when placement and zones are given."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Print the scores as JSON, with the weights, bands and multipliers used."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $CONFIG_DIR or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "read",
      "preview": {
        "kind": "read"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "report",
      "keys": [
        [
          "report"
        ]
      ],
      "usage": "report [--json] [--from <file>] [--discover]",
      "note": null,
      "details": "`assess` under the name every cmdbSource answers to.",
      "positionals": [],
      "options": [
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Print the report instead of sending it."
        },
        {
          "flag": "--from",
          "takesValue": true,
          "arg": "<file>",
          "choices": null,
          "repeatable": false,
          "description": "Take the gates from this `validate --json` output instead of running them."
        },
        {
          "flag": "--discover",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Accepted for the CMDB's sweep; the report is already its full depth."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $CONFIG_DIR or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "read",
      "preview": {
        "kind": "read"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "assess",
      "keys": [
        [
          "assess"
        ]
      ],
      "usage": "assess [--only <ci>] [--json] [--dry-run] [--timing] [--threshold PCT] [--memory-threshold PCT] [--config-dir DIR]",
      "note": null,
      "details": "Gathers what the gates, Grafana's open alerts, the last sweep, thresholds over the CMDB's\nobservations and the CVE scan say, derives impact and root causes along the relations, and\nwrites conditions on every object in one report. The only writer of conditions. Each failure\nstands until the source that raised it has looked again.",
      "positionals": [],
      "options": [
        {
          "flag": "--only",
          "takesValue": true,
          "arg": "<ci>",
          "choices": null,
          "repeatable": false,
          "description": "One object, by id or name: alerts, sweep, thresholds and the scan speak for it and no gate runs; impact and root causes are worked out again. The alert receiver's call."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Print the objects' conditions, the root causes and the transitions."
        },
        {
          "flag": "--dry-run",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Work it all out and write nothing."
        },
        {
          "flag": "--timing",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Print each phase's duration on stderr as it ends: the CMDB reads, every gate, the alerts, sweep and scan, the working out and the write."
        },
        {
          "flag": "--threshold",
          "takesValue": true,
          "arg": "PCT",
          "choices": null,
          "repeatable": false,
          "description": "Disk-usage threshold percent (default 80)."
        },
        {
          "flag": "--memory-threshold",
          "takesValue": true,
          "arg": "PCT",
          "choices": null,
          "repeatable": false,
          "description": "Committed-memory percent of a node's physical RAM (default 100)."
        },
        {
          "flag": "--config-dir",
          "takesValue": true,
          "arg": "DIR",
          "choices": null,
          "repeatable": false,
          "description": "Config root (default: $CONFIG_DIR or /home/tappaas/config)."
        }
      ],
      "open": false,
      "effect": "read",
      "preview": {
        "kind": "read"
      },
      "destructive": false,
      "destructiveWhen": [],
      "readWhen": [],
      "writeWhen": [],
      "disruptions": []
    },
    {
      "verb": "rules list|show|diff|check|explain|simulate",
      "keys": [
        [
          "rules",
          "list"
        ],
        [
          "rules",
          "show"
        ],
        [
          "rules",
          "diff"
        ],
        [
          "rules",
          "check"
        ],
        [
          "rules",
          "explain"
        ],
        [
          "rules",
          "simulate"
        ]
      ],
      "usage": "rules list|show|diff|check|explain|simulate [<target>] [--kind K] [--origin O] [--state S] [--file F] [--fail O[:T[:S]]]... [--with F] [--without ID]... [--diff] [--json|--markdown]",
      "note": null,
      "details": "The health records that decide what a finding becomes, how a failure spreads, what explains what, who follows whom, how collections sum up and how a root cause is told; one sentence each. show <id> and diff <id> one rule: its state, what it decides now, and edited here against released. check refuses a record it cannot place, two records that decide one case differently, and a set under which a contract scenario no longer holds, and exits 1. explain <object> shows how each of its conditions came about, hop by hop, with the record that decided it. simulate runs the derivation on the site as it is with extra failures or changed records. None writes.",
      "positionals": [
        {
          "name": "target",
          "optional": true,
          "repeatable": false
        }
      ],
      "options": [
        {
          "flag": "--kind",
          "takesValue": true,
          "arg": "K",
          "choices": null,
          "repeatable": false,
          "description": "list: only records of this kind (classify, propagate, combine, explain, follow, rollup, notify)."
        },
        {
          "flag": "--origin",
          "takesValue": true,
          "arg": "O",
          "choices": null,
          "repeatable": false,
          "description": "list: only records released by core, a module, or the site; check --file: the module the file is of."
        },
        {
          "flag": "--state",
          "takesValue": true,
          "arg": "S",
          "choices": null,
          "repeatable": false,
          "description": "list: only rules edited here, pending a decision, held, disabled or deleted."
        },
        {
          "flag": "--file",
          "takesValue": true,
          "arg": "F",
          "choices": null,
          "repeatable": false,
          "description": "check: this candidate file with the rules in use."
        },
        {
          "flag": "--fail",
          "takesValue": true,
          "arg": "O",
          "choices": null,
          "repeatable": false,
          "description": "simulate: fail this object (operational critical unless a type and status are given); repeatable."
        },
        {
          "flag": "--with",
          "takesValue": true,
          "arg": "F",
          "choices": null,
          "repeatable": false,
          "description": "simulate: add the records of this file, replacing any of the same id."
        },
        {
          "flag": "--without",
          "takesValue": true,
          "arg": "ID",
          "choices": null,
          "repeatable": true,
          "description": "simulate: take this record out; repeatable."
        },
        {
          "flag": "--diff",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "simulate: print what changes from now: roots that appear or go, objects whose colour changes."
        },
        {
          "flag": "--json",
          "takesValue": false,
          "arg": null,
          "choices": null,
          "repeatable": false,
          "description": "Print the records, the problems, the explanation or the result as JSON."
        },
        {
          "flag": "--markdown",
          "takesValue": false,
          "arg": null,
