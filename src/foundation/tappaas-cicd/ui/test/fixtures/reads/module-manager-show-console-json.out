{
  "description": "The TAPPaaS console (ADR-034): the site's web UI. The service runs on the mothership (tappaas-console.service, built from tappaas-cicd/ui); this module is its published face — the route through Caddy and the Authentik gate — and, when the AI stack is installed, the assistant's LiteLLM key. It installs nothing of its own.",
  "version": "0.1.0",
  "releaseDate": "2026-10-17",
  "installTime": "20261018-16:29:53",
  "updateTime": "20261101-02:12:51",
  "maintainer": "@TAPPaaS",
  "status": "Development",
  "kind": "application",
  "source": "official",
  "moduleSource": "/home/tappaas/TAPPaaS/src/foundation/console",
  "environment": "mgmt",
  "vmname": "tappaas-cicd",
  "node": "tappaas1",
  "zone0": "mgmt",
  "dependsOn": [
    "network:proxy",
    "network:rules",
    "identity:accessControl"
  ],
  "integratesWith": [
    "litellm:models"
  ],
  "provides": [],
  "displayName": "TAPPaaS console",
  "stack": "foundation",
  "config": {
    "identity:accessControl": {
      "gateGroups": [
        "installer"
      ]
    },
    "network:proxy": {
      "proxyDomain": "console.hrossen.dk",
      "proxyPort": 9097,
      "proxyAllowedZones": [
        "mgmt",
        "admin"
      ]
    }
  }
}
