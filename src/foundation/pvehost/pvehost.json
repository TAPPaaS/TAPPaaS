{
  "description": "A Proxmox VE cluster node as a module",
  "kind": "machine",
  "version": "0.3.0",
  "stack": "foundation",
  "releaseDate": "2026-10-06",
  "status": "Production",
  "source": "official",
  "os": "debian",
  "management": "managed",
  "rebootOk": false,
  "dependsOn": [],
  "integratesWith": [
    "backup:filesystem",
    "logging:logs"
  ],
  "backup": {
    "filesystemPaths": [
      "/etc",
      "/var/lib/pve-cluster",
      "/root"
    ],
    "exclude": [
      "/root/*.iso"
    ]
  }
}
