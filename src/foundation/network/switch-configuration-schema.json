{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "switch-configuration-schema.json",
  "title": "TAPPaaS switch/AP infrastructure configuration (ADR-008)",
  "description": "Desired/actual model for the switch-manager and ap-manager providers. switch-configuration-desired.json holds operator intent + zones-derived state; switch-configuration-actual.json holds the interrogated live state.",
  "type": "object",
  "required": ["version", "switches"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "lastUpdated": { "type": "string" },
    "switches": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/switch" }
    },
    "accessPoints": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/accessPoint" }
    },
    "ssids": {
      "description": "The site's WiFi networks (desired only), by SSID name, owned by ap-manager (ssid add/modify/remove/set-passphrase). Each bridges to one zone, whose SSID field names it, and is broadcast by the access points broadcastOn names. Each access point's own ssids{} is written from this list.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/siteSsid" }
    },
    "wifiController": { "type": "object" }
  },
  "$defs": {
    "switch": {
      "type": "object",
      "required": ["vendor", "managementIp", "ports"],
      "additionalProperties": true,
      "properties": {
        "uuid": { "type": "string" },
        "vendor": { "type": "string", "enum": ["unifi", "mikrotik", "cisco", "generic"] },
        "model": { "type": "string" },
        "managementIp": { "type": "string" },
        "location": { "type": "string", "references": "locations", "description": "Where it is: the name of one of the site's locations (site.json locations, site-manager location list); absent, the primary location. Free text belongs in description." },
        "description": { "type": "string" },
        "ports": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/port" }
        }
      }
    },
    "port": {
      "type": "object",
      "required": ["mode", "source"],
      "additionalProperties": true,
      "properties": {
        "mode": { "type": "string", "enum": ["access", "trunk"] },
        "zone": { "type": "string" },
        "nativeVlan": { "type": ["integer", "null"] },
        "taggedVlans": { "type": "array", "items": { "type": "integer" } },
        "connectedTo": { "$ref": "#/$defs/connectedTo" },
        "source": { "type": "string", "enum": ["zones", "manual", "discovered"] },
        "description": { "type": "string" },
        "poe": { "type": "boolean" },
        "neighbors": {
          "description": "What the controller reports behind the port, read at interrogate: each MAC it learned there, with what LLDP and the DHCP lease it saw say about it. A device no record names is listed by network-manager topology as seen at this port.",
          "type": "array",
          "items": { "$ref": "#/$defs/neighbor" }
        }
      }
    },
    "neighbor": {
      "type": "object",
      "required": ["mac"],
      "additionalProperties": true,
      "properties": {
        "mac": { "type": "string" },
        "lldp": {
          "type": ["object", "null"],
          "properties": { "name": { "type": ["string", "null"] }, "port": { "type": ["string", "null"] } }
        },
        "lease": {
          "type": ["object", "null"],
          "properties": { "hostname": { "type": ["string", "null"] }, "address": { "type": ["string", "null"] } }
        }
      }
    },
    "connectedTo": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "enum": ["node", "switch", "ap", "wan", "device", "unused", "unknown"] },
        "target": { "type": ["string", "null"] },
        "port": { "type": "string" },
        "interface": { "type": "string" },
        "mac": { "type": "string" }
      }
    },
    "accessPoint": {
      "type": "object",
      "required": ["vendor"],
      "additionalProperties": true,
      "properties": {
        "uuid": { "type": "string" },
        "vendor": { "type": "string", "enum": ["unifi", "mikrotik", "generic"] },
        "model": { "type": "string" },
        "managementIp": { "type": "string" },
        "location": { "type": "string", "references": "locations", "description": "Where it is: the name of one of the site's locations (site.json locations, site-manager location list); absent, the primary location. Free text belongs in description." },
        "description": { "type": "string" },
        "uplinkSwitch": { "type": "string" },
        "uplinkPort": { "type": "string" },
        "ssids": {
          "description": "In desired: what this access point broadcasts, written by ap-manager from the site-wide ssids (do not edit; the vendor controllers read it). In actual: what it was found broadcasting.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/ssid" }
        }
      }
    },
    "siteSsid": {
      "type": "object",
      "required": ["zone", "security"],
      "additionalProperties": false,
      "properties": {
        "zone": { "type": "string", "references": "zones", "description": "The zone it bridges to: devices that join land on its VLAN. One SSID per zone." },
        "security": { "type": "string", "enum": ["open", "wpa2-personal", "wpa3-personal", "wpa2-enterprise", "wpa3-enterprise"] },
        "radius": { "type": "string", "description": "The RADIUS server (enterprise only)." },
        "captive": { "type": "boolean", "description": "A captive portal. Absent: none." },
        "disabled": { "type": "boolean", "description": "Kept, but broadcast nowhere. Absent: broadcast." },
        "broadcastOn": {
          "description": "\"all\" (also every access point added later), or the access points by name. Absent: all.",
          "oneOf": [ { "const": "all" }, { "type": "array", "items": { "type": "string" }, "uniqueItems": true } ]
        },
        "passphraseChanged": { "type": "boolean", "description": "Set by ssid set-passphrase; the next reconcile pushes the passphrase (from the secrets file) to every access point that broadcasts it, and confirm clears it." }
      }
    },
    "ssid": {
      "type": "object",
      "required": ["vlan", "zone", "security", "enabled"],
      "additionalProperties": true,
      "properties": {
        "vlan": { "type": "integer" },
        "zone": { "type": "string" },
        "security": { "type": "string", "enum": ["open", "wpa2-personal", "wpa3-personal", "wpa2-enterprise", "wpa3-enterprise"] },
        "radiusServer": { "type": "string" },
        "captivePortal": { "type": "boolean" },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
