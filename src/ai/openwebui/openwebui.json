{
  "description": "Open WebUI chat interface — private AI chat for your users, with conversation history and RAG, through the LiteLLM gateway.",
  "kind": "vm",
  "version": "0.8.2",
  "stack": "ai",
  "releaseDate": "2026-07-02",
  "maintainer": "@ErikDaniel007",
  "status": "Development",
  "vmname": "openwebui",
  "vmid": 311,
  "vmtag": "TAPPaaS,App",
  "node": "tappaas2",
  "dependsOn": [
    "cluster:vm",
    "templates:nixos",
    "backup:vm",
    "network:proxy",
    "litellm:models",
    "network:rules",
    "identity:identity"
  ],
  "integratesWith": [
    "logging:logs"
  ],
  "provides": [],
  "appVersion": "0.11.4",
  "config": {
    "cluster:vm": {
      "cores": 2,
      "memory": "4096",
      "diskSize": "32G",
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "bridge0": "lan"
    },
    "network:proxy": {
      "proxyPort": 8080,
      "proxyAllowedZones": [
        "home"
      ]
    }
  },
  "identity": {
    "launchPath": "/oauth/oidc/login",
    "oidcRedirectPaths": [
      "/oauth/oidc/callback"
    ],
    "scopes": [
      "openid",
      "email",
      "profile"
    ],
    "secretsEnv": "/etc/secrets/openwebui-oidc.env",
    "configureService": "openwebui-integrations.service"
  }
}
