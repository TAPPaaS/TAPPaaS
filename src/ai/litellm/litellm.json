{
  "description": "LiteLLM AI gateway — one OpenAI-compatible API, with per-user keys and usage tracking, in front of local (vLLM) and remote models.",
  "kind": "vm",
  "version": "0.7.1",
  "stack": "ai",
  "releaseDate": "2026-09-07",
  "maintainer": "@ErikDaniel007",
  "status": "Development",
  "vmname": "litellm",
  "vmid": 310,
  "vmtag": "TAPPaaS,App,AI",
  "node": "tappaas2",
  "dependsOn": [
    "cluster:vm",
    "templates:nixos",
    "backup:vm",
    "network:proxy",
    "network:rules",
    "identity:identity"
  ],
  "integratesWith": [
    "vllm-amd:inference"
  ],
  "provides": [
    "models"
  ],
  "appVersion": "1.85.0",
  "config": {
    "cluster:vm": {
      "cores": 4,
      "memory": "8192",
      "diskSize": "32G",
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "bridge0": "lan"
    },
    "network:proxy": {
      "proxyPort": 4000
    }
  },
  "identity": {
    "launchPath": "/sso/key/generate",
    "oidcRedirectPaths": [
      "/sso/callback"
    ],
    "scopes": [
      "openid",
      "email",
      "profile"
    ],
    "secretsEnv": "/etc/secrets/litellm-oidc.env",
    "configureService": "litellm-integrations.service"
  }
}
