{
  "description": "VaultWarden password manager (Bitwarden-compatible) in DMZ",
  "kind": "vm",
  "version": "0.6.0",
  "stack": "security",
  "releaseDate": "2026-02-17",
  "maintainer": "@larsrossen",
  "status": "Development",
  "vmname": "vaultwarden",
  "vmid": 610,
  "vmtag": "TAPPaaS,App",
  "zone0": "dmz",
  "dependsOn": [
    "cluster:vm",
    "cluster:ha",
