{
  "description": "TAPPaaS Open Webui",
  "version": "0.8.0",
  "releaseDate": "2026-07-02",
  "maintainer": "@ErikDaniel007",
  "status": "Development",
  "tier": "app",
  "vmname": "openwebui",
  "vmid": 311,
  "vmtag": "TAPPaaS,App",
  "node": "tappaas2",
  "dependsOn": [
    "cluster:vm",
    "templates:nixos",
    "backup:vm",
    "network:proxy",
    "litellm:models",
    "network:rules",
    "identity:identity"
  ],
  "provides": [],
  "appVersion": "0.11.2",
  "config": {
    "cluster:vm": {
      "cores": 2,
      "memory": "4096",
      "diskSize": "32G",
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "bridge0": "lan"
    },
    "network:proxy": {
      "proxyPort": 8080,
      "proxyAllowedZones": [
        "internet"
      ]
    }
  },
  "identity": {
    "oidcRedirectPaths": [
      "/oauth/oidc/callback"
    ],
    "scopes": [
      "openid",
      "email",
      "profile"
    ],
    "secretsEnv": "/etc/secrets/openwebui-oidc.env",
    "configureService": "openwebui-integrations.service"
  }
}
