{
  "description": "Zigbee gateway — deCONZ engine (ConBee II, native zigbee for HA) + diyHue front-end (hue-bridge for free@home/SysAP). See README.md / INSTALL.md.",
  "version": "0.3.0",
  "releaseDate": "2026-07-02",
  "maintainer": "@ErikDaniel007",
  "status": "Development",
  "vmname": "deconz",
  "vmid": 213,
  "vmtag": "TAPPaaS,App,HomeAutomation",
  "node": "tappaas1",
  "zone0": "iotCloud",
  "dependsOn": [
    "cluster:vm",
    "templates:nixos",
    "backup:vm",
    "firewall:proxy",
    "firewall:rules"
  ],
  "provides": [
    "zigbee",
    "hue-bridge"
  ],
  "appVersion": "nixpkgs-pinned",
  "config": {
    "cluster:vm": {
      "cores": 2,
      "memory": "4096",
      "diskSize": "16G",
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "bridge0": "lan"
    },
    "firewall:proxy": {
      "proxyPort": 8080,
      "proxyAllowedZones": [
        "mgmt"
      ]
    },
    "firewall:rules": {
      "ports": [
        {
          "port": 8080,
          "protocol": "TCP",
          "description": "deCONZ REST (zigbee) — HA cross-zone srvHome->iotCloud + diyHue@localhost + Phoscon via mgmt proxy. NOT exposed to SysAP."
        },
        {
          "port": 8443,
          "protocol": "TCP",
          "description": "deCONZ websocket (zigbee) — HA deconz integration live events, cross-zone srvHome->iotCloud"
        },
        {
          "port": 80,
          "protocol": "TCP",
          "description": "diyHue Hue API (hue-bridge) — SysAP/free@home control, INTRA-zone iotCloud"
        },
        {
          "port": 443,
          "protocol": "TCP",
          "description": "diyHue Hue API TLS (hue-bridge) — genuine Hue-grade endpoint for SysAP, INTRA-zone iotCloud"
        },
        {
          "port": 1900,
          "protocol": "UDP",
          "description": "SSDP discovery (hue-bridge) — diyHue advertises the bridge to the SysAP, INTRA-zone iotCloud"
        },
        {
          "port": 2100,
          "protocol": "UDP",
          "description": "diyHue Hue Entertainment streaming (hue-bridge)"
        },
        {
          "port": 1982,
          "protocol": "UDP",
          "description": "diyHue (hue-bridge)"
        }
      ]
    }
  }
}
