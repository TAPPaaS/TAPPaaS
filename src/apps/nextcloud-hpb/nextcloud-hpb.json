{
  "description": "Nextcloud Talk High-Performance Backend - dedicated WebSocket signaling server (nextcloud-spreed-signaling) with a Janus SFU for group calls.",
  "kind": "vm",
  "version": "0.3.0",
  "stack": "collaboration",
  "releaseDate": "2026-09-21",
  "maintainer": "@ErikDaniel007",
  "status": "Testing",
  "tier": "app",
  "vmname": "nextcloud-hpb",
  "vmid": 342,
  "vmtag": "TAPPaaS,App",
  "node": "tappaas2",
  "dependsOn": [
    "backup:vm",
    "cluster:vm",
    "coturn:turn",
    "network:proxy",
    "network:rules",
    "nextcloud:fileservice",
    "templates:nixos"
  ],
  "provides": [],
  "config": {
    "cluster:vm": {
      "cores": 4,
      "memory": "4096",
      "diskSize": "16G",
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "bridge0": "lan"
    },
    "network:proxy": {
      "proxyPort": 8080
    },
    "nextcloud:fileservice": {
      "connector": "hpb"
    }
  },
  "appVersion": "2.1.1",
  "ingress": [
    {
      "from": "dmz",
      "ports": [
        "20000:20999"
      ],
      "protocol": "UDP",
      "description": "Janus media relayed by coturn (dmz): participants that cannot reach the HPB directly"
    }
  ]
}
