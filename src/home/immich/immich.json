{
  "description": "Immich self-hosted photo and video backup with ML-powered search, face recognition and mobile auto-upload.",
  "kind": "vm",
  "version": "0.2.0",
  "stack": "home",
  "releaseDate": "2026-10-06",
  "maintainer": "@AndreasJe",
  "status": "Testing",
  "vmname": "immich",
  "vmid": 361,
  "vmtag": "TAPPaaS,App,Photos",
  "node": "tappaas1",
  "dependsOn": [
    "cluster:vm",
    "cluster:ha",
    "templates:nixos",
    "backup:vm",
    "network:proxy",
    "network:rules",
    "identity:identity"
  ],
  "provides": [],
  "identity": {
    "launchPath": "/auth/login?autoLaunch=1",
    "oidcRedirectPaths": ["/auth/login", "/user-settings", "/api/oauth/mobile-redirect"],
    "configureService": "immich-configure-oidc.service"
  },
  "appVersion": "3.2.4",
  "config": {
    "cluster:vm": {
      "cores": 4,
      "memory": "8192",
      "diskSize": "500G",
      "thinDisk": true,
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "bridge0": "lan"
    },
    "network:proxy": {
      "proxyPort": 2283,
      "proxyAllowedZones": [
        "home",
        "netbird",
        "internet"
      ]
    }
  }
}
