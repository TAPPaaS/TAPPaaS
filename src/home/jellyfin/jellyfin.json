{
  "description": "Jellyfin open-source media server for personal movie, TV and music libraries.",
  "kind": "vm",
  "version": "0.1.3",
  "stack": "home",
  "releaseDate": "2026-06-27",
  "maintainer": "@AndreasJe",
  "status": "Testing",
  "vmname": "jellyfin",
  "vmid": 360,
  "vmtag": "TAPPaaS,App,Media",
  "node": "tappaas1",
  "rebootOk": true,
  "dependsOn": [
    "cluster:vm",
    "backup:vm",
    "network:proxy",
    "identity:accessControl",
    "network:rules",
    "storage:nfs",
    "templates:nixos",
    "identity:identity"
  ],
  "integratesWith": [
    "logging:logs"
  ],
  "provides": [],
  "appVersion": "10.11.11",
  "identity": {
    "providesAdminRole": true,
    "adminGroupClaim": "admin",
    "launchPath": "/sso/OID/start/authentik",
    "oidcRedirectPaths": [
      "/sso/OID/redirect/authentik"
    ],
    "scopes": [
      "openid",
      "email",
      "profile"
    ],
    "configureService": "jellyfin-configure-oidc.service"
  },
  "config": {
    "cluster:vm": {
      "cores": 4,
      "memory": "2048",
      "diskSize": "32G",
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "bridge0": "lan"
    },
    "storage:nfs": {
      "mounts": [
        {
          "path": "/media",
          "share": "media",
          "subdir": "jellyfin",
          "access": "rw",
          "stopUnits": ["jellyfin.service"]
        }
      ]
    },
    "network:proxy": {
      "proxyPort": 8096,
      "proxyPreserveHost": "true",
      "proxyAllowedZones": [
        "home",
        "netbird",
        "internet"
      ]
    }
  }
}
