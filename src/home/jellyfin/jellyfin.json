{
  "description": "Jellyfin open-source media server for personal movie, TV and music libraries.",
  "kind": "vm",
  "version": "0.1.0",
  "stack": "home",
  "releaseDate": "2026-06-27",
  "maintainer": "@AndreasJe",
  "status": "Development",
  "vmname": "jellyfin",
  "vmid": 360,
  "vmtag": "TAPPaaS,App,Media",
  "node": "tappaas1",
  "rebootOk": true,
  "dependsOn": [
    "cluster:vm",
    "templates:nixos",
    "backup:vm",
    "network:proxy",
    "network:rules",
    "pvehost:nfs"
  ],
  "provides": [],
  "appVersion": "10.10.7",
  "config": {
    "cluster:vm": {
      "cores": 4,
      "memory": "2048",
      "diskSize": "32G",
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "bridge0": "lan"
    },
    "pvehost:nfs": {
      "mounts": [
        {
          "path": "/media",
          "share": "media",
          "subdir": "jellyfin",
          "access": "rw",
          "stopUnits": ["jellyfin.service"]
        }
      ]
    },
    "network:proxy": {
      "proxyPort": 8096,
      "proxyAllowedZones": [
        "home",
        "netbird",
        "internet"
      ]
    }
  }
}
