{
  "description": "TAPPaaS template VM",
  "kind": "vm",
  "version": "0.1.0",
  "status": "Development",
  "stack": "template",
  "vmname": "template",
  "vmid": 999,
  "vmtag": "TAPPaaS,Test",
  "dependsOn": [
    "cluster:vm",
    "cluster:ha",
    "templates:nixos"
  ],
  "integratesWith": [
    "logging:logs"
  ],
  "provides": [
    "myservice"
  ],
  "config": {
    "cluster:vm": {
      "bridge0": "lan",
      "cores": 2,
      "coresSmallLarge": [1, 4],
      "diskSize": "32G",
      "diskSmallLarge": ["16G", "128G"],
      "image": "8080",
      "imageType": "clone",
      "memory": 8192,
      "memorySmallLarge": [2048, 16384],
      "storage": "tanka1"
    }
  }
}
