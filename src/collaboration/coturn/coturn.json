{
  "description": "coturn TURN/STUN server for Nextcloud Talk WebRTC audio/video calls.",
  "kind": "vm",
  "version": "0.3.1",
  "stack": "collaboration",
  "releaseDate": "2026-09-21",
  "maintainer": "@ErikDaniel007",
  "status": "Testing",
  "vmname": "coturn",
  "vmid": 341,
  "vmtag": "TAPPaaS,App",
  "node": "tappaas1",
  "zone0": "dmz",
  "dependsOn": [
    "backup:vm",
    "cluster:vm",
    "network:nat",
    "network:rules",
    "nextcloud:fileservice",
    "templates:nixos"
  ],
  "integratesWith": [
    "logging:logs"
  ],
  "provides": [
    "turn"
  ],
  "config": {
    "cluster:vm": {
      "cores": 2,
      "memory": "2048",
      "diskSize": "8G",
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "bridge0": "lan"
    },
    "network:nat": {
      "natRules": [
        {
          "externalPort": 3478,
          "protocol": "TCP/UDP",
          "description": "TURN/STUN"
        },
        {
          "externalPort": "49152-50151",
          "internalPort": 49152,
          "protocol": "UDP",
          "description": "TURN relay range"
        }
      ]
    },
    "nextcloud:fileservice": {
      "connector": "talk"
    }
  },
  "appVersion": "4.13.1",
  "ports": [
    {
      "port": 3478,
      "protocol": "TCP/UDP",
      "description": "TURN/STUN"
    },
    {
      "port": "49152:50151",
      "protocol": "UDP",
      "description": "TURN relay range"
    }
  ],
  "ingress": [
    {
      "from": "home",
      "ports": [
        3478,
        "49152:50151"
      ],
      "protocol": "UDP",
      "description": "Talk clients on client networks relay through coturn without hairpinning via the WAN IP"
    },
    {
      "from": "home",
      "ports": [
        3478
      ],
      "protocol": "TCP",
      "description": "Talk clients on client networks: TURN TCP fallback"
    }
  ]
}
