{
  "description": "Nextcloud file sharing and collaboration platform with Authentik SSO support.",
  "kind": "vm",
  "version": "0.2.1",
  "stack": "collaboration",
  "releaseDate": "2026-06-12",
  "maintainer": "@ErikDaniel007",
  "status": "Testing",
  "vmname": "nextcloud",
  "vmid": 340,
  "vmtag": "TAPPaaS,App",
  "node": "tappaas1",
  "dependsOn": [
    "cluster:vm",
    "templates:nixos",
    "backup:vm",
    "network:proxy",
    "network:rules",
    "identity:identity"
  ],
  "integratesWith": [
    "logging:logs"
  ],
  "provides": [
    "fileservice"
  ],
  "appVersion": "35",
  "config": {
    "cluster:vm": {
      "bios": "ovmf",
      "os": "nixos",
      "ostype": "l26",
      "cputype": "host",
      "cores": 4,
      "memory": 8192,
      "diskSize": "80G",
      "storage": "tanka1",
      "imageType": "clone",
      "image": "8080",
      "cloudInit": true,
      "bridge0": "lan"
    },
    "network:proxy": {
      "proxyPort": 80
    },
    "identity:identity": {
      "identity": {
        "providesAdminRole": true,
        "adminGroupClaim": "admin"
      }
    }
  }
}
