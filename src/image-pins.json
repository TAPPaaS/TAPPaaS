{
  "$comment": "Container image pins (#750, ADR-028 D4). Each entry says where its value lives: `file` and a regex `match` whose first group is the pinned value (the last match in the file); `also` names other places that must hold the same value. The module file stays the one place the pin is edited. tappaas-cicd/scripts/image-pins.py reports each pin's age and how far upstream is ahead, at every release boundary. `earlierMatch` (optional) lists the forms the value had in earlier releases, tried in order when `match` finds nothing \u2014 release-images.py reads a past release's images with it (#788).",
  "pins": [
    {
      "module": "identity",
      "image": "ghcr.io/goauthentik/server",
      "kind": "tag",
      "file": "src/foundation/identity/identity.nix",
      "match": "lines = \\[[^\\]]*\"([0-9]+\\.[0-9]+\\.[0-9]+)\"\\s*\\];",
      "tagPattern": "^[0-9]{4}\\.[0-9]+\\.[0-9]+$",
      "maintainer": "@TAPPaaS",
      "earlierMatch": [
        "authentik\\s*=\\s*\"([0-9]+\\.[0-9]+\\.[0-9]+)\";"
      ]
    },
    {
      "module": "euro-office",
      "image": "ghcr.io/euro-office/documentserver",
      "kind": "tag",
      "file": "src/collaboration/euro-office/euro-office.nix",
      "match": "image = \"ghcr\\.io/euro-office/documentserver:([^\"]+)\";",
      "also": [
        {
          "file": "src/collaboration/euro-office/update.sh",
          "match": "CONTAINER_IMAGE=\"ghcr\\.io/euro-office/documentserver:([^\"]+)\""
        }
      ],
      "tagPattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maintainer": "@ErikDaniel007"
    },
    {
      "module": "litellm",
      "image": "docker.io/litellm/litellm",
      "kind": "tag",
      "file": "src/ai/litellm/litellm.nix",
      "match": "litellm\\s+= \"(v[^\"]+)\";",
      "tagPattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maintainer": "@ErikDaniel007"
    },
    {
      "module": "openwebui",
      "image": "docker.io/openwebui/open-webui",
      "kind": "tag",
      "file": "src/ai/openwebui/openwebui.nix",
      "match": "openwebui\\s+= \"([^\"]+)\";",
      "tagPattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maintainer": "@ErikDaniel007"
    },
    {
      "module": "vllm-amd",
      "image": "docker.io/kyuz0/vllm-therock-gfx1151",
      "kind": "digest",
      "file": "src/ai/vllm-amd/update.sh",
      "match": "PINNED_IMAGE=\"kyuz0/vllm-therock-gfx1151@(sha256:[0-9a-f]+)\"",
      "maintainer": "@ErikDaniel007"
    },
    {
      "module": "deconz",
      "image": "docker.io/diyhue/core",
      "kind": "digest",
      "file": "src/home/deconz/deconz.nix",
      "match": "diyhue = \"(sha256:[0-9a-f]+)\";",
      "maintainer": "@ErikDaniel007"
    },
    {
      "module": "nomad",
      "image": "ghcr.io/crosstalk-solutions/project-nomad",
      "kind": "tag",
      "file": "src/home/nomad/nomad.nix",
      "match": "adminImage = \"ghcr\\.io/crosstalk-solutions/project-nomad:([^\"]+)\";",
      "tagPattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maintainer": "@larsrossen"
    },
    {
      "module": "nomad",
      "image": "ghcr.io/crosstalk-solutions/project-nomad-disk-collector",
      "kind": "tag",
      "file": "src/home/nomad/nomad.nix",
      "match": "diskCollectorImage = \"ghcr\\.io/crosstalk-solutions/project-nomad-disk-collector:([^\"]+)\";",
      "tagPattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maintainer": "@larsrossen"
    },
    {
      "module": "karakeep",
      "image": "ghcr.io/karakeep-app/karakeep",
      "kind": "tag",
      "file": "src/home/karakeep/karakeep.nix",
      "match": "karakeepImage = \"ghcr\\.io/karakeep-app/karakeep:([^\"]+)\";",
      "tagPattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maintainer": "@larsrossen"
    },
    {
      "module": "karakeep",
      "image": "ghcr.io/karakeep-app/karakeep-chrome",
      "kind": "tag",
      "file": "src/home/karakeep/karakeep.nix",
      "match": "chromeImage = \"ghcr\\.io/karakeep-app/karakeep-chrome:([^\"]+)\";",
      "tagPattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+-r[0-9]+$",
      "maintainer": "@larsrossen"
    },
    {
      "module": "karakeep",
      "image": "getmeili/meilisearch",
      "kind": "tag",
      "file": "src/home/karakeep/karakeep.nix",
      "match": "meiliImage = \"getmeili/meilisearch:([^\"]+)\";",
      "tagPattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maintainer": "@larsrossen"
    }
  ]
}
